---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
import Mark from "../components/Mark.astro";
import Wordmark from "../components/Wordmark.astro";

import { fitTitle, fitDescription } from "../lib/seo";
import Tape from "../components/Tape.astro";

// title / description: a string, or preferred wording first with shorter fallbacks after it
// (see fitTitle / fitDescription). noindex: pages that exist for navigation but have no data
// yet (a member with no filings on record) — kept out of search and out of the sitemap.
interface Props { title: string | string[]; description?: string | string[]; section?: string; noindex?: boolean }
const { section, noindex = false } = Astro.props;
const title = fitTitle(Astro.props.title);
const description = fitDescription(Astro.props.description ?? "Which members of Congress and corporate insiders are buying and selling stock: every disclosed trade on one heatmap, updated daily, free.");
const siteUrl = (import.meta.env.PUBLIC_SITE_URL ?? "https://spotthemoney.com").replace(/\/$/, "");
const ogImage = `${siteUrl}/og.png`;
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? "page" : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Spot the Money" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Spot the Money — Congress and insider stock trades on one heatmap" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#F2F1EC" id="themeColor" />
    <script is:inline>
      // Theme before first paint: light for everyone unless this browser chose dark.
      (function () {
        var t = "light";
        try { if (localStorage.getItem("theme") === "dark") t = "dark"; } catch (e) {}
        document.documentElement.classList.add(t);
        if (t === "dark") { var m = document.getElementById("themeColor"); if (m) m.setAttribute("content", "#0A0B0C"); }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <Analytics />
  </head>
  <body>
    <header class="site">
      <div class="container">
        <a class="brand" href="/" aria-label="Spot the Money home">
          <Mark size={28} />
          <Wordmark height={11} />
          {section && <span class="sub">{section}</span>}
        </a>
        <nav class="site" aria-label="Primary">
          <a href="/congress/" aria-current={current("/congress/")}>Congress</a>
          <a href="/insiders/" aria-current={current("/insiders/")}>Insiders</a>
          <a href="/disclosures/" aria-current={current("/disclosures/")}>Newest</a>
          <a href="/washington/" aria-current={current("/washington/")}>Washington</a>
          <a href="/rates/" aria-current={current("/rates/")}>Rates</a>
        </nav>
        <div class="hud">
          <span class="status"><span class="dot"></span> <span>Data</span> <span class="on">Live</span></span>
          <button class="toggle" id="themeBtn" type="button" aria-label="Switch color theme">
            <span class="if-dark">Light</span><span class="if-light">Dark</span>
          </button>
        </div>
      </div>
    </header>
    <Tape />

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="container">
        <div class="foot-top">
          <Mark size={24} />
          <Wordmark height={10} />
        </div>
        <p class="disclaimer">
          <strong>Not investment advice.</strong> Figures are based on public, official data and
          disclosures that may lag actual events. Spot the Money provides transparency and historical
          information only — no buy/sell recommendations, no trade execution.
        </p>
        <p>© {year} spotthemoney.com · Sources: U.S. Treasury, BLS, SEC EDGAR, House Clerk, FEC, USAspending, Senate LDA · <a href="/methodology/">Methodology</a> · <a href="/corrections/">Corrections</a> · <a href="/llms.txt">llms.txt</a></p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById("themeBtn");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.classList.contains("dark") ? "light" : "dark";
        root.classList.remove("dark", "light");
        root.classList.add(next);
        document.getElementById("themeColor")?.setAttribute("content", next === "dark" ? "#0A0B0C" : "#F2F1EC");
        try { localStorage.setItem("theme", next); } catch {}
        window.dispatchEvent(new CustomEvent("themechange", { detail: next }));
      });
    </script>
    <script>
      import "../scripts/viz";
    </script>
  </body>
</html>
