---
import "../styles/global.css";
import "../styles/writing.css";
import "../styles/rd-entity.css";
import "../styles/rd-hubs.css";
import "../styles/rd-prose.css";
import "../styles/rd-kit.css";
import "../styles/rd-home.css";
import "../styles/rd-stock.css";
import "../styles/rd-people.css";
import "../styles/rd-landing.css";
import "../styles/rd-final.css";
import Analytics from "../components/Analytics.astro";
import Mark from "../components/Mark.astro";
import Wordmark from "../components/Wordmark.astro";

import { fitTitle, fitDescription } from "../lib/seo";
import { adClient } from "../lib/ads";
import AdSlot from "../components/AdSlot.astro";
import { splitForAd, topHasClass } from "../lib/adplace";
import { FEEDS } from "../lib/feeds";
import { NAV, FOOT_ABOUT, liveItems, groupFor } from "../lib/nav";

// title / description: a string, or preferred wording first with shorter fallbacks after it
// (see fitTitle / fitDescription). noindex: pages that exist for navigation but have no data
// yet (a member with no filings on record) — kept out of search and out of the sitemap.
// modified: ISO date the page's content last changed, for citation metadata; defaults to the
// build date, which is right for data pages (they are rebuilt whenever the data changes).
// Writing pages (articles by contributors) also pass: author (a person's name instead of "Spot the
// Money" in the author / citation_author / dcterms.creator tags), canonical (an absolute URL, for
// an article first published elsewhere), ogImage (site path or absolute URL), ogType ("article")
// and published (ISO date: citation_publication_date and article:published_time). Pages that pass
// none of these render exactly as before.
// ads: false keeps the advertising tag off a page that has no publisher content of its own
// (legal pages, contact, 404, sign-in shells). A noindex page never carries it either. With no
// publisher ID in lib/ads.ts nothing is rendered anywhere. Every page that carries the tag also
// gets two units from this layout: a leaderboard above the page content and a multiplex grid
// below it (components/AdSlot.astro); page templates add the units in between.
interface Props {
  title: string | string[]; description?: string | string[]; section?: string; noindex?: boolean; modified?: string | null;
  author?: string; canonical?: string; ogImage?: string; ogType?: string; published?: string | null; ads?: boolean;
  /** false leaves out the ticker tape, the one part of the layout that reads the build-time model (on-demand pages). */
  tape?: boolean;
}
const { noindex = false, author = "Spot the Money", ogType = "website", ads = true, tape = true } = Astro.props;
const Tape = tape ? (await import("../components/Tape.astro")).default : null;
const adsense = ads && !noindex ? adClient() : "";
const title = fitTitle(Astro.props.title);
const description = fitDescription(Astro.props.description ?? "Which members of Congress and corporate insiders are buying and selling stock: disclosed trades on one heatmap, updated daily, free.");
const siteUrl = (import.meta.env.PUBLIC_SITE_URL ?? "https://spotthemoney.com").replace(/\/$/, "");
const customImage = Astro.props.ogImage ? new URL(Astro.props.ogImage, siteUrl + "/").toString() : null;
const ogImage = customImage ?? `${siteUrl}/og.png`;
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const published = Astro.props.published ? Astro.props.published.slice(0, 10) : null;
const year = new Date().getFullYear();
const modified = (Astro.props.modified ?? new Date().toISOString()).slice(0, 10);
// The title as a citation should carry it: without the site-name suffix.
const citeTitle = title.replace(/\s*[|–—-]\s*Spot the Money\s*$/i, "").trim() || title;
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? "page" : undefined);
const activeGroup = groupFor(path)?.key;
// 22px line icons, one per menu (the first four are the ones the old flat links used).
const NAV_ICON: Record<string, string> = {
  congress: "M3 21h18M5 21V10M9 21V10M15 21V10M19 21V10M3 10h18M12 3l9 5H3z",
  insiders: "M4 7h16v13H4zM9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M4 13h16",
  companies: "M4 21V8l6-3v16M10 21V11l10-3v13M3 21h18M6.5 11h1M6.5 14h1M6.5 17h1M14 14h1M14 17h1M17.5 14h1M17.5 17h1",
  washington: "M4 20h16M6 20v-7M18 20v-7M10 20v-4h4v4M5 13h14M12 4a6 6 0 0 1 6 6H6a6 6 0 0 1 6-6zM12 2v2",
  markets: "M4 19l5-6 4 3 7-9M15 7h5v5",
};
// The page content is rendered once here so the top advertisement can follow the title block
// (lib/adplace.ts) instead of sitting above it, with no script and no reordering in the browser.
const pageHtml = await Astro.slots.render("default");
const { before: pageBefore, after: pageAfter } = splitForAd(pageHtml);
const flowEntity = topHasClass(pageHtml, "title-row");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large"} />
    <meta name="author" content={author} />
    <link rel="license" href={`${siteUrl}/terms/#reuse`} />
    <meta name="citation_title" content={citeTitle} />
    <meta name="citation_author" content={author} />
    <meta name="citation_publication_date" content={(published ?? modified).replace(/-/g, "/")} />
    <meta name="citation_public_url" content={canonical} />
    <meta name="dcterms.title" content={citeTitle} />
    <meta name="dcterms.creator" content={author} />
    <meta name="dcterms.publisher" content="Spot the Money" />
    <meta name="dcterms.modified" content={modified} />
    <meta name="dcterms.rights" content={`${siteUrl}/terms/#reuse`} />
    <meta property="article:modified_time" content={modified} />
    {published && <meta property="article:published_time" content={published} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Spot the Money" />
    <meta property="og:image" content={ogImage} />
    {customImage ? <meta property="og:image:alt" content={title} /> : <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Spot the Money: Congress and insider stock trades on one heatmap" />
    </>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#FFFFFF" id="themeColor" />
    <meta name="color-scheme" content="light" id="colorScheme" />
    <script is:inline>
      // Theme before first paint: light for everyone unless this browser chose dark.
      (function () {
        var t = "light";
        try { if (localStorage.getItem("theme") === "dark") t = "dark"; } catch (e) {}
        document.documentElement.classList.add(t, "js");
        // Row density for this visit (session storage key stm.ui), applied before first paint so the rows do not jump.
        try { var u = JSON.parse(sessionStorage.getItem("stm.ui") || "{}"); if (u && u.density === "compact") document.documentElement.setAttribute("data-density", "compact"); } catch (e) {}
        if (t === "dark") { var m = document.getElementById("themeColor"); if (m) m.setAttribute("content", "#0F1215"); var c = document.getElementById("colorScheme"); if (c) c.setAttribute("content", "dark"); }
      })();
    </script>
    <link rel="preload" href="/fonts/inter-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    {FEEDS.map((f) => <link rel="alternate" type="application/rss+xml" title={f.title} href={f.path} />)}
    <slot name="head" />
    <Analytics />
    {adsense && <meta name="google-adsense-account" content={adsense} />}
    {adsense && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense}`} crossorigin="anonymous"></script>}
  </head>
  <body data-ads={adsense ? "on" : undefined}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site" id="siteHeader">
      <div class="container">
        <a class="brand" href="/" aria-label="Spot the Money home">
          <Mark size={28} />
          <Wordmark height={11} />
        </a>
        <button class="search-pill" type="button" data-search-open aria-haspopup="dialog" aria-label="Search members, insiders, tickers">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><span>Search members, insiders, tickers</span><kbd aria-hidden="true">/</kbd>
        </button>
        <nav class="site" id="siteMenu" aria-label="Primary">
          {NAV.map((g) => (
            <details class="navm" name="navm" data-nav={g.key}>
              <summary aria-current={activeGroup === g.key ? "true" : undefined}><svg class="navm-ic" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={NAV_ICON[g.key]}/></svg><span>{g.label}</span><svg class="navm-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
              <div class="navm-panel"><ul>
                {liveItems(g).map((i) => <li><a href={i.href} aria-current={current(i.href)}><span class="navm-l">{i.label}</span><span class="navm-d">{i.desc}</span></a></li>)}
              </ul></div>
            </details>
          ))}
          <a class="navm-plain" href="/guides/" aria-current={current("/guides/")}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 21a2 2 0 0 0 2 2h13v-4M8 7h7M8 11h5"/></svg><span>Guides</span><i class="chev" aria-hidden="true">›</i></a>
        </nav>
        <a class="icon-btn acct-btn" id="acctBtn" href="/watchlist/" aria-label="Watchlist" hidden><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg><span class="acct-badge" hidden></span></a>
        <button class="icon-btn density-btn" id="densityBtn" type="button" aria-pressed="false" aria-label="Compact rows" title="Compact rows"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="4" rx="1"/><rect x="4" y="10" width="16" height="4" rx="1"/><rect x="4" y="16" width="16" height="4" rx="1"/></svg></button>
        <button class="icon-btn theme-btn" id="themeBtn" type="button" aria-label="Switch color theme">
          <span class="if-light"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></span><span class="if-dark"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"/></svg></span>
        </button>
        <button class="icon-btn menu-btn" id="menuBtn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="siteMenu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
      </div>
    </header>
    <dialog class="search-dlg" id="searchDlg" aria-label="Search">
      <div class="search-box">
        <div class="search-top">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <input id="searchInput" type="search" placeholder="Search a member, insider, ticker or company" autocomplete="off" spellcheck="false" aria-controls="searchResults" />
          <button type="button" class="icon-btn" id="searchClose" aria-label="Close search"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>
        <div class="search-results" id="searchResults" role="listbox"></div>
      </div>
    </dialog>
    <dialog class="share-dlg" id="shareDlg" aria-labelledby="shareTitle">
      <div class="share-box">
        <div class="share-top">
          <h2 id="shareTitle">Share</h2>
          <button type="button" class="icon-btn" id="shareClose" aria-label="Close share menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>
        <p class="share-what" id="shareWhat"></p>
        <div class="share-link">
          <input id="shareUrl" type="text" readonly aria-label="Link to share" />
          <button type="button" class="share-primary" data-share-act="copy" autofocus>Copy link</button>
        </div>
        <div class="share-grid">
          <button type="button" data-share-act="native" hidden>More apps…</button>
          <a data-share-net="x" target="_blank" rel="noopener">X</a>
          <a data-share-net="whatsapp" target="_blank" rel="noopener">WhatsApp</a>
          <a data-share-net="reddit" target="_blank" rel="noopener">Reddit</a>
          <a data-share-net="linkedin" target="_blank" rel="noopener">LinkedIn</a>
          <a data-share-net="facebook" target="_blank" rel="noopener">Facebook</a>
          <a data-share-net="email">Email</a>
          <button type="button" data-share-act="tiktok">TikTok</button>
        </div>
        <div class="share-grid share-extra">
          <button type="button" data-share-act="caption">Copy text</button>
          <button type="button" data-share-act="image" hidden>Save image</button>
          <button type="button" data-share-act="embed" hidden>Copy embed code</button>
        </div>
        <div class="share-cite" id="shareCite">
          <h3 id="citeHeading">Cite</h3>
          <div class="seg seg-sm" role="group" aria-label="Citation style">
            <button type="button" data-cite-style="plain" class="on" aria-pressed="true">Plain</button><button type="button" data-cite-style="apa" aria-pressed="false">APA</button><button type="button" data-cite-style="mla" aria-pressed="false">MLA</button><button type="button" data-cite-style="chicago" aria-pressed="false">Chicago</button>
          </div>
          <p class="cite-text" id="citeText" tabindex="0" aria-labelledby="citeHeading"></p>
          <div class="cite-row">
            <button type="button" class="share-primary" data-share-act="cite">Copy citation</button>
            <a href="/guides/how-to-cite-and-reuse/">How to cite and reuse</a>
          </div>
        </div>
        <p class="share-status" id="shareStatus" role="status" aria-live="polite"></p>
        <p class="share-note">These are ordinary links. Nothing is sent to any of these services unless you choose one.</p>
      </div>
    </dialog>
    {Tape && <Tape />}

    <main id="main" tabindex="-1">
      <div class:list={["container", flowEntity && "flow-entity"]}>
        <Fragment set:html={pageBefore} />
        {adsense && <AdSlot pos="top" />}
        <Fragment set:html={pageAfter} />
        {adsense && <AdSlot pos="multiplex" />}
      </div>
    </main>

    <footer class="site">
      <div class="container foot-grid">
        <div class="foot-brand">
          <div class="foot-top">
            <Mark size={24} />
            <Wordmark height={10} />
          </div>
          <p class="foot-copy">© {year} spotthemoney.com</p>
        </div>
        <div class="foot-text">
          <p class="disclaimer">
            <strong>Not investment advice.</strong> Figures are based on public, official data and
            disclosures that may lag actual events. Spot the Money provides transparency and historical
            information only, with no buy/sell recommendations and no trade execution.
          </p>
          <p>Sources: U.S. Treasury, BLS, SEC EDGAR, House Clerk, Senate eFD, FEC, USAspending, Senate LDA. An independent site, not affiliated with any government body, campaign or broker.</p>
        </div>
        <div class="foot-cols">
          {NAV.map((g) => (
            <nav aria-label={g.label}>
              <p class="foot-h"><a href={g.href}>{g.label}</a></p>
              <ul>{liveItems(g).map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
            </nav>
          ))}
          <nav class="foot-links" aria-label="About this site">
            <p class="foot-h">About and data</p>
            <ul>{FOOT_ABOUT.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </nav>
        </div>
      </div>
    </footer>

    <script>
      import "../scripts/ui";
    </script>
    <script>
      import "../scripts/viz";
    </script>
    <script>
      import "../scripts/share";
    </script>
    <script>
      import "../scripts/tablesort";
    </script>
    <script>
      import "../scripts/uistate";
    </script>
    <script>
      import "../scripts/tablecap";
    </script>
    <script>
      import "../scripts/account";
    </script>
  </body>
</html>
