---
// The trades heatmap — the site's centerpiece (2026-09-28). Static markup + controls here; the
// treemap, filtering and aggregation run in the browser (src/scripts/heatmap.ts) over the
// build-time JSON at /data/heatmap-<kind>.json. Two kinds share one component:
//   congress  — scope All / House / Senate / Democrats / Republicans, member picker
//   insiders  — scope All / Officers / Directors / 10% owners, filer picker, open-market-only
//               and 10b5-1 switches (defaults: open-market only, plans excluded)
// Both: window 7D/30D/90D/1Y, view Net/Buying/Selling, ticker filter, ticker/filer side list.
// `primary` makes the filter state live in the URL hash (one per page).
//
// Two ways to draw the same filtered trades (2026-10-09, Peter): the SCATTER (one dot per
// ticker; scripts/scatter.ts) is what a full-size map opens on, in the Buying view; the switch
// under the chart turns it into the HEATMAP (the treemap). `compact` is the small heatmap at the
// foot of the main pages: treemap only, Net view, window and view controls only, no side list.
import { CAP_BANDS } from "../lib/capband";
import { getFlagship, senateShown } from "../lib/flagship";
const hasSenate = senateShown(await getFlagship());
interface Props { kind: "congress" | "insiders" | "all"; primary?: boolean; height?: number; id?: string; compact?: boolean; chart?: "scatter" | "map"; view?: "net" | "buy" | "sell"; }
const { kind, primary = false, compact = false, id = `hm-${kind}` } = Astro.props as Props;
const { height = compact ? 320 : 560, chart = compact ? "map" : "scatter" } = Astro.props as Props;
const { view = chart === "scatter" ? "buy" : "net" } = Astro.props as Props;
// On a one-group page the scatter's second axis (the other group) comes from a small totals file.
const cross = kind === "all" || compact ? "" : "/data/trade-cross.json";
const src = kind === "all" ? "/data/heatmap-congress.json,/data/heatmap-insiders.json" : `/data/heatmap-${kind}.json`;
const hasInsiders = kind !== "congress";
---
<section class="heatmap" id={id} data-heatmap data-kind={kind} data-src={src} data-primary={primary ? "true" : "false"} data-compact={compact ? "true" : "false"} data-chart={chart} data-view={view} data-cross={cross || undefined} aria-label={kind === "congress" ? "Congressional trades heatmap" : kind === "insiders" ? "Corporate insider trades heatmap" : "Congress and corporate insider trades heatmap"}>
  <div class="controls hm-controls">
    {kind === "all" && (
      <div class="ctl"><span class="lbl">Who</span>
        <select data-ctl="cls" aria-label="Class">
          <option value="all">Everyone</option>
          <option value="congress">Congress only</option>
          <option value="insiders">Corporate insiders only</option>
        </select>
      </div>
    )}
    {kind !== "insiders" && (
      <div class="ctl" data-only="congress"><span class="lbl">Chamber</span>
        <select data-ctl="chamber" aria-label="Chamber">
          <option value="all">Both chambers</option>
          <option value="house">House</option>
          <option value="senate">{hasSenate ? "Senate" : "Senate (not yet included)"}</option>
        </select>
        <select data-ctl="party" aria-label="Party">
          <option value="all">Any party</option>
          <option value="dem">Democrats</option>
          <option value="rep">Republicans</option>
          <option value="ind">Independents</option>
        </select>
      </div>
    )}
    {kind !== "congress" && (
      <div class="ctl" data-only="insiders"><span class="lbl">Role</span>
        <select data-ctl="role" aria-label="Insider role">
          <option value="all">All roles</option>
          <option value="officer">Officers</option>
          <option value="director">Directors</option>
          <option value="owner">10% owners</option>
        </select>
      </div>
    )}
    <div class="ctl"><span class="lbl">{kind === "congress" ? "Member" : kind === "insiders" ? "Filer" : "Person"}</span>
      <select data-ctl="who" aria-label={kind === "congress" ? "Member" : kind === "insiders" ? "Filer" : "Person"}><option value="">{kind === "congress" ? "All members" : kind === "insiders" ? "All filers" : "Everyone"}</option></select>
    </div>
    {hasInsiders && (
      <div class="ctl"><span class="lbl">Codes</span>
        <div class="seg" data-seg="codes"><button type="button" data-v="open" class="on">Open-market</button><button type="button" data-v="all">All codes</button></div>
      </div>
    )}
    {hasInsiders && (
      <div class="ctl"><span class="lbl">10b5-1</span>
        <div class="seg" data-seg="plan"><button type="button" data-v="exclude" class="on">No 10b5-1 plans</button><button type="button" data-v="include">With plans</button></div>
      </div>
    )}
    <div class="ctl"><span class="lbl">Market cap</span>
      <select data-ctl="cap" aria-label="Market cap" title="Market cap, estimated from SEC filings: shares outstanding times the latest insider-reported price, or public float. Not a live market cap.">
        <option value="all">Any market cap</option>
        {CAP_BANDS.map((b) => <option value={b.code}>{b.label} · {b.range}</option>)}
      </select>
    </div>
    <div class="ctl" data-keep><span class="lbl">Window</span>
      <div class="seg" data-seg="window"><button type="button" data-v="7">7D</button><button type="button" data-v="30" class="on">30D</button><button type="button" data-v="90">90D</button><button type="button" data-v="365">1Y</button></div>
    </div>
    <div class="ctl" data-keep><span class="lbl">View</span>
      <div class="seg" data-seg="view"><button type="button" data-v="buy" class:list={[{ on: view === "buy" }]}>Buying</button><button type="button" data-v="net" class:list={[{ on: view === "net" }]}>Net</button><button type="button" data-v="sell" class:list={[{ on: view === "sell" }]}>Selling</button></div>
    </div>
    <div class="ctl"><span class="lbl">Tickers</span><input class="hm-input mono" data-ctl="tickers" type="text" inputmode="text" placeholder="Tickers: NVDA, AAPL" aria-label="Filter tickers" /></div>
    <button type="button" class="hm-reset" data-ctl="reset">Reset</button>
  </div>

  <div class="summary hm-summary" aria-live="polite"></div>

  <div class="hm-main">
    <div class="hm-mapcol">
      <div class="hm-map" style={`height:${height}px`} role="group" aria-label={chart === "scatter" ? "Trade scatter chart: one dot per ticker, placed by dollars bought and sold. Each dot links to that ticker's page." : "Trade map: one tile per ticker, sized by dollars disclosed. Each tile links to that ticker's page."}></div>
    {!compact && (
      <div class="hm-chart-switch">
        <span class:list={["hm-chart-ic", { on: chart === "scatter" }]} data-chart-set="scatter" title="Scatter chart" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 4v16h16"/><circle cx="9" cy="14" r="1.6" fill="currentColor" stroke="none"/><circle cx="13" cy="9" r="2.1" fill="currentColor" stroke="none"/><circle cx="17.5" cy="12.5" r="1.4" fill="currentColor" stroke="none"/><circle cx="17" cy="6" r="1.4" fill="currentColor" stroke="none"/></svg>
        </span>
        <button type="button" class="hm-toggle" role="switch" data-ctl="chart" aria-checked={chart === "map" ? "true" : "false"} aria-label="Show the heatmap instead of the scatter chart" title="Switch between the scatter chart and the heatmap"><span class="knob"></span></button>
        <span class:list={["hm-chart-ic", { on: chart === "map" }]} data-chart-set="map" title="Heatmap" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="1.5"/><path d="M12.5 3.5v17M3.5 13h9M12.5 9.5h8M16.5 9.5v11"/></svg>
        </span>
      </div>
    )}
    </div>
    <aside class="hm-side" style={`height:${height}px`}>
      <div class="hm-side-head">
        <h3 class="hm-side-title">Most traded</h3>
        <div class="seg seg-sm" data-seg="side"><button type="button" data-v="tickers" class="on">Tickers</button><button type="button" data-v="filers">{kind === "congress" ? "Members" : kind === "insiders" ? "Filers" : "People"}</button></div>
      </div>
      <div class="hm-side-rows"></div>
    </aside>
  </div>

  <div class="hm-foot">
    <div class="hm-legend"></div>
    <button type="button" class="share-btn share-btn-quiet" data-share="map"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3M8 7l4-4 4 4M5 12v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/></svg><span>Share this view</span></button>
    <div class="hm-stamp mono"></div>
  </div>
  <div class="hm-tip" aria-hidden="true"></div>
</section>

<script>
  import { initAllHeatmaps } from "../scripts/heatmap";
  initAllHeatmaps();
</script>
