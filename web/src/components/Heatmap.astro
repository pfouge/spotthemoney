---
// The trades heatmap — the site's centerpiece (2026-09-28). Static markup + controls here; the
// treemap, filtering and aggregation run in the browser (src/scripts/heatmap.ts) over the
// build-time JSON at /data/heatmap-<kind>.json. Two kinds share one component:
//   congress  — scope All / House / Senate / Democrats / Republicans, member picker
//   insiders  — scope All / Officers / Directors / 10% owners, filer picker, open-market-only
//               and 10b5-1 switches (defaults: open-market only, plans excluded)
// Both: window 7D/30D/90D/1Y, view Net/Buying/Selling, ticker filter, ticker/filer side list.
// `primary` makes the filter state live in the URL hash (one per page).
import { CAP_BANDS } from "../lib/capband";
interface Props { kind: "congress" | "insiders" | "all"; primary?: boolean; height?: number; id?: string; compact?: boolean; }
const { kind, primary = false, height = 560, id = `hm-${kind}`, compact = false } = Astro.props as Props;
const src = kind === "all" ? "/data/heatmap-congress.json,/data/heatmap-insiders.json" : `/data/heatmap-${kind}.json`;
const hasInsiders = kind !== "congress";
---
<section class="heatmap" id={id} data-heatmap data-kind={kind} data-src={src} data-primary={primary ? "true" : "false"} data-compact={compact ? "true" : "false"} aria-label={kind === "congress" ? "Congressional trades heatmap" : kind === "insiders" ? "Corporate insider trades heatmap" : "Congress and corporate insider trades heatmap"}>
  <div class="controls hm-controls">
    {kind === "all" && (
      <div class="ctl"><span class="lbl">Who</span>
        <select data-ctl="cls" aria-label="Class">
          <option value="all">Everyone</option>
          <option value="congress">Congress only</option>
          <option value="insiders">Corporate insiders only</option>
        </select>
      </div>
    )}
    {kind !== "insiders" && (
      <div class="ctl" data-only="congress"><span class="lbl">Chamber</span>
        <select data-ctl="chamber" aria-label="Chamber">
          <option value="all">Both chambers</option>
          <option value="house">House</option>
          <option value="senate">Senate (not yet included)</option>
        </select>
        <select data-ctl="party" aria-label="Party">
          <option value="all">Any party</option>
          <option value="dem">Democrats</option>
          <option value="rep">Republicans</option>
          <option value="ind">Independents</option>
        </select>
      </div>
    )}
    {kind !== "congress" && (
      <div class="ctl" data-only="insiders"><span class="lbl">Role</span>
        <select data-ctl="role" aria-label="Insider role">
          <option value="all">All roles</option>
          <option value="officer">Officers</option>
          <option value="director">Directors</option>
          <option value="owner">10% owners</option>
        </select>
      </div>
    )}
    <div class="ctl"><span class="lbl">{kind === "congress" ? "Member" : kind === "insiders" ? "Filer" : "Person"}</span>
      <select data-ctl="who" aria-label={kind === "congress" ? "Member" : kind === "insiders" ? "Filer" : "Person"}><option value="">{kind === "congress" ? "All members" : kind === "insiders" ? "All filers" : "Everyone"}</option></select>
    </div>
    {hasInsiders && (
      <div class="ctl"><span class="lbl">Codes</span>
        <div class="seg" data-seg="codes"><button type="button" data-v="open" class="on">Open-market</button><button type="button" data-v="all">All codes</button></div>
      </div>
    )}
    {hasInsiders && (
      <div class="ctl"><span class="lbl">10b5-1</span>
        <div class="seg" data-seg="plan"><button type="button" data-v="exclude" class="on">No 10b5-1 plans</button><button type="button" data-v="include">With plans</button></div>
      </div>
    )}
    <div class="ctl"><span class="lbl">Market cap</span>
      <select data-ctl="cap" aria-label="Market cap" title="Market cap, estimated from SEC filings: shares outstanding times the latest insider-reported price, or public float. Not a live market cap.">
        <option value="all">Any market cap</option>
        {CAP_BANDS.map((b) => <option value={b.code}>{b.label} · {b.range}</option>)}
      </select>
    </div>
    <div class="ctl"><span class="lbl">Window</span>
      <div class="seg" data-seg="window"><button type="button" data-v="7">7D</button><button type="button" data-v="30" class="on">30D</button><button type="button" data-v="90">90D</button><button type="button" data-v="365">1Y</button></div>
    </div>
    <div class="ctl"><span class="lbl">View</span>
      <div class="seg" data-seg="view"><button type="button" data-v="net" class="on">Net</button><button type="button" data-v="buy">Buying</button><button type="button" data-v="sell">Selling</button></div>
    </div>
    <div class="ctl"><span class="lbl">Tickers</span><input class="hm-input mono" data-ctl="tickers" type="text" inputmode="text" placeholder="Tickers: NVDA, AAPL" aria-label="Filter tickers" /></div>
    <button type="button" class="hm-reset" data-ctl="reset">Reset</button>
  </div>

  <div class="summary hm-summary" aria-live="polite"></div>

  <div class="hm-main">
    <div class="hm-map" style={`height:${height}px`} role="img" aria-label="Treemap of tickers sized by dollars disclosed"></div>
    <aside class="hm-side" style={`height:${height}px`}>
      <div class="hm-side-head">
        <h3 class="hm-side-title">Most traded</h3>
        <div class="seg seg-sm" data-seg="side"><button type="button" data-v="tickers" class="on">Tickers</button><button type="button" data-v="filers">{kind === "congress" ? "Members" : kind === "insiders" ? "Filers" : "People"}</button></div>
      </div>
      <div class="hm-side-rows"></div>
    </aside>
  </div>

  <div class="hm-foot">
    <div class="hm-legend"></div>
    <div class="hm-stamp mono"></div>
  </div>
  <div class="hm-tip" role="tooltip"></div>
</section>

<script>
  import { initAllHeatmaps } from "../scripts/heatmap";
  initAllHeatmaps();
</script>
