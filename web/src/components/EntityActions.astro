---
// Cite and Share buttons for the page, placed beside the h1 on entity pages (same markup the answer block carries).
---
<div class="entity-actions">
<button type="button" class="share-btn" data-share="page" data-share-focus="cite"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 7H6a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h3V9M9 14c0 2-1 3-3 4M20 7h-3a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h3V9M20 14c0 2-1 3-3 4"/></svg><span>Cite</span></button>
<button type="button" class="share-btn" data-share="page"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3M8 7l4-4 4 4M5 12v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/></svg><span>Share</span></button>
</div>
