---
// "Financials, as filed" on stock and company pages (lib/financials.ts has the rules).
// Renders nothing when the company has no fiscal year or quarter on file. Figures are the
// company's own, as filed with the SEC; nothing here is estimated or feeds any other total.
import type { Flagship } from "../lib/flagship";
import type { DownloadFile } from "../lib/downloads";
import { formatDate } from "../lib/format";
import { financialsOf } from "../lib/financials-build";
import { finDivisionLink } from "../lib/finscreen-build";
import { plural } from "../lib/flagship";
import { SHOWN_CONCEPTS, shownYears, shownQuarters, sourceFilings, filingUrl, cellText, summarySentence, heldCount, tagChangeCount, debtShown, debtLabel, FIN_CAVEAT, HELD_TEXT, DEBT_CONCEPT, DEBT_NOTE, NO_LINE_REASON, RATIOS, RATIO_HEAD, RATIO_NA, ratioOf, ratioText, shownRatios, ratioNote, type Period, type HeldReason } from "../lib/financials";
import DownloadCsv from "./DownloadCsv.astro";

interface Props { model: Flagship; cik: string | null | undefined; name: string; file?: DownloadFile | null }
const { model, cik, name, file } = Astro.props;
const f = financialsOf(model, cik);
const cik10 = cik ? cik.trim().padStart(10, "0") : "";
const years = f ? shownYears(f) : [];
const quarters = f ? shownQuarters(f) : [];
const all = [...years, ...quarters];
const held = heldCount(all);
const reasons = [...new Set(all.flatMap((p) => SHOWN_CONCEPTS.map((sc) => p.cells[sc.key]?.held).filter(Boolean) as HeldReason[]))].filter((r) => r !== NO_LINE_REASON);
// Long-term debt: a line only when every period on file gives it under one heading; the line is named after it.
const debtLine = f ? debtShown(f) : false;
const debtSeveral = f ? f.debtTags.length > 1 : false;
const lineLabel = (key: string, label: string) => (key === DEBT_CONCEPT && f ? debtLabel(f.debtTags[0]) : label);
const changed = tagChangeCount(all);
// The screener narrowed to this company's SIC division, with the number of companies that view opens on.
const divLink = f && all.length > 0 ? finDivisionLink(model, cik) : null;
// Ratios: this site's arithmetic on two printed lines of one column (lib/financials.ts), in rows of their own.
const ratioKeys = new Set([...shownRatios(years), ...shownRatios(quarters)].map((r) => r.key));
const ratiosNamed = RATIOS.filter((r) => ratioKeys.has(r.key));
const tables: { kind: "year" | "quarter"; id: string; title: string; cols: Period[]; head: (p: Period) => string }[] = [
  { kind: "year", id: "financials-years", title: "Fiscal years", cols: years, head: (p) => `Year to ${formatDate(p.end)}` },
  { kind: "quarter", id: "financials-quarters", title: "Quarters", cols: quarters, head: (p) => `Quarter to ${formatDate(p.end)}` },
];
---
{f && all.length > 0 && (
  <section aria-labelledby="financials" data-financials data-cik={cik10} data-unit={f.unit} data-years={years.length} data-quarters={quarters.length} data-debt={debtLine ? f.debtTags[0] : debtSeveral ? "several" : ""}>
    <h2 id="financials">Financials, as filed</h2>
    <p data-fin-summary>{summarySentence(name, f)}</p>
    <p class="fin-note" data-fin-caveat>{FIN_CAVEAT} <a href="/methodology/#financials">How these figures are read</a>. The newest figures of every tracked company are side by side in the <a href="/company-financials/">company financials screener</a>.</p>
    {divLink && <p class="fin-note" data-fin-division-link data-division={divLink.slug} data-n={divLink.n}><a href={divLink.href}>Open the {plural(divLink.n, "company", "companies")} in {divLink.name} with a fiscal year on file in the screener</a>{divLink.included ? `, ${name} among them` : ""}. The division comes from the industry code the SEC assigns and is a label only.</p>}
    <DownloadCsv file={file} label="Download the figures (CSV)" note="every tracked company, every fiscal year and quarter on file" />
    {tables.filter((t) => t.cols.length > 0).map((t) => (
      <>
        <h3 id={t.id}>{t.title}</h3>
        <div class="tablewrap"><table class="data fin" data-fin-table={t.kind}><thead><tr>
          <th scope="col">Figure</th>
          {t.cols.map((p) => <th scope="col" class="num" data-fin-col={p.end} data-start={p.start ?? ""}>{t.head(p)}</th>)}
        </tr></thead><tbody>
          {SHOWN_CONCEPTS.filter((sc) => !(t.kind === "quarter" && sc.annualOnly) && (sc.key !== DEBT_CONCEPT || debtLine)).map((sc) => (
            <tr data-fin-row={sc.key}>
              <th scope="row">{lineLabel(sc.key, sc.label)}{!sc.flow && <span class="fin-sub">at the end of the period</span>}</th>
              {t.cols.map((p) => {
                const c = p.cells[sc.key];
                if (!c) return <td class="num" data-fin={sc.key} data-v="">—</td>;
                if (c.held) return <td class="num" data-fin={sc.key} data-v="" data-held={c.held}><a class="fin-held" href="/methodology/#financials">not shown</a></td>;
                return <td class={`num${c.value < 0 ? " fin-neg" : ""}`} data-fin={sc.key} data-v={c.value} data-tag-changed={c.tagChanged ? "" : undefined}>{cellText(sc, c)}{c.tagChanged && <sup class="fin-mark" title="Filed under a different heading than the newest column">a</sup>}</td>;
              })}
            </tr>
          ))}
          {shownRatios(t.cols).length > 0 && <tr class="fin-calc" data-fin-calc><td colspan={t.cols.length + 1}>{RATIO_HEAD}</td></tr>}
          {shownRatios(t.cols).map((r) => (
            <tr data-fin-ratio={r.key}>
              <th scope="row">{r.label}<span class="fin-sub">{r.inputs}</span></th>
              {t.cols.map((p) => {
                const x = ratioOf(p, r);
                if (x.status === "none") return <td class="num" data-ratio={r.key} data-status="none" data-v="">—</td>;
                if (x.status === "base") return <td class="num fin-na" data-ratio={r.key} data-status="base" data-v="">{RATIO_NA}</td>;
                return <td class={`num${x.value! < 0 ? " fin-neg" : ""}`} data-ratio={r.key} data-status="ok" data-v={x.value}>{ratioText(r, x.value!)}</td>;
              })}
            </tr>
          ))}
          <tr data-fin-row="source">
            <th scope="row">Report</th>
            {t.cols.map((p) => (
              <td class="num fin-src" data-fin="source">
                {sourceFilings(p).map((s) => { const u = filingUrl(cik10, s.accession); const label = `${s.form}, filed ${formatDate(s.filed)}`; return <span class="fin-srcline">{u ? <a href={u} rel="noopener nofollow" target="_blank" data-acc={s.accession}>{label} ↗</a> : label}</span>; })}
              </td>
            ))}
          </tr>
        </tbody></table></div>
      </>
    ))}
    {held > 0 && <p class="fin-note" data-fin-held-note data-held={held}>{held === 1 ? "One figure is" : `${held} figures are`} not shown because {reasons.map((r) => HELD_TEXT[r]).join("; or ")}. That is usually a mistake in the filed data or two different things filed under one heading; now and then it is real, for a company with very few shares. The CSV file has the figure as filed.</p>}
    {debtSeveral && <p class="fin-note" data-fin-debt-note>{DEBT_NOTE}</p>}
    {ratioKeys.size > 0 && <p class="fin-note" data-fin-ratio-note data-ratios={ratiosNamed.map((r) => r.key).join(" ")}>{ratioNote(ratiosNamed)}</p>}
    {changed > 0 && <p class="fin-note" data-fin-tag-note data-changed={changed}><sup>a</sup> Filed under a different heading (XBRL tag) than the same line in the newest column, so the two may not measure exactly the same thing.</p>}
  </section>
)}
<style>
  .fin-note { color: var(--ink-soft); font-size: var(--t-sm); max-width: 80ch; }
  .fin-sub { display: block; font-size: var(--t-xs); font-weight: 400; color: var(--ink-soft); line-height: 1.2; }
  table.fin th[scope="row"] { text-align: left; font-weight: 400; min-width: 11rem; white-space: normal; }
  table.fin thead th.num { white-space: normal; min-width: 7.5rem; }
  .fin-neg { color: var(--red-ink); }
  .fin-na { color: var(--ink-soft); }
  tr.fin-calc td { font-size: var(--t-xs); color: var(--ink-soft); text-align: left; padding-top: var(--s-4); white-space: normal; }
  .fin-held { color: var(--ink-soft); font-size: var(--t-xs); text-decoration: underline; white-space: nowrap; }
  .fin-mark { color: var(--ink-soft); margin-left: var(--s-1); }
  .fin-src { font-size: var(--t-xs); white-space: normal; }
  .fin-srcline { display: block; }
  h3 { margin-top: var(--s-4); }
  @media (max-width: 640px) { table.fin th[scope="row"] { min-width: 8.5rem; } table.fin thead th.num { min-width: 6.5rem; } }
</style>
