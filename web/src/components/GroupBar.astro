---
// Sticky bar of an entity page: one link per group of sections (PageGroup), then "All".
// Renders nothing with fewer than two groups. Without JavaScript the links jump to groups that are all shown
// stacked; with it (scripts/reveal.ts) the bar is a tab set: one group at a time, the first open by default,
// "All" shows every group stacked, and the choice is remembered per page type for the visit (stm.ui).
interface Props { groups: { id: string; label: string }[] }
const { groups } = Astro.props;
---
{groups.length >= 2 && (
  <nav class="groupbar" aria-label="On this page" data-groupbar>
    {groups.map((g) => <a href={`#${g.id}`}>{g.label}</a>)}
    <button type="button" class="gtab-all" data-gtab-all hidden>All</button>
  </nav>
)}
