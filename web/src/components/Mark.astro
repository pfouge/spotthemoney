---
// Inline reticle mark (from the prototype). Inline so `currentColor` follows the theme —
// an <img> of the SVG would render black on the dark ground.
interface Props { size?: number; class?: string }
const { size = 22, class: cls = "mark" } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <circle cx="24" cy="24" r="19" stroke="currentColor" stroke-width="3"/>
  <circle cx="24" cy="24" r="11.5" stroke="currentColor" stroke-width="1.5" opacity=".45"/>
  <line x1="24" y1="1.5" x2="24" y2="9.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="24" y1="38.5" x2="24" y2="46.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="1.5" y1="24" x2="9.5" y2="24" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="38.5" y1="24" x2="46.5" y2="24" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <circle cx="24" cy="24" r="5.5" fill="var(--green)"/>
</svg>
