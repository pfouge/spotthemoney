---
// The Spot the Money mark: one continuous line that is a bullseye and a dollar sign (identity
// adopted 2026-10-05; geometry and rules in docs/brand/logo-2026-10-05/). Inline so
// `currentColor` follows the theme. `size` is the HEIGHT in px. Below 48px it draws the
// two-ring cut, which keeps the stroke solid; from 48px up, the full three-ring mark.
interface Props { size?: number; class?: string }
const { size = 28, class: cls = "mark" } = Astro.props;
const small = size < 48;
const [vw, vh] = small ? [64, 112] : [96, 144];
const d = small
  ? "M32,24A24,24 0 0 0 32,72A8,8 0 0 0 32,56A8,8 0 0 1 32,40A24,24 0 0 1 32,88M32,8V28M32,84V104"
  : "M48,24A40,40 0 0 0 48,104A24,24 0 0 0 48,56A8,8 0 0 0 48,72A8,8 0 0 1 48,88A24,24 0 0 1 48,40A40,40 0 0 1 48,120M48,4V28M48,116V140";
---
<svg class={cls} width={Math.round((size * vw) / vh * 100) / 100} height={size} viewBox={`0 0 ${vw} ${vh}`} fill="none" aria-hidden="true">
  <path d={d} stroke="currentColor" stroke-width="8"/>
</svg>
