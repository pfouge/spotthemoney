---
// The home page's notable-trades feed (lib/notable.ts holds the rules). The default view (7 days,
// All, newest filed) is written into the HTML here, so the page works without JavaScript and
// search engines see it; scripts/notable.ts takes over from /data/notable.json for everything else.
// The markup of one item must match what the script builds (same classes, same order).
import { selectFeed, DEFAULT_STATE, PRESETS, SORTS, WINDOWS, WIN_LABEL, FEED_PAGE, REASON_LABEL, countLine, emptyLine, shortDate, longDate, type NotableData, type Entry } from "../lib/notable";
interface Props { data: NotableData }
const { data } = Astro.props;
const all = selectFeed(data, DEFAULT_STATE);
const shown = all.slice(0, FEED_PAGE);
const empty = data.items.length === 0 && data.clusters.length === 0;
---
<section class="feed" id="notable" aria-labelledby="notableH" data-notable data-src="/data/notable.json">
  <h2 id="notableH">Notable trades</h2>
  <div class="nf-controls" data-nf-controls>
    <div class="seg" role="group" aria-label="Filing window">
      {WINDOWS.map((w) => <button type="button" data-nw={w} class:list={[{ on: w === DEFAULT_STATE.win }]} aria-pressed={w === DEFAULT_STATE.win ? "true" : "false"}>{WIN_LABEL[w]}</button>)}
    </div>
    <div class="nf-chips" role="group" aria-label="Kind of trade">
      {PRESETS.map((p) => <button type="button" data-np={p.id} class:list={["nf-chip", { on: p.id === DEFAULT_STATE.preset }]} aria-pressed={p.id === DEFAULT_STATE.preset ? "true" : "false"}>{p.label}</button>)}
    </div>
    <div class="nf-tools">
      <label class="nf-search"><span class="sr-only">Search the feed by ticker, company or person</span><input type="search" data-nq placeholder="Search ticker, company or person" autocomplete="off" spellcheck="false" maxlength="60" /></label>
      <label class="ctl"><span class="sr-only">Sort the feed</span>
        <select data-ns aria-label="Sort the feed">{SORTS.map((s) => <option value={s.id} selected={s.id === DEFAULT_STATE.sort}>{s.label}</option>)}</select>
      </label>
    </div>
  </div>
  <p class="nf-count" data-nf-count role="status" aria-live="polite">{empty ? "" : all.length ? countLine(all.length, shown.length, DEFAULT_STATE, data.newest) : ""}</p>
  <noscript><p class="note">The filters need JavaScript. This list shows the last 7 days.</p></noscript>
  {all.length > 0 && (
    <ul class="nf-list" data-nf-list>
      {shown.map((e: Entry) => e.k === "c" ? (
        <li class="nf-item nf-cluster">
          <div class="nf-c nf-date"><time datetime={e.d}>{shortDate(e.d)}</time><span class="nf-sub">Traded {shortDate(e.f)}{e.f !== e.l ? ` to ${shortDate(e.l)}` : ""}</span></div>
          <div class="nf-c nf-who"><b>{e.n} insiders</b><span class="nf-sub">{e.who.map((w, i) => <Fragment>{i > 0 ? ", " : ""}{w.p ? <a href={w.p}>{w.n}</a> : w.n}</Fragment>)}</span></div>
          <div class="nf-c nf-stock">{e.tp ? <a class="nf-tk" href={e.tp}>{e.tk}</a> : <span class="nf-tk">{e.tk}</span>}<span class="nf-sub">{e.co}</span></div>
          <div class="nf-c nf-act buy"><b>▲ Bought</b></div>
          <div class="nf-c nf-val"><b>{e.vl}</b><span class="nf-sub">{e.ids.length} purchases</span></div>
          <div class="nf-c nf-chg"></div>
          <div class="nf-c nf-tags"><span class="nf-tag">{REASON_LABEL.cluster}</span></div>
          <div class="nf-c nf-src"></div>
        </li>
      ) : (
        <li class="nf-item">
          <div class="nf-c nf-date"><time datetime={e.d}>{shortDate(e.d)}</time><span class="nf-sub">Traded {shortDate(e.t)}</span></div>
          <div class="nf-c nf-who">{e.np ? <a href={e.np}>{e.n}</a> : <b>{e.n}</b>}<span class="nf-sub">{e.r}</span></div>
          <div class="nf-c nf-stock">{e.tp ? <a class="nf-tk" href={e.tp}>{e.tk}</a> : <span class="nf-tk">{e.tk}</span>}<span class="nf-sub">{e.co}</span></div>
          <div class={`nf-c nf-act ${e.b ? "buy" : "sell"}`}><b>{e.b ? "▲ Bought" : "▼ Sold"}</b></div>
          <div class="nf-c nf-val"><b>{e.vl}</b><span class="nf-sub">{e.vs}</span></div>
          <div class="nf-c nf-chg">{e.ch && e.ch !== "—" ? <Fragment>{e.ch}<span class="nf-sub">of holding</span></Fragment> : null}</div>
          <div class="nf-c nf-tags">{e.tg.map((t) => <span class="nf-tag">{REASON_LABEL[t]}</span>)}</div>
          <div class="nf-c nf-src">{e.u ? <a href={e.u} rel="noopener nofollow" target="_blank">{e.ul} ↗</a> : null}</div>
        </li>
      ))}
    </ul>
  )}
  <p class="nf-empty" data-nf-empty hidden={all.length > 0}>{all.length > 0 ? "" : empty ? "No notable trades have been filed yet; the feed fills as new filings are read." : emptyLine(DEFAULT_STATE)}</p>
  <p class="nf-more-row"><button type="button" class="btn nf-more" data-nf-more hidden={all.length <= shown.length}>Show more</button></p>
  <p class="soft small nf-foot">Filing dates, newest first. A trade is listed when it matches a rule on the <a href="/methodology/#notable">methodology page</a>; it says what was filed, not why. Newest filing in the data: {longDate(data.newest)}.</p>
</section>
