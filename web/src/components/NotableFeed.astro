---
// The home page's notable-trades feed (lib/notable.ts holds the rules). The default view (7 days,
// All, newest filed) is written into the HTML here, so the page works without JavaScript and
// search engines see it; scripts/notable.ts takes over from /data/notable.json for everything else.
// The markup of one item must match what the script builds (same classes, same order).
import { actLabel, resolveView, DEFAULT_STATE, PRESETS, SORTS, WINDOWS, WIN_LABEL, FEED_PAGE, PREVIEW_ROWS_PHONE, REASON_LABEL, CLUSTER_SELL_MIN_INSIDERS, CLUSTER_SELL_MIN_PCT, CLUSTER_SELL_MIN_VALUE, countLine, capLine, emptyLine, shortDate, longDate, type NotableData, type Entry } from "../lib/notable";
import { money } from "../lib/flagship";
interface Props { data: NotableData }
const { data } = Astro.props;
const view = resolveView(data, DEFAULT_STATE);
const all = view.entries;
const shownWin = view.win;
const shown = all.slice(0, FEED_PAGE);
const empty = data.items.length === 0 && data.clusters.length === 0;
---
<section class="feed" id="notable" aria-labelledby="notableH" data-notable data-src="/data/notable.json">
  <div class="nf-head">
    <h2 id="notableH">Notable trades</h2>
    <div class="nf-tools">
      <label class="nf-search"><span class="sr-only">Search the feed by ticker, company or person</span><input type="search" data-nq placeholder="Search ticker, company or person" autocomplete="off" spellcheck="false" maxlength="60" /></label>
      <label class="ctl"><span class="sr-only">Sort the feed</span>
        <select data-ns aria-label="Sort the feed">{SORTS.map((s) => <option value={s.id} selected={s.id === DEFAULT_STATE.sort}>{s.label}</option>)}</select>
      </label>
    </div>
  </div>
  <div class="nf-controls" data-nf-controls>
    <div class="seg" role="group" aria-label="Filing window">
      {WINDOWS.map((w) => <button type="button" data-nw={w} class:list={[{ on: w === shownWin }]} aria-pressed={w === shownWin ? "true" : "false"}>{WIN_LABEL[w]}</button>)}
    </div>
    <div class="nf-chips" role="group" aria-label="Kind of trade">
      {PRESETS.map((p) => <button type="button" data-np={p.id} class:list={["nf-chip", { on: p.id === DEFAULT_STATE.preset }]} aria-pressed={p.id === DEFAULT_STATE.preset ? "true" : "false"}>{p.label}</button>)}
    </div>
  </div>
  <p class="nf-count" data-nf-count role="status" aria-live="polite">{empty ? "" : all.length ? countLine(all.length, shown.length, { ...DEFAULT_STATE, win: shownWin }, data.newest, view.fellBack) : ""}</p>
  <p class="soft small nf-cap" data-nf-cap role="status">{capLine(data, { ...DEFAULT_STATE, win: shownWin })}</p>
  <noscript><p class="note">The filters need JavaScript. This list shows the last {shownWin} days.</p></noscript>
  {all.length > 0 && (
    <ul class="nf-list" data-nf-list data-preview>
      {shown.map((e: Entry) => e.k === "c" ? (
        <li class="nf-item nf-cluster">
          <div class="nf-c nf-date"><time datetime={e.d}>{shortDate(e.d)}</time></div>
          <div class="nf-c nf-stock">{e.tp ? <a class="nf-tk" href={e.tp}>{e.tk}</a> : <span class="nf-tk">{e.tk}</span>}<span class="nf-sub">{e.co}</span></div>
          <div class={`nf-c nf-act ${e.b ? "buy" : "sell"}`}><b>{actLabel(e.b, e.n)}</b></div>
          <div class="nf-c nf-val"><b>{e.vl}</b></div>
          <div class="nf-c nf-who"><b>{e.n} insiders</b></div>
          <div class="nf-c nf-tags"><span class="nf-tag">{e.b ? REASON_LABEL.cluster : REASON_LABEL["cluster-sell"]}</span></div>
          <button type="button" class="nf-exp" aria-expanded="false" aria-label={`Details: ${e.tk}, ${e.n} insiders`}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
          <div class="nf-detail" hidden>
            <span class="nf-sub">Traded {shortDate(e.f)}{e.f !== e.l ? ` to ${shortDate(e.l)}` : ""}</span>
            <span class="nf-sub nf-names">{e.who.map((w, i) => <Fragment>{i > 0 ? ", " : ""}{w.p ? <a href={w.p}>{w.n}</a> : w.n}</Fragment>)}</span>
            <span class="nf-sub">{e.ids.length} {e.b ? "purchases" : "sales"}</span>
          </div>
        </li>
      ) : (
        <li class="nf-item">
          <div class="nf-c nf-date"><time datetime={e.d}>{shortDate(e.d)}</time></div>
          <div class="nf-c nf-stock">{e.tp ? <a class="nf-tk" href={e.tp}>{e.tk}</a> : <span class="nf-tk">{e.tk}</span>}<span class="nf-sub">{e.co}</span></div>
          <div class={`nf-c nf-act ${e.b ? "buy" : "sell"}`}><b>{actLabel(e.b)}</b></div>
          <div class="nf-c nf-val"><b>{e.vl}</b></div>
          <div class="nf-c nf-who">{e.np ? <a href={e.np}>{e.n}</a> : <b>{e.n}</b>}</div>
          <div class="nf-c nf-tags">{e.tg.map((t) => <span class="nf-tag">{REASON_LABEL[t]}</span>)}</div>
          <button type="button" class="nf-exp" aria-expanded="false" aria-label={`Details: ${e.tk}, ${e.n}`}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
          <div class="nf-detail" hidden>
            <span class="nf-sub">Traded {shortDate(e.t)}</span>
            <span class="nf-sub">{e.r}</span>
            <span class="nf-sub">{e.vs}</span>
            {e.ch && e.ch !== "—" ? <span class="nf-sub">{e.ch} of holding</span> : null}
            {e.u ? <a class="nf-src" href={e.u} rel="noopener nofollow" target="_blank">{e.ul} ↗</a> : null}
          </div>
        </li>
      ))}
    </ul>
  )}
  <p class="nf-empty" data-nf-empty hidden={all.length > 0}>{all.length > 0 ? "" : empty ? "No notable trades have been filed yet; the feed fills as new filings are read." : emptyLine(DEFAULT_STATE, view.offerAll)}{all.length === 0 && !empty && view.offerAll ? <Fragment>{" "}<button type="button" class="btn nf-all" data-nf-all>Show all notable trades</button></Fragment> : null}</p>
  <p class="nf-more-row"><button type="button" class="btn nf-more" data-nf-more hidden={all.length <= PREVIEW_ROWS_PHONE && all.length <= shown.length}>Show more</button></p>
  <details class="nf-about" data-remember id="nfAbout">
    <summary>About this list</summary>
    <p class="soft small nf-foot">Filing dates, newest first. A trade is listed when it matches a rule on the <a href="/methodology/#notable">methodology page</a>; it says what was filed, not why. Newest filing in the data: {longDate(data.newest)}.</p>
  <p class="soft small nf-sellnote">Why sales are held to a stricter test: insiders are paid largely in stock and sell routinely, so a cluster sell counts only sales outside pre-arranged 10b5-1 plans that cut the seller's own holding by at least {CLUSTER_SELL_MIN_PCT} percent and total at least {money(CLUSTER_SELL_MIN_VALUE, { compact: false })} each, from {CLUSTER_SELL_MIN_INSIDERS} or more insiders of one company. <a href="/methodology/#notable">The full rules</a>.</p>
  </details>
</section>
