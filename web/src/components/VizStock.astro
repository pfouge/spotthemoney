---
// Chart deck for one ticker or company on the build pages: the build-time model into
// components/VizDeck.astro, which draws it (and also serves the Worker's on-demand pages).
import { pageTxns } from "../lib/onepage";
import VizDeck from "./VizDeck.astro";
import { getFlagship, type Security, type Company } from "../lib/flagship";
interface Props { security?: Security; company?: Company | null; embedOnly?: boolean }
const { security: s, company: c = null, embedOnly = false } = Astro.props;
const model = await getFlagship();
const txns = s ? pageTxns(model, s) : c ? c.txns : [];
---
<VizDeck model={model} txns={txns} security={s} company={c} embedOnly={embedOnly} />
