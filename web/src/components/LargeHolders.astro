---
// "Large holders: Schedules 13D and 13G" on stock and company pages (lib/schedule13.ts has the
// rules). Renders nothing unless the Schedule 13 load has reached today (model.schedule13.shown)
// and a statement about the company is on record. One row per holder: its newest statement.
// A statement is what the filer says it owned on a date, never a trade: nothing here feeds a
// total, a chart or the trade map, and nothing is added up.
import type { Flagship } from "../lib/flagship";
import type { DownloadFile } from "../lib/downloads";
import { num } from "../lib/flagship";
import { formatDate } from "../lib/format";
import { holdersOf, holderSummary, summarySentence, cleanText, sharesStated, percentStated, percentLabel, belowThreshold, HOLDER_CAVEAT, HOLDER_ROWS, THRESHOLD_PERCENT } from "../lib/schedule13";
import { holderPath } from "../lib/schedule13-build";
import DownloadCsv from "./DownloadCsv.astro";

interface Props { model: Flagship; cik: string | null | undefined; name: string; file?: DownloadFile | null }
const { model, cik, name, file } = Astro.props;
const all = cik && model.schedule13.shown ? model.schedule13.byCik.get(cik.padStart(10, "0")) ?? [] : [];
const holders = holdersOf(all, model.builtAt);
const s = holderSummary(holders);
const shown = holders.slice(0, HOLDER_ROWS);
const heads = [
  { label: "Holder, as filed", type: "text", cls: "" }, { label: "Percent of class", type: "num", cls: "num" }, { label: "Shares stated", type: "num", cls: "num" },
  { label: "Class", type: "text", cls: "" }, { label: "As of (event date)", type: "num", cls: "" }, { label: "Filed", type: "num", cls: "" },
];
const dayNum = (d: string | null) => (d ? d.replaceAll("-", "") : "");
const attrText = (t: string) => t.toLowerCase().replace(/[<>"]/g, "");
---
{holders.length > 0 && (
  <section aria-labelledby="large-holders" data-large-holders data-cik={cik!.padStart(10, "0")} data-holders={s.holders} data-at-or-above={s.atOrAbove} data-below={s.below} data-no-percent={s.noPercent} data-statements={s.statements}>
    <h2 id="large-holders">Large holders: Schedules 13D and 13G</h2>
    <p data-lh-summary>{summarySentence(name, s)}</p>
    <p class="lh-note" data-lh-caveat>{HOLDER_CAVEAT} <a href="/guides/ten-percent-owners-and-joint-filings/#large-holders">What Schedules 13D and 13G are</a>.</p>
    <DownloadCsv file={file} label="Download all statements (CSV)" note="every tracked company" />
    <div class="tablewrap"><table class="data" data-sortable><thead><tr>
      {heads.map((h) => <th class={h.cls} aria-sort="none" data-type={h.type}><button type="button" class="sort" aria-label={`Sort by ${h.label.toLowerCase()}`}>{h.label}<span class="arr" aria-hidden="true"></span></button></th>)}
      <th>Source</th>
    </tr></thead><tbody>
      {shown.map((h) => {
        const st = h.latest;
        const holder = cleanText(st.reporterName) ?? "Not stated";
        const href = holderPath(model, st);
        const others = st.reporterCount > 1 ? st.reporterCount - 1 : 0;
        const cls = cleanText(st.securityClass, 60);
        const pct = percentLabel(st.percent);
        const sh = sharesStated(st.shares);
        const label = `Schedule ${st.schedule}${st.isAmendment ? "/A (amendment)" : ""}`;
        return (
          <tr data-statement={st.accession}>
            <td class="wrap lh-holder" data-v={attrText(holder)} data-lh-holder>{href ? <a href={href}>{holder}</a> : holder}{others > 0 && <span class="lh-sub" data-lh-others>with {num(others)} other reporting {others === 1 ? "person" : "persons"}</span>}</td>
            <td class="num" data-v={percentStated(st.percent) ?? ""} data-lh-percent>{pct ?? "—"}{belowThreshold(st) && <span class="lh-sub" data-lh-below>below {THRESHOLD_PERCENT}%</span>}</td>
            <td class="num" data-v={sh != null ? Math.round(sh) : ""} data-lh-shares>{sh != null ? num(sh) : "—"}</td>
            <td class="wrap lh-class" data-v={attrText(cls ?? "")}>{cls ?? "—"}</td>
            <td class="mono" data-v={dayNum(st.eventDate)} data-lh-event>{st.eventDate ? formatDate(st.eventDate) : "—"}</td>
            <td class="mono" data-v={dayNum(st.filedAt)} data-lh-filed>{formatDate(st.filedAt)}</td>
            <td data-lh-source>{st.sourceUrl ? <a href={st.sourceUrl} rel="noopener nofollow" target="_blank">{label} ↗</a> : label}</td>
          </tr>
        );
      })}
    </tbody></table></div>
    {holders.length > HOLDER_ROWS && <p class="lh-note" data-lh-more>The {HOLDER_ROWS} holders with the largest stated percentages, of {num(holders.length)}, are shown. The rest are in the CSV file.</p>}
  </section>
)}
<style>
  .lh-sub { display: block; font-size: 12.5px; color: var(--ink-soft); line-height: 1.2; margin-top: 1px; }
  .lh-holder { min-width: 13rem; }
  .lh-class { min-width: 8rem; }
  @media (max-width: 640px) { .lh-holder { min-width: 10rem; } .lh-class { min-width: 7rem; } }
  .lh-note { color: var(--ink-soft); font-size: 14px; max-width: 80ch; }
</style>
