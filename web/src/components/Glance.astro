---
// "At a glance" tiles on an entity page: a few counts the page already holds, each linking to
// the section that lists the rows. A tile is passed in only when its section is on the page.
// `bars` is an optional series of counts per month for the last 12 months, by the dataset's own date
// (lib/glancespark.ts); {up, down} pairs draw purchases above the baseline and sales below it.
import { sparkBars } from "../lib/viz";
import type { MonthBar } from "../lib/glancespark";
interface Props { items: { label: string; value: string; note?: string; href: string; bars?: MonthBar[] }[] }
const items = Astro.props.items.slice(0, 8);
const sparkOf = (i: { label: string; bars?: MonthBar[] }) => (i.bars && i.bars.length ? sparkBars(i.bars, { w: 96, h: 24, label: `${i.label}: ${i.bars.some((b) => typeof b === "object") ? "purchases and sales" : "rows"} per month, last 12 months` }) : "");
---
{items.length >= 1 && (
  <section class="glance" aria-label="At a glance" data-glance>
    {items.map((i) => (
      <span class="glance-t">
        <a href={i.href}>
          <span class="glance-v">{i.value}</span>
          <span class="glance-k">{i.label}</span>
          {i.note && <span class="glance-n">{i.note}</span>}
        </a>
        {sparkOf(i) && <span class="glance-s" aria-hidden="true" set:html={sparkOf(i).replace(/ role="img" aria-label="[^"]*"/, "")} />}
      </span>
    ))}
  </section>
)}
