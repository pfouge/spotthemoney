---
// "Campaign committee" on a member's page (lib/campaign.ts has the rules). Renders nothing when
// the member has no linked committee with receipts. The numbers are itemized receipts this site
// holds, a sample for a large committee, never a total. Nothing here ties a receipt to a trade.
import type { Flagship } from "../lib/flagship";
import type { DownloadFile } from "../lib/downloads";
import DownloadCsv from "./DownloadCsv.astro";
import { formatDate } from "../lib/format";
import { num } from "../lib/flagship";
import { CAMPAIGN_CAVEAT, RECENT_DAYS, fecCommitteeUrl, shownFor } from "../lib/campaign";

interface Props { model: Flagship; slug: string | null | undefined; file?: DownloadFile | null }
const { model, slug, file } = Astro.props;
const list = shownFor(model.campaign, slug);
const usd = (x: number) => `$${Math.round(x).toLocaleString("en-US")}`;
const heads = (what: string) => [{ label: what, type: "text", cls: "" }, { label: "Sum", type: "num", cls: "num" }, { label: "Receipts", type: "num", cls: "num" }];
---
{list.length > 0 && (
  <section aria-labelledby="campaign-committee" data-campaign data-committees={list.length}>
    <h2 id="campaign-committee">Campaign committee</h2>
    <p class="cc-note" data-cc-caveat>{CAMPAIGN_CAVEAT} <a href="/methodology/#campaign-committee">How this is worked out</a> · <a href="/donations/">All committees</a>.</p>
    {list.map((c) => (
      <div class="cc-block" data-committee={c.fecId}>
        <h3><a href={fecCommitteeUrl(c.fecId)} rel="noopener nofollow" target="_blank">{c.name}</a></h3>
        <dl class="facts" data-cc-facts>
          <div><dt>Itemized receipts held</dt><dd data-cc-held={c.held}>{num(c.held)}, sum {usd(c.sum)}</dd></div>
          <div><dt>Last {RECENT_DAYS} days</dt><dd data-cc-held90={c.held90}>{num(c.held90)}, sum {usd(c.sum90)}</dd></div>
          <div><dt>First receipt held</dt><dd>{c.first ? formatDate(c.first) : "None"}</dd></div>
          <div><dt>Newest receipt held</dt><dd>{c.newest ? formatDate(c.newest) : "None"}</dd></div>
        </dl>
        {c.note && <p class="cc-note" data-cc-note>{c.note}</p>}
        <div class="cc-tables">
          {c.employers.length > 0 && (
            <div>
              <h4>Largest employers named by donors</h4>
              <div class="tablewrap"><table class="data" data-sortable data-cc-employers><thead><tr>
                {heads("Employer").map((h) => <th class={h.cls} aria-sort="none" data-type={h.type}><button type="button" class="sort" aria-label={`Sort by ${h.label.toLowerCase()}`}>{h.label}<span class="arr" aria-hidden="true"></span></button></th>)}
              </tr></thead><tbody>
                {c.employers.map((r) => <tr><td class="wrap" data-v={r.key.toLowerCase().replace(/[<>"]/g, "")}>{r.key}</td><td class="num" data-v={Math.round(r.sum)}>{usd(r.sum)}</td><td class="num" data-v={r.count}>{num(r.count)}</td></tr>)}
              </tbody></table></div>
              <p class="cc-note" data-cc-omitted>Left out: {num(c.employerOmitted)} {c.employerOmitted === 1 ? "receipt" : "receipts"} where the donor gave no employer or wrote a word such as retired, self-employed, none or not employed.</p>
            </div>
          )}
          {c.states.length > 0 && (
            <div>
              <h4>Largest donor states</h4>
              <div class="tablewrap"><table class="data" data-sortable data-cc-states><thead><tr>
                {heads("State").map((h) => <th class={h.cls} aria-sort="none" data-type={h.type}><button type="button" class="sort" aria-label={`Sort by ${h.label.toLowerCase()}`}>{h.label}<span class="arr" aria-hidden="true"></span></button></th>)}
              </tr></thead><tbody>
                {c.states.map((r) => <tr><td data-v={r.key.toLowerCase()}>{r.key}</td><td class="num" data-v={Math.round(r.sum)}>{usd(r.sum)}</td><td class="num" data-v={r.count}>{num(r.count)}</td></tr>)}
              </tbody></table></div>
            </div>
          )}
        </div>
      </div>
    ))}
    <DownloadCsv file={file} label="Download the committee list (CSV)" note="every linked committee, counts only" />
  </section>
)}
<style>
  .cc-note { color: var(--ink-soft); font-size: var(--t-sm); max-width: 80ch; }
  .cc-tables { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: var(--s-4); }
  .cc-block { margin-block: var(--s-4); }
</style>
