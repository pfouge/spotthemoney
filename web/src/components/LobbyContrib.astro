---
// "Lobbyist contributions" on member pages (lib/lobbygifts.ts has the rules): items on Form LD-203
// reports whose honoree field names this member or whose payee is the member's campaign committee, matched narrowly by memberForItem. Nothing here
// says why a contribution was made; the names are as typed by the filer.
import type { Flagship } from "../lib/flagship";
import { money, num } from "../lib/flagship";
import { formatDate } from "../lib/format";
import { orgPath } from "../lib/links";
import { LOBBY_CONTRIB_CAVEAT, MEMBER_ROWS, sentenceCase, summarySentence } from "../lib/lobbygifts";
import DownloadCsv from "./DownloadCsv.astro";
import type { DownloadFile } from "../lib/downloads";

interface Props { model: Flagship; slug: string | null | undefined; file?: DownloadFile | null }
const { model, slug, file } = Astro.props;
const s = slug ? model.lobbyContrib.members.get(slug) : undefined;
const total = s ? s.years.reduce((a, y) => a + y.items, 0) : 0;
const dayNum = (d: string | null) => (d ? d.replaceAll("-", "") : "");
const heads = [{ l: "Date", t: "num" }, { l: "Filer", t: "text" }, { l: "Type", t: "text" }, { l: "Contributor", t: "text" }, { l: "Payee", t: "text" }, { l: "Honoree, as typed", t: "text" }, { l: "Amount", t: "num" }];
---
{s && total > 0 && (
  <section aria-labelledby="lobbyist-contributions" data-lobby-contrib data-items={total}>
    <h2 id="lobbyist-contributions">Lobbyist contributions</h2>
    <p data-lc-summary>{summarySentence(s.years, model.lobbyContrib.newestYear ?? s.years[0]!.year, (n) => money(n, { compact: false }))}</p>
    <p class="lc-note" data-lc-caveat>{LOBBY_CONTRIB_CAVEAT} <a href="/lobbyist-contributions/">All lobbyist contributions</a> · <a href="/guides/lobbying-disclosure-reports/#contributions">How to read an LD-203 report</a>.</p>
    <DownloadCsv file={file} label="Download all items (CSV)" note="every item, all recipients" />
    <div class="tablewrap"><table class="data" data-sortable><thead><tr>
      {heads.map((h) => <th class={h.t === "num" && h.l === "Amount" ? "num" : ""} aria-sort="none" data-type={h.t}><button type="button" class="sort" aria-label={`Sort by ${h.l.toLowerCase()}`}>{h.l}<span class="arr" aria-hidden="true"></span></button></th>)}
      <th>Source</th>
    </tr></thead><tbody>
      {s.items.slice(0, MEMBER_ROWS).map((r) => (
        <tr data-lc-item>
          <td class="mono" data-v={dayNum(r.date)}>{r.date ? formatDate(r.date) : "—"}</td>
          <td class="wrap lc-who" data-v={(r.registrant ?? "").toLowerCase().replace(/[<>"]/g, "")}>{r.registrant && orgPath(model, r.registrant) ? <a href={orgPath(model, r.registrant)!}>{r.registrant}</a> : (r.registrant ?? "—")}{r.lobbyist && <span class="lc-sub">{r.lobbyist}</span>}</td>
          <td class="wrap" data-v={(r.type ?? "").toLowerCase()}>{r.type ? sentenceCase(r.type) : "—"}</td>
          <td class="wrap lc-who" data-v={(r.contributor ?? "").toLowerCase().replace(/[<>"]/g, "")}>{r.contributor ?? "—"}</td>
          <td class="wrap lc-who" data-v={(r.payee ?? "").toLowerCase().replace(/[<>"]/g, "")}>{r.payee ?? "—"}</td>
          <td class="wrap lc-who" data-v={(r.honoree ?? "").toLowerCase().replace(/[<>"]/g, "")}>{r.honoree ?? "—"}</td>
          <td class="num" data-v={r.amount != null ? Math.round(r.amount) : ""}>{r.amount != null ? money(r.amount, { compact: false }) : "—"}</td>
          <td>{r.sourceUrl ? <a href={r.sourceUrl} rel="noopener nofollow" target="_blank">LD-203 ↗</a> : "—"}</td>
        </tr>
      ))}
    </tbody></table></div>
    {total > MEMBER_ROWS && <p class="lc-note" data-lc-more>The {MEMBER_ROWS} newest of {num(total)} items are shown. The rest are in the CSV file.</p>}
  </section>
)}
<style>
  .lc-note { color: var(--ink-soft); font-size: 14px; max-width: 80ch; }
  .lc-who { min-width: 10rem; max-width: 18rem; }
  .lc-sub { display: block; font-size: 12.5px; color: var(--ink-soft); line-height: 1.2; margin-top: 1px; }
  @media (max-width: 640px) { .lc-who { min-width: 8rem; } }
</style>
