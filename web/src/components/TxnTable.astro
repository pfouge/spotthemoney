---
// Transactions table. Columns adapt to context: `showPerson` on ticker/company pages,
// `showSecurity` on person pages. Every row links to the source document (EDGAR filing
// index or House Clerk PDF) — the "direct link on every row" rule from docs/07 §8.
import type { Flagship, Txn } from "../lib/flagship";
import { amountLabel, assetLabel, sideLabel, isLate, personPath, securityPath, num, money } from "../lib/flagship";
import { edgarFilingUrl } from "../lib/seo";
import { formatDate } from "../lib/format";
import Empty from "./Empty.astro";
import { tradeSentence } from "../lib/sharetext";
import { flagHref } from "../lib/links";
import { dayKey, numKey } from "../lib/tablesort";
import { changeLabel, changeSortKey } from "../lib/holdings";
import { tableFootnotes, notesLabel, notesAnchor } from "../lib/footnotes";

interface Props {
  model: Flagship;
  txns: Txn[];
  showPerson?: boolean;
  showSecurity?: boolean;
  limit?: number;
  emptyReason?: string;
  caption?: string;
}
const { model, txns, showPerson = false, showSecurity = false, limit = 200, emptyReason = "No disclosed transactions in this set yet.", caption } = Astro.props;
const rows = txns.slice(0, limit);
// Row anchors (#t<id>) for "share this trade". A trade can sit in two tables on one page (the
// preset feeds on /insiders/): only its first appearance gets the id, so ids stay unique.
const seen: Set<number> = ((Astro.locals as { txnAnchors?: Set<number> }).txnAnchors ??= new Set<number>());
const here = Astro.url.pathname;
const short = (iso: string | null) => (iso ? formatDate(iso).replace(/, (\d{4})$/, ", $1") : "—");
const sourceLabel = (t: Txn) => (t.source === "sec_form4" ? "Form 4" : t.source === "house_ptr" ? "House PTR" : "Senate PTR");
const sourceHref = (t: Txn) => (t.source === "sec_form4" ? edgarFilingUrl(t.sourceUrl) : t.sourceUrl);
const flags = (t: Txn) => {
  const f: string[] = [];
  if (isLate(t)) f.push("late");
  if (t.is10b51) f.push("10b5-1 plan");
  if (t.ownerType && t.ownerType !== "self") f.push(t.ownerType);
  if (t.isDerivative) f.push("derivative");
  if (t.jointOf != null) f.push("also in another filing");
  if (!t.isPublished) f.push("under review");
  return f;
};
// Column sorting (scripts/tablesort.ts): sortable headers carry a button, and each body cell in a
// sortable column carries its machine-sortable value in `data-v` (lib/tablesort.ts).
// "Held after" / "Change" (lib/holdings.ts): shown only when some row in this table has the data
// (insider rows); congressional tables never do.
const showHoldings = rows.some((t) => t.ownedAfter != null);
const changeClass = (c: Txn["holdingsChange"]) => (c === "new" || (typeof c === "number" && c > 0) ? "pos" : typeof c === "number" && c < 0 ? "neg" : "");
// Form 4 footnotes (lib/footnotes.ts): a row whose filing has footnotes links to them, and they
// are printed once per filing, folded, under the table. A filing already printed by an earlier
// table on this page is linked, not printed again, so ids stay unique and the page stays light.
const printed: Set<number> = ((Astro.locals as { noteBlocks?: Set<number> }).noteBlocks ??= new Set<number>());
const noteCount = (t: Txn) => (t.source === "sec_form4" ? model.footnotes.get(t.filingId)?.length ?? 0 : 0);
const noteBlocks = tableFootnotes(rows.filter((t) => t.source === "sec_form4").map((t) => t.filingId), (id) => model.footnotes.get(id)).filter((b) => !printed.has(b.filingId));
for (const b of noteBlocks) printed.add(b.filingId);
const noteHead = (filingId: number) => {
  const f = model.filings.get(filingId);
  const p = f?.personId != null ? model.people.get(f.personId) : undefined;
  return { name: p?.name ?? "Form 4", filed: f?.filedAt ? short(f.filedAt.slice(0, 10)) : null, href: f ? edgarFilingUrl(f.sourceUrl) : null };
};
const valueKey = (t: Txn) => numKey(t.value ?? t.amountHigh ?? t.amountLow);
---
{rows.length === 0 ? (
  <Empty reason={emptyReason} />
) : (
  <>
  <div class="tablewrap">
    <table class="data txns" data-sortable>
      {caption && <caption>{caption}</caption>}
      <thead>
        <tr>
          {showPerson && <th aria-sort="none" data-type="text"><button type="button" class="sort" title="Sort by filer" aria-label="Sort by filer">Filer<span class="arr" aria-hidden="true"></span></button></th>}
          {showSecurity && <th aria-sort="none" data-type="text"><button type="button" class="sort" title="Sort by security" aria-label="Sort by security">Security<span class="arr" aria-hidden="true"></span></button></th>}
          <th>Side</th>
          <th aria-sort="none" data-type="num"><button type="button" class="sort" title="Sort by trade date" aria-label="Sort by trade date">Trade date<span class="arr" aria-hidden="true"></span></button></th>
          <th aria-sort="none" data-type="num"><button type="button" class="sort" title="Sort by disclosed date" aria-label="Sort by disclosed date">Disclosed<span class="arr" aria-hidden="true"></span></button></th>
          <th class="num" aria-sort="none" data-type="num"><button type="button" class="sort" title="Sort by lag" aria-label="Sort by lag">Lag<span class="arr" aria-hidden="true"></span></button></th>
          <th class="num" aria-sort="none" data-type="num"><button type="button" class="sort" title="Sort by shares" aria-label="Sort by shares">Shares<span class="arr" aria-hidden="true"></span></button></th>
          <th class="num" aria-sort="none" data-type="num"><button type="button" class="sort" title="Sort by price" aria-label="Sort by price">Price<span class="arr" aria-hidden="true"></span></button></th>
          {showHoldings && <th class="num" aria-sort="none" data-type="num"><button type="button" class="sort" title="Shares held after this transaction, as reported" aria-label="Sort by held after">Held after<span class="arr" aria-hidden="true"></span></button></th>}
          {showHoldings && <th class="num" aria-sort="none" data-type="num"><button type="button" class="sort" title="Change in the insider's reported holdings from this transaction" aria-label="Sort by change in holdings">Change<span class="arr" aria-hidden="true"></span></button></th>}
          <th class="num" aria-sort="none" data-type="num"><button type="button" class="sort" title="Sort by value" aria-label="Sort by value">Value<span class="arr" aria-hidden="true"></span></button></th>
          <th>Flags</th>
          <th>Source</th>
          <th class="rs"><span class="sr-only">Share</span></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((t) => {
          const p = t.personId != null ? model.people.get(t.personId) : undefined;
          const s = t.securityId != null ? model.securities.get(t.securityId) : undefined;
          const pp = p ? personPath(p) : null;
          const href = sourceHref(t);
          const first = !seen.has(t.id); seen.add(t.id);
          // The shared link opens the filer's own page at this row (their page keeps the row
          // longest); under-review rows are not offered for sharing.
          const home = pp ?? (s ? securityPath(s) : here);
          const line = t.isPublished ? tradeSentence({ name: p?.name ?? null, side: t.side, amount: amountLabel(t), what: s?.ticker ?? assetLabel(t.assetType), txnDate: t.txnDate, disclosedAt: t.disclosedAt, lagDays: t.lagDays }) : null;
          return (
            <tr class={!t.isPublished ? "review" : undefined} id={first ? `t${t.id}` : undefined}>
              {showPerson && <td data-v={p?.name ?? ""}>{p ? (pp ? <a href={pp}>{p.name}</a> : p.name) : "—"}</td>}
              {showSecurity && <td class="mono" data-v={s?.ticker ?? ""}>{s ? <a href={securityPath(s)}>{s.ticker}</a> : <span class="soft">{assetLabel(t.assetType)}</span>}</td>}
              <td class={`side ${t.side}`}>{sideLabel(t)}{t.code && t.source === "sec_form4" ? <span class="code"> {t.code}</span> : null}</td>
              <td class="mono" data-v={dayKey(t.txnDate)}>{short(t.txnDate)}</td>
              <td class="mono" data-v={dayKey(t.disclosedAt)}>{short(t.disclosedAt)}</td>
              <td class="num" data-v={numKey(t.lagDays)}>{t.lagDays == null ? "—" : `${t.lagDays}d`}</td>
              <td class="num" data-v={numKey(t.shares)}>{t.shares != null ? num(t.shares) : "—"}</td>
              <td class="num" data-v={numKey(t.price != null && t.price > 0 ? t.price : null)}>{t.price != null && t.price > 0 ? money(t.price, { compact: false }) : "—"}</td>
              {showHoldings && <td class="num" data-v={numKey(t.ownedAfter)}>{t.ownedAfter != null ? num(t.ownedAfter) : "—"}</td>}
              {showHoldings && <td class={`num ${changeClass(t.holdingsChange)}`} data-v={numKey(changeSortKey(t.holdingsChange ?? null))}>{changeLabel(t.holdingsChange ?? null)}</td>}
              <td class="num strong" data-v={valueKey(t)}>{amountLabel(t)}</td>
              <td class="flags">{flags(t).map((f) => { const to = flagHref(f, t.source); const cls = `flag ${f.replace(/\W+/g, "-")}`; return to ? <a class={cls} href={to} title="What this flag means">{f}</a> : <span class={cls}>{f}</span>; })}{noteCount(t) > 0 && <a class="flag notes" href={`#${notesAnchor(t.filingId)}`} data-notes title="Footnotes in this filing">{notesLabel(noteCount(t))}</a>}</td>
              <td>{href ? <a href={href} rel="noopener nofollow" target="_blank">{sourceLabel(t)} ↗</a> : sourceLabel(t)}</td>
              <td class="rs">{line && <button type="button" class="row-share" data-share="trade" data-share-text={line} data-share-path={home !== here ? home : undefined} data-share-id={`t${t.id}`} data-share-date={(t.disclosedAt ?? "").slice(0, 10) || undefined} aria-label="Share or cite this trade"></button>}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    {txns.length > rows.length && <p class="soft small">Showing the {rows.length} most recent of {num(txns.length)}.</p>}
  </div>
  {noteBlocks.length > 0 && (
    <details class="fnotes" data-fnotes>
      <summary>Footnotes from the filings <span>{num(noteBlocks.length)} {noteBlocks.length === 1 ? "filing" : "filings"} in this table</span></summary>
      <p class="soft small">The text is as filed with the SEC. A footnote belongs to its filing, and often to one row or one box of it: the filing shows which.</p>
      {noteBlocks.map((b) => {
        const h = noteHead(b.filingId);
        return (
          <section class="fnote" id={notesAnchor(b.filingId)} tabindex="-1">
            <p class="fnote-h">{h.name}{h.filed && <span class="soft">, filed {h.filed}</span>}{h.href && <> <a href={h.href} rel="noopener nofollow" target="_blank">Form 4 ↗</a></>}</p>
            <ol>{b.notes.map((n) => <li>{n}</li>)}</ol>
            {b.more > 0 && <p class="soft small">{num(b.more)} more {b.more === 1 ? "footnote" : "footnotes"} in the filing.</p>}
          </section>
        );
      })}
    </details>
  )}
  </>
)}
