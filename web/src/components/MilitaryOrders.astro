---
// "Military parts orders" on company and stock pages (lib/dla.ts has the rules, lib/dla-build.ts the read).
// Orders the Defense Logistics Agency posted on DIBBS in the last 12 months for supplier codes matched
// to this company, read at build time from nsnexplorer.com's database. Renders nothing without orders.
// Panel shape from design/system.md section 8: headline figures and one small chart, then two tables
// previewed at 5 rows, each opening in place.
import type { Flagship } from "../lib/flagship";
import { money, num, plural } from "../lib/flagship";
import { formatDate } from "../lib/format";
import { columnsSvg, PHONE_W } from "../lib/viz";
import { dashedNsn, nsnUrl, supplierUrl, itemText, RULE_TEXT, DLA_CAVEAT, NSN_SITE } from "../lib/dla";
import PanelFigs from "./PanelFigs.astro";

interface Props { model: Flagship; companyId: number; name: string }
const { model, companyId, name } = Astro.props;
const d = model.dla.byCompany.get(companyId);
const day = (s: string) => s.replaceAll("-", "");
const chart = d ? columnsSvg(d.months.map((x) => ({ label: x.label.slice(0, 3), value: x.value })), `${name}: Defense Logistics Agency order value by month, ${d.months[0]!.label} to ${d.months[11]!.label}`, PHONE_W) : "";
const supplierWord = d && d.suppliers.length === 1 ? "one supplier code" : `${num(d?.suppliers.length ?? 0)} supplier codes`;
---
{d && (
  <section class="panel" data-panel aria-labelledby="parts-orders" data-dla data-company={companyId} data-orders={d.orders} data-value={Math.round(d.value)} data-parts={d.parts} data-cages={d.suppliers.map((s) => s.cage).join(",")} data-first={d.first} data-last={d.last}>
    <h2 id="parts-orders">Military parts orders (Defense Logistics Agency, last 12 months)</h2>
    <PanelFigs items={[{ v: num(d.orders), k: "orders" }, { v: money(d.value), k: "order value" }, { v: num(d.parts), k: d.parts === 1 ? "part ordered" : "different parts" }]} />
    <p data-dla-summary>The Defense Logistics Agency placed {plural(d.orders, "order")} worth {money(d.value, { compact: false })} with {supplierWord} matched to {name} between {formatDate(d.first)} and {formatDate(d.last)}, for {plural(d.parts, "different part")}.</p>
    {chart && <figure class="dla-chart" data-dla-chart><div set:html={chart} /><figcaption>Order value by month of the order, last 12 months.</figcaption></figure>}

    <h3 id="parts-orders-items">Parts ordered most</h3>
    <div class="tablewrap"><table class="data" data-sortable data-dla-parts><thead><tr>
      <th aria-sort="none" data-type="text"><button type="button" class="sort" aria-label="Sort by part">Part, as named by DLA<span class="arr" aria-hidden="true"></span></button></th>
      <th>NSN</th>
      <th class="num" aria-sort="none" data-type="num"><button type="button" class="sort" aria-label="Sort by orders">Orders<span class="arr" aria-hidden="true"></span></button></th>
      <th class="num" aria-sort="descending" data-type="num"><button type="button" class="sort" aria-label="Sort by order value">Order value<span class="arr" aria-hidden="true"></span></button></th>
      <th aria-sort="none" data-type="num" data-col="more"><button type="button" class="sort" aria-label="Sort by latest order">Latest order<span class="arr" aria-hidden="true"></span></button></th>
    </tr></thead><tbody>
      {d.topParts.map((p) => (
        <tr data-nsn={p.nsn}>
          <td class="wrap dla-item" data-v={itemText(p.item).toLowerCase()}>{itemText(p.item)}</td>
          <td class="mono"><a href={nsnUrl(p.nsn)} rel="noopener" target="_blank">{dashedNsn(p.nsn)} ↗</a></td>
          <td class="num" data-v={p.orders}>{num(p.orders)}</td>
          <td class="num" data-v={Math.round(p.value)}>{money(p.value, { compact: false })}</td>
          <td class="mono" data-v={day(p.last)} data-col="more">{formatDate(p.last)}</td>
        </tr>
      ))}
    </tbody></table></div>
    {d.parts > d.topParts.length && <p class="dla-note">The {d.topParts.length} parts with the most order value of {num(d.parts)} are listed.</p>}

    <h3 id="parts-orders-latest">Latest orders</h3>
    <div class="tablewrap"><table class="data" data-sortable data-dla-latest><thead><tr>
      <th aria-sort="descending" data-type="num"><button type="button" class="sort" aria-label="Sort by date">Date<span class="arr" aria-hidden="true"></span></button></th>
      <th aria-sort="none" data-type="text"><button type="button" class="sort" aria-label="Sort by part">Part<span class="arr" aria-hidden="true"></span></button></th>
      <th class="num" aria-sort="none" data-type="num"><button type="button" class="sort" aria-label="Sort by value">Value<span class="arr" aria-hidden="true"></span></button></th>
      <th data-col="more">Order number</th>
      <th data-col="more">Supplier code</th>
      <th>Source</th>
    </tr></thead><tbody>
      {d.latest.map((r) => (
        <tr data-piid={r.piid ?? ""}>
          <td class="mono" data-v={day(r.date)}>{formatDate(r.date)}</td>
          <td class="wrap dla-item" data-v={itemText(r.item).toLowerCase()}><a href={nsnUrl(r.nsn)} rel="noopener" target="_blank">{itemText(r.item)}</a><span class="dla-sub mono">{dashedNsn(r.nsn)}</span></td>
          <td class="num" data-v={Math.round(r.value)}>{money(r.value, { compact: false })}</td>
          <td class="mono" data-col="more">{r.piid ?? "—"}</td>
          <td class="mono" data-col="more"><a href={supplierUrl(r.cage)} rel="noopener" target="_blank">{r.cage}</a></td>
          <td>{r.url ? <a href={r.url} rel="noopener nofollow" target="_blank">DIBBS ↗</a> : "—"}</td>
        </tr>
      ))}
    </tbody></table></div>

    <p class="dla-note" data-dla-suppliers>Supplier {d.suppliers.length === 1 ? "code" : "codes"} (CAGE) counted here: {d.suppliers.map((s, i) => (
      <>{i > 0 && "; "}<a href={supplierUrl(s.cage)} rel="noopener" target="_blank">{s.cage}</a> {s.name} ({RULE_TEXT[s.rule]}, {plural(s.orders, "order")})</>
    ))}.</p>
    <p class="dla-note" data-dla-caveat>{DLA_CAVEAT} Parts and suppliers open on <a href={NSN_SITE} rel="noopener" target="_blank">NSN Explorer</a>, which publishes these records daily. <a href="/methodology/#parts-orders">How orders are counted and matched</a>.</p>
  </section>
)}
<style>
  .dla-note { color: var(--ink-soft); font-size: var(--t-sm); max-width: 80ch; }
  .dla-sub { display: block; font-size: var(--t-xs); color: var(--ink-soft); line-height: 1.2; margin-top: var(--s-1); }
  td.dla-item { min-width: 12rem; max-width: 20rem; }
  /* the small-chart rule (design/system.md 8): at most 180px tall; columnsSvg is 360 x 204 */
  .dla-chart { margin: var(--s-3) 0 var(--s-4); max-width: 310px; }
  .dla-chart figcaption { font-size: var(--t-xs); color: var(--ink-soft); }
  .dla-chart svg { width: 100%; height: auto; }
</style>
