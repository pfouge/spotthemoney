---
// /markets/largest-stock-exchanges/ — the dollar size of the world's major stock markets, as two
// bar charts: every market above US$1 trillion by exchange, and the United States against the
// Commonwealth, China and the European Union. Every figure comes from lib/worldmarkets.ts (typed
// in from one World Federation of Exchanges table, plus London from the London Stock Exchange's
// own factsheet); nothing on this page is a typed-in total. The site's first page that is not
// U.S. disclosure or Treasury data, hence the caveats block: exchanges are not countries.
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import Crumbs from "../../components/Crumbs.astro";
import JsonLd from "../../components/JsonLd.astro";
import Answer from "../../components/Answer.astro";
import Viz from "../../components/Viz.astro";
import DownloadCsv from "../../components/DownloadCsv.astro";
import { getDownloads } from "../../lib/downloads";
import { datasetLd } from "../../lib/seo";
import { formatDate } from "../../lib/format";
import { flagSrc } from "../../lib/flags";
import { rankBarsSvg, PHONE_W, WIDE_W, type RankRow } from "../../lib/viz";
import {
  WFE, LSE, LONDON, MARKETS_PATH, LARGEST_MARKETS, BLOCS, EU_EXCHANGES, CHINA_EXCHANGES, COMMONWEALTH_EXCHANGES,
  COMMONWEALTH_NOT_IN_TABLE, NOT_IN_TABLE, HONG_KONG_EXCHANGE, CHINA_OTC, BSE_INDIA,
  US_MILLIONS, EU_MILLIONS, CHINA_MILLIONS, COMMONWEALTH_MILLIONS,
  US_EU_MULTIPLE, US_CHINA_MULTIPLE, US_COMMONWEALTH_MULTIPLE, US_EU_GAP_MILLIONS,
  barMillions, barSource, trillions, millions,
} from "../../lib/worldmarkets";

const asOf = WFE.asOfLabel;
const top = LARGEST_MARKETS[0], second = LARGEST_MARKETS[1], last = LARGEST_MARKETS[LARGEST_MARKETS.length - 1];
const x = (n: number) => `${n.toFixed(1)}x`;
const multiple = x(US_EU_MULTIPLE), chinaMultiple = x(US_CHINA_MULTIPLE), cwMultiple = x(US_COMMONWEALTH_MULTIPLE);
const chinaNames = CHINA_EXCHANGES.map((e) => e.short ?? e.label).join(" and ");
const londonRank = LARGEST_MARKETS.findIndex((b) => barSource(b) === "lse") + 1;
const ordinal = (n: number) => `${n}${n % 100 >= 11 && n % 100 <= 13 ? "th" : (["th", "st", "nd", "rd"][n % 10] ?? "th")}`;
const gbp = (m: number) => `£${(m / 1e6).toFixed(2)} trillion`;
const CREDIT = "Analysis: Investing Intelligence Foundation. Data: World Federation of Exchanges; London Stock Exchange for the United Kingdom.";

// Chart 1: one bar per market, the United States stacked from its two exchanges.
const SEGMENT = [{ cls: "v-c2", on: "v-on" }, { cls: "v-c2s", on: "v-on2" }];
const rankRows: RankRow[] = LARGEST_MARKETS.map((b) => ({
  label: b.label, short: b.short, value: barMillions(b), valueLabel: trillions(barMillions(b)), flag: flagSrc(b.flag), cls: "v-c2",
  segments: b.parts.length > 1 ? b.parts.map((p, i) => ({ label: p.label, value: p.usdMillions, valueLabel: trillions(p.usdMillions), ...SEGMENT[i % SEGMENT.length] })) : undefined,
}));
const rankLabel = `Domestic market capitalization of the ${LARGEST_MARKETS.length} largest stock markets by exchange, US$ trillions, ${asOf}`;
const rankLegend = top.parts.map((p, i): [string, string] => [SEGMENT[i % SEGMENT.length].cls, `${p.label} ${trillions(p.usdMillions)}`]);

// Chart 2: the blocs, largest first, to one decimal. Colour follows the market, not its rank.
// A group with no flag of its own (the Commonwealth) gets a plain tile in its bar's colour with its initials,
// so the row lines up with the others. It is our own marker, not the Commonwealth's emblem.
const tile = (cls: string, text: string) => `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 480"><rect width="640" height="480" class="${cls}"/><text x="320" y="335" text-anchor="middle" class="v-on" style="font-size:270px;font-weight:700">${text}</text></svg>`;
const pairRows: RankRow[] = BLOCS.map((b) => ({ label: b.label, value: b.usdMillions, valueLabel: trillions(b.usdMillions, 1), flag: b.flag ? flagSrc(b.flag) : tile(b.cls, "CW"), cls: b.cls }));
const blocNames = BLOCS.map((b) => b.label);
const blocList = `${blocNames.slice(0, -1).join(", ")} and ${blocNames[blocNames.length - 1]}`;
const pairLabel = `Stock market size, ${blocList}, US$ trillions, ${asOf}`;

const tiles = [
  { k: "U.S. multiple of the EU", v: multiple, d: `${trillions(US_MILLIONS, 1)} against ${trillions(EU_MILLIONS, 1)}, ${asOf}` },
  { k: "U.S. multiple of China", v: chinaMultiple, d: `${trillions(US_MILLIONS, 1)} against ${trillions(CHINA_MILLIONS, 1)}, ${asOf}` },
  { k: "U.S. multiple of the Commonwealth", v: cwMultiple, d: `${trillions(US_MILLIONS, 1)} against ${trillions(COMMONWEALTH_MILLIONS, 1)}, ${asOf}` },
  { k: "U.S. gap to the EU", v: trillions(US_EU_GAP_MILLIONS, 1), d: `United States minus European Union, ${asOf}` },
];

const csv = (await getDownloads()).files.find((f) => f.name === "world-stock-markets.csv");
const answer = `In ${asOf} the two main U.S. stock exchanges, ${top.parts.map((p) => p.label).join(" and ")}, held ${trillions(US_MILLIONS)} of listed company value between them. That is ${cwMultiple} the ${trillions(COMMONWEALTH_MILLIONS, 1)} listed in Commonwealth countries, ${chinaMultiple} the ${trillions(CHINA_MILLIONS, 1)} listed in mainland China and ${multiple} the ${trillions(EU_MILLIONS, 1)} listed on the ${EU_EXCHANGES.length} exchanges based in the European Union.`;
const description = [
  `The world's largest stock markets by market cap, ${asOf}: Nasdaq and NYSE hold ${trillions(US_MILLIONS)}, ${multiple} the European Union's exchanges. Chart, table, CSV.`,
  `The world's largest stock markets by market cap in ${asOf}, and the United States against the EU, China and the Commonwealth. Chart, table and CSV.`,
];
---
<BaseLayout section="Markets" title={["Largest Stock Exchanges in the World by Market Cap", "Largest Stock Exchanges by Market Cap"]} description={description} modified={WFE.retrieved}>
  <Crumbs crumbs={[{ name: "Home", path: "/" }, { name: "Largest stock exchanges", path: MARKETS_PATH }]} />
  <p class="eyebrow">Markets</p>
  <h1>The world's largest stock markets</h1>
  <p class="lede">The dollar value of the companies listed on each major stock exchange in {asOf}, and how the United States compares with the Commonwealth, China and the European Union.</p>
  <Answer text={answer} updated={WFE.retrieved} sourceNote={`Sources: ${WFE.name}; ${LSE.name} for the United Kingdom. Figures for ${asOf}`} />

  <div class="viz-grid">
    <Viz wide mid id="largest-stock-markets" title={`The world's largest stock markets, ${asOf}`}
      question="How big is each major stock market, in U.S. dollars?"
      svg={rankBarsSvg(rankRows, rankLabel, WIDE_W)} svgNarrow={rankBarsSvg(rankRows, rankLabel, 640)} svgPhone={rankBarsSvg(rankRows, rankLabel, PHONE_W)}
      legend={rankLegend}
      summary={`Domestic market capitalization by exchange in US$ trillions, ${asOf}: the United States (Nasdaq plus NYSE) is first at ${trillions(barMillions(top))}, the ${second.label} second at ${trillions(barMillions(second))}, London is ${ordinal(londonRank)} at ${trillions(LONDON.usdMillions)} on the London Stock Exchange's own figures, and ${last.label} is the smallest of the ${LARGEST_MARKETS.length} shown at ${trillions(barMillions(last))}.`}>
      <p class="mk-credit">{CREDIT}</p>
    </Viz>
  </div>

  <h2 id="us-vs-eu">United States, Commonwealth, China and European Union</h2>
  <div class="viz-tiles mk-tiles">
    {tiles.map((t) => <div class="viz-tile"><div class="k">{t.k}</div><div class="v">{t.v}</div><div class="d">{t.d}</div></div>)}
  </div>
  <div class="viz-grid">
    <Viz wide mid id="united-states-and-blocs" title={`United States, Commonwealth, China and European Union, ${asOf}`}
      question="How much larger is the U.S. stock market than the Commonwealth's, China's and the European Union's?"
      svg={rankBarsSvg(pairRows, pairLabel, WIDE_W)} svgNarrow={rankBarsSvg(pairRows, pairLabel, 640)} svgPhone={rankBarsSvg(pairRows, pairLabel, PHONE_W)}
      summary={`In ${asOf} companies listed on Nasdaq and NYSE were worth ${trillions(US_MILLIONS, 1)}: ${cwMultiple} the ${trillions(COMMONWEALTH_MILLIONS, 1)} listed on ${COMMONWEALTH_EXCHANGES.length} exchanges in Commonwealth countries, ${chinaMultiple} the ${trillions(CHINA_MILLIONS, 1)} listed in mainland China (${chinaNames}) and ${multiple} the ${trillions(EU_MILLIONS, 1)} listed on the ${EU_EXCHANGES.length} exchanges based in the European Union.`}>
      <p class="mk-credit">{CREDIT}</p>
    </Viz>
  </div>

  <AdSlot label="Advertisement" />

  <h2 id="data">The numbers</h2>
  <p>All figures are domestic market capitalization for {asOf}. Every row is as the World Federation of Exchanges published it in millions of U.S. dollars, except London, which is the London Stock Exchange's own figure converted from pounds.</p>
  <DownloadCsv file={csv} note={`both charts and the exchanges behind each group, ${asOf}`} />
  <div class="tablewrap">
    <table class="data" id="table-largest">
      <caption>The world's largest stock markets by exchange, {asOf}</caption>
      <thead><tr><th scope="col" class="num">Rank</th><th scope="col">Market</th><th scope="col" class="num">US$ trillions</th><th scope="col" class="num">US$ millions</th></tr></thead>
      <tbody>
        {LARGEST_MARKETS.map((b, i) => (
          <tr>
            <td class="num">{i + 1}</td>
            <th scope="row">{b.label}{b.parts.length > 1 && <span class="mk-parts"> {b.parts.map((p) => `${p.label} ${trillions(p.usdMillions)}`).join(", ")}</span>}{barSource(b) === "lse" && <span class="mk-parts"> UK companies on the Main Market, {gbp(LSE.ukMainMarketGbpMillions)} at ${LSE.usdPerGbp} to the pound</span>}</th>
            <td class="num strong">{trillions(barMillions(b))}</td>
            <td class="num">{millions(barMillions(b))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="tablewrap">
    <table class="data" id="table-us-eu">
      <caption>{blocList}, {asOf}</caption>
      <thead><tr><th scope="col">Market</th><th scope="col">What is summed</th><th scope="col" class="num">US$ trillions</th><th scope="col" class="num">US$ millions</th></tr></thead>
      <tbody>
        {BLOCS.map((b) => <tr><th scope="row">{b.label}</th><td>{b.summed}</td><td class="num strong">{trillions(b.usdMillions, 1)}</td><td class="num">{millions(b.usdMillions)}</td></tr>)}
      </tbody>
    </table>
  </div>
  <div class="tablewrap">
    <table class="data" id="table-commonwealth">
      <caption>The {COMMONWEALTH_EXCHANGES.length} exchanges summed into the Commonwealth figure, {asOf}</caption>
      <thead><tr><th scope="col" class="num">Rank</th><th scope="col">Exchange</th><th scope="col" class="num">US$ millions</th></tr></thead>
      <tbody>
        {COMMONWEALTH_EXCHANGES.map((e, i) => <tr><td class="num">{i + 1}</td><th scope="row">{e.label}</th><td class="num">{millions(e.usdMillions)}</td></tr>)}
        <tr><td></td><th scope="row">Total</th><td class="num strong">{millions(COMMONWEALTH_MILLIONS)}</td></tr>
      </tbody>
    </table>
  </div>
  <div class="tablewrap">
    <table class="data" id="table-eu">
      <caption>The {EU_EXCHANGES.length} EU-based exchanges summed into the European Union figure, {asOf}</caption>
      <thead><tr><th scope="col" class="num">Rank</th><th scope="col">Exchange</th><th scope="col" class="num">US$ millions</th></tr></thead>
      <tbody>
        {EU_EXCHANGES.map((e, i) => <tr><td class="num">{i + 1}</td><th scope="row">{e.label}</th><td class="num">{millions(e.usdMillions)}</td></tr>)}
        <tr><td></td><th scope="row">Total</th><td class="num strong">{millions(EU_MILLIONS)}</td></tr>
      </tbody>
    </table>
  </div>

  <div class="prose">
  <h2 id="how-to-read">How to read this</h2>
  <ul>
    <li><strong>These are exchanges, not countries.</strong> Each bar is the value of the domestic companies listed on one exchange or exchange group. The United States bar adds together its two main exchanges, Nasdaq ({trillions(top.parts[0].usdMillions)}) and NYSE ({trillions(top.parts[1].usdMillions)}), in {asOf}.</li>
    <li><strong>London comes from a different source.</strong> The London Stock Exchange is not in the World Federation of Exchanges table. Its bar is the exchange's own figure for UK companies on its Main Market at the end of {asOf}, {gbp(LSE.ukMainMarketGbpMillions)} for {LSE.ukMainMarketCompanies} companies, converted at ${LSE.usdPerGbp} to the pound (the {LSE.rateSource} for {formatDate(LSE.rateDate)}). That gives {trillions(LONDON.usdMillions)}. It is counted by a different publisher, so treat London's rank as approximate. Companies on AIM, London's market for smaller companies ({gbp(LSE.aimGbpMillions)} in all), are not included because the exchange does not split that figure between UK and foreign companies.</li>
    {NOT_IN_TABLE.map((m) => <li><strong>Brazil is absent, not zero.</strong> {m.label} has no row in the table for {asOf}, so it has no bar. It was last reported at {trillions(m.last.usdMillions)}, for {m.last.asOfLabel}.</li>)}
    <li><strong>India is shown once.</strong> NSE India is on the chart. BSE India ({trillions(BSE_INDIA.usdMillions)} in {asOf}) lists largely the same companies, so it is left out to avoid counting them twice.</li>
    <li><strong>China means mainland China.</strong> The China bar adds the Shanghai and Shenzhen exchanges ({trillions(CHINA_MILLIONS, 1)} in {asOf}), the same figures as their bars in the first chart. Hong Kong is a separate market with its own bar ({trillions(HONG_KONG_EXCHANGE.usdMillions)}) and is not included; with it the figure would be {trillions(CHINA_MILLIONS + HONG_KONG_EXCHANGE.usdMillions, 1)}. Many mainland companies are listed in Hong Kong, and some in both places. A small over-the-counter market for mainland companies ({trillions(CHINA_OTC.usdMillions)}) is also left out.</li>
    <li><strong>The Commonwealth bar is a sum made for this page.</strong> It adds the {COMMONWEALTH_EXCHANGES.length} exchanges based in member countries of the Commonwealth of Nations that have a figure for {asOf}: Canada, India, the United Kingdom, Australia, South Africa, Singapore, Malaysia and {COMMONWEALTH_EXCHANGES.length - 8} smaller markets, listed in the table above. London's part is the London Stock Exchange figure described above; the rest is from the World Federation of Exchanges. Member countries with no exchange in the table are missing, and so are {COMMONWEALTH_NOT_IN_TABLE.join(" and ")}, which have no row for {asOf}. Cyprus and Malta belong to both the Commonwealth and the European Union and are counted in both bars. The "CW" tile beside the bar is this site's own marker, not the Commonwealth's flag.</li>
    <li><strong>The European Union total is slightly too high.</strong> Euronext includes the Oslo exchange and Nasdaq Nordic and Baltics includes Iceland. Norway and Iceland are outside the EU, and the source does not report them separately. Nasdaq Nordic and Baltics carries Sweden's flag because it is based in Stockholm, and Euronext carries the EU flag because it runs exchanges in several countries.</li>
    <li><strong>The figures are several weeks old when published.</strong> The World Federation of Exchanges releases each month's table in the following weeks. Everything on this page is for {asOf} and was read from the sources on {formatDate(WFE.retrieved)}. Market values move every trading day.</li>
  </ul>
  <h2 id="where-from">Where the data comes from</h2>
  <p>Every figure except London's is from the <a href={WFE.url} rel="noopener">{WFE.name}, {WFE.publication}, {WFE.issue} issue</a>, table "{WFE.table}", {asOf} column, shown as published. London's is from the <a href={LSE.url} rel="noopener">{LSE.name}'s {LSE.publication}</a>, converted with the <a href={LSE.rateUrl} rel="noopener">{LSE.rateSource}</a>. The totals, the multiples and the gap are worked out from those figures on this page, and the <a href="/methodology/">methodology page</a> covers how the rest of this site handles its sources.</p>
  </div>
  <p class="disclaimer"><strong>Not investment advice.</strong> World Federation of Exchanges and London Stock Exchange statistics for {asOf}.</p>

  <JsonLd data={datasetLd({
    downloads: [csv?.path], name: `Largest stock exchanges in the world by domestic market capitalization, ${asOf}`, path: MARKETS_PATH,
    description: `Domestic market capitalization of the world's ${LARGEST_MARKETS.length} largest stock markets by exchange in U.S. dollars for ${asOf}, and the United States total against the Commonwealth, mainland China and the ${EU_EXCHANGES.length} exchanges based in the European Union.`,
    dateModified: WFE.retrieved, temporalCoverage: WFE.asOf,
    keywords: ["stock exchanges", "market capitalization", "world stock markets", "Nasdaq", "NYSE", "London Stock Exchange", "European Union", "China", "Commonwealth"],
    sources: [{ name: `${WFE.name}: ${WFE.publication}, ${WFE.issue}`, url: WFE.url }, { name: `${LSE.name}: ${LSE.publication}`, url: LSE.url }],
  })} />
</BaseLayout>

<style>
  @media (max-width: 560px) { .mk-tiles { grid-template-columns: 1fr; } }
  .mk-credit { margin: 0.7rem 0 0; color: var(--ink-soft); font-size: 12.5px; }
  .mk-parts { display: block; font-weight: 400; color: var(--ink-soft); font-size: 13px; }
  .tablewrap + .tablewrap { margin-top: 1.75rem; }
</style>
