---
// /methodology/ — how every figure on the site is produced. Linked from every entity page,
// the flags, the X thread and llms.txt. Sections are stable anchors (#sources, #lag, …).
import { instHubShown } from "../lib/inst13f-hub";
import { plannedShown } from "../lib/plannedsales-build";
import { largeShown } from "../lib/largeholders-build";
import { INST_TOP, INST_MIN_MANAGERS, INST_SHOWN_DAYS } from "../lib/inst13f";
import { DESCRIPTION_SHOWN } from "../lib/contracts";
import { ASSISTANCE_WINDOW_DAYS } from "../lib/assistance";
import { shareText } from "../lib/lobbygifts";
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import JsonLd from "../components/JsonLd.astro";
import { getFlagship, CONGRESS_DEADLINE_DAYS, num } from "../lib/flagship";
import { MAX_SAVED } from "../lib/savedscreens";
import { SITE_URL, SOURCES } from "../lib/seo";
import { FORM4_FLOOR } from "@stm/shared";
import { formatDate } from "../lib/format";
import { RECORD_START, FIRST_MIN_DAYS, RUN_MIN, firstEligibleFrom } from "../lib/tickerhistory";
import Answer from "../components/Answer.astro";
import { FEED_CAPS, CLUSTER_MIN_INSIDERS, CLUSTER_DAYS, STAKE_MIN_PCT, STAKE_MIN_VALUE, LARGE_SALE_MIN, CONGRESS_MIN_LOW, CLUSTER_SELL_MIN_INSIDERS, CLUSTER_SELL_MIN_VALUE, CLUSTER_SELL_MIN_PCT } from "../lib/notable";
import { getCoverage, filingMonths, latestStat } from "../lib/coverage";
import { form144Sentence, schedule13Sentence, catchingUp, CAUGHT_UP_DAYS } from "../lib/coverage-stored";
import { NOTICE_ROWS, VALUE_MAX_PER_SHARE } from "../lib/form144";
import { HOLDER_ROWS, THRESHOLD_PERCENT, RECORD_START_LABEL } from "../lib/schedule13";
import { EVENT_ROWS, EVENT_WINDOW_DAYS } from "../lib/events8k";
import { PAY_YEARS, PAY_LARGE, PAY_SMALL } from "../lib/execpay";
import { QUARTER_DAYS, YEAR_DAYS, YEARS_SHOWN, QUARTERS_SHOWN, MIN_IMPLIED_SHARES, MAX_EPS_WITHOUT_INCOME, BALANCE_TOLERANCE, RATIOS, RATIO_HEAD } from "../lib/financials";

const model = await getFlagship();
const cov = await getCoverage();
const house = filingMonths(cov, "house_ptr", 13).reverse();
const sum = (xs: number[]) => xs.reduce((a, b) => a + b, 0);
const thisYear = new Date().getUTCFullYear();
const houseYear = cov.filings.filter((f) => f.source === "house_ptr" && f.month.startsWith(String(thisYear)));
const houseIndex = latestStat(cov, "house_ptr", `index_ptrs_${thisYear}`);
// Form 4 filings filed before the floor are in the database but not shown (shared/src/floor.ts),
// so the count here leaves them out too: it once read "filed 2003-04 onward".
const form4 = cov.filings.filter((f) => f.source === "sec_form4" && (f.month === "none" || f.month >= FORM4_FLOOR.slice(0, 7)));
const form4FloorText = new Date(FORM4_FLOOR + "T00:00:00Z").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const senate = cov.filings.filter((f) => f.source === "senate_ptr");
const stored = cov.storedNotShown;
const planned = form144Sentence(stored.form144, cov.builtAt);
const holders = schedule13Sentence(stored.schedule13, cov.builtAt);
const span = (rows: { month: string; rows: number }[] | undefined) => { const r = (rows ?? []).filter((x) => x.month !== "none"); return r.length ? `${num(sum(r.map((x) => x.rows)))} rows, ${r[0]!.month} to ${r[r.length - 1]!.month}` : "none on file"; };
const monthLabel = (m: string) => new Date(`${m}-01T00:00:00Z`).toLocaleString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
const description = "How Spot the Money collects, filters and presents public disclosures: sources, update cadence, the publishing bar, late-filer rules and flag definitions.";
const ld = { "@context": "https://schema.org", "@type": "WebPage", "@id": `${SITE_URL}/methodology/#page`, name: "Methodology", url: `${SITE_URL}/methodology/`, description, dateModified: model.builtAt.slice(0, 10), isPartOf: { "@type": "WebSite", name: "Spot the Money", url: `${SITE_URL}/` } };
import { MAX_NOTES_PER_FILING } from "../lib/footnotes";
import { RECENT_DAYS as FS_RECENT_DAYS } from "../lib/finscreen";
import { VOTE_ROWS, VOTES_WINDOW_DAYS, MEMBER_QUESTION_MAX } from "../lib/votes";
import { COUNT_RULE, OUTSIDE_ROWS, CANDIDATE_MIN_ROWS, DESCRIPTION_SHOWN as OS_DESC } from "../lib/outsidespending";
---
<BaseLayout title="Methodology: how the numbers are made | Spot the Money" description={description} section="Methodology">
  <Crumbs crumbs={[{ name: "Home", path: "/" }, { name: "Methodology", path: "/methodology/" }]} />
  <p class="eyebrow">About <span class="x">/</span> Methodology</p>
  <h1>How the numbers are made</h1>
  <p class="lede">Every figure on this site is a public record, shown as filed, with the rule that produced it written down here. Site built {formatDate(model.builtAt)}.</p>
  <Answer text={`Spot the Money shows public U.S. government records as filed: SEC Form 4 insider trades, House STOCK Act trade reports, FEC contributions, Senate lobbying filings, USAspending contracts and Treasury rates, read once a day from the official sources. A transaction is shown only if its filing parsed cleanly, congressional trades count as late after ${CONGRESS_DEADLINE_DAYS} days, and every row links to its source filing.`} updated={model.builtAt} sourceNote="Rules below apply to every page" />

  <h2 id="sources">Sources and cadence</h2>
  <p>We read only official primary sources, once a day, with a client that identifies this site and its contact address on every request and never exceeds one request every 1.5 seconds per host:</p>
  <ul>
    <li><a href={SOURCES.edgar.url}>SEC EDGAR</a>: Form 4 ownership filings (XML) for a tracked set of about 70 large or frequently traded U.S. tickers plus every ticker that appears in a congressional filing. The record starts with filings made on or after {form4FloorText}; a few hundred older filings are stored but not shown, because a handful of rows from an earlier year would read as that whole year. Amendments (Form 4/A) are not merged into the original.</li>
    <li><a href={SOURCES.house.url}>U.S. House Clerk</a>: periodic transaction reports (PTRs) as PDFs, parsed daily. Scanned PDFs without a text layer are held for human review and show no rows until then.</li>
    <li><a href={SOURCES.senate.url}>U.S. Senate eFD</a>: periodic transaction reports. The Senate's site refuses automated readers, and this site does not disguise its crawler as a browser. Senate reports are instead read in an ordinary browser session by a person, saved, and loaded from those saved copies, so they arrive in batches rather than daily{senate.length ? "" : "; none has been loaded yet"}. Reports filed on paper are scans and are held for transcription like the House ones.</li>
    <li><a href={SOURCES.fec.url}>FEC (OpenFEC)</a>: itemized contributions (Schedule A) to the principal campaign committee of every current member of Congress and the 200 largest PACs by receipts in the current cycle, last 90 days.</li>
    <li><a href={SOURCES.lda.url}>Senate Lobbying Disclosure Act filings</a>: quarterly registrations and reports, every filing posted since October 1, 2025; an amended report replaces the one it amends.</li>
    <li><a href={SOURCES.usaspending.url}>USAspending</a>: the largest contract awards that started in each of the last six months, plus awards to followed companies (exact recipient-name match); dated by award start date, valued at total award amount. <span id="contract-details">Each award also shows the awarding sub-agency, the date the work is currently due to end and the description the agency entered, all as USAspending reports them; a description is cut at {DESCRIPTION_SHOWN} characters in tables and given in full in the CSV file, and nothing is worked out from it. The sub-agency table on the contracts page counts only awards that carry a sub-agency and says how many do.</span> <span id="contract-naics">The industry code on an award is its NAICS code as USAspending reports it: the code the contracting office gave the work being bought, which is not the recipient company's own industry and is not the SEC's industry code shown on company pages. The title beside a code is the Census Bureau's title for it in the 2022 edition of the classification; for a code the 2022 edition no longer uses, the title is from the last edition that had it (2017, 2012 or 2007) and is followed by that year. A code in none of those editions is shown without a title. The table of industry codes on the contracts page adds up award values per code; nothing else is worked out from a code.</span></li>
    <li><a href={SOURCES.treasury.url}>U.S. Treasury</a>: the daily par yield curve and the daily real (TIPS) yield curve; <a href={SOURCES.fiscaldata.url}>Treasury Fiscal Data</a>: I-Bond rates; <a href={SOURCES.bls.url}>BLS</a>: CPI-U, the input to the I-Bond variable rate.</li>
  </ul>

  <h2 id="publishing-bar">The publishing bar</h2>
  <p>A row is shown only if its filing parsed cleanly (review approved, confidence at least 0.9). Rows from a source whose first sample has not yet been checked by an editor are shown with an "under review" note on the page and are excluded from the data feed and from the daily social thread until the check is complete. Nothing is inferred, filled in or estimated: a blank cell means the filing did not state it.</p>

  <h2 id="lag">Disclosure lag and late filings</h2>
  <p>Lag is the disclosure date minus the trade date, in calendar days. Members of Congress must file within {CONGRESS_DEADLINE_DAYS} days of a trade (STOCK Act); a row is marked late when the report's filing date is later than that. Corporate insiders must file Form 4 within two business days; a row is marked late when the filing date is more than four calendar days after the trade (a conservative rule that never marks a weekend or holiday as late).</p>

  <h2 id="values">Values</h2>
  <p>For Form 4 rows, value is shares × the price reported on the filing (a weighted average when the filing says so); rows with no price, such as grants or option exercises at zero, show no value and never count as buys or sales. Options, warrants and other derivative rows are listed in the tables, marked derivative, but are left out of every buy and sell total and off the trade maps: a put bought is not a purchase of the stock, and the dollars are a premium. Where a filer typed the total for a row into the price box, the per-unit price is worked out from it. When the same trade is reported in more than one Form 4, as when funds or trusts that own a stake together each file their own, it is counted once in totals, under the first filing received. Two rows are the same trade when the stock, date, share count, price and the shares owned afterwards all match and the trade is worth $250,000 or more; the repeated rows stay in the tables, marked as also in another filing. Congressional filings report ranges, so those rows show the range as filed and any total uses the top of the range. A few House reports give an exact dollar amount in place of a range; such a row shows that one figure, rounded to the dollar. A range with no stated top ("over $50,000,000", or "over $1,000,000" for an asset held only by a spouse or dependent child) is shown as "over" that figure. Contract amounts are federal obligations on the action, which can be negative. Lobbying amounts are the income or expense reported for the quarter.</p>

  <h2 id="notable">Notable trades on the home page</h2>
  <p>The feed on the home page lists filings that meet one of five written rules. Only published rows count. A row is left out when it is a derivative, a repeat of a trade already counted from another filing, has no ticker, or has a trade date that is missing or later than its filing date. The rules say what a filing shows and nothing about why someone traded. Windows count from the date a trade was disclosed; "Today" means the newest disclosure date in the data. The feed opens on clusters over 7 days, and shows 30 days instead when no cluster was filed in the last 7.</p>
  <ul>
    <li><strong>Insider buy</strong>: a Form 4 open-market purchase (code P) that is not under a 10b5-1 plan.</li>
    <li><strong>Cluster buy</strong>: {CLUSTER_MIN_INSIDERS} or more different insiders buying the same company, with trade dates inside a {CLUSTER_DAYS}-day span and at least one of those rows disclosed in the selected window. A cluster is one item per company; its purchases still appear under "Insider buys" and are folded into the cluster under "All".</li>
    <li><strong>Cluster sell</strong>: held to a much stricter test than a cluster buy, because insiders are paid largely in stock and sell routinely. {CLUSTER_SELL_MIN_INSIDERS} or more different insiders of one company must each qualify inside one {CLUSTER_DAYS}-day span of trade dates, with at least one of the rows disclosed in the selected window. A person qualifies only when, adding up their open-market sales (code S) in the span, three things hold: none is under a 10b5-1 plan, the total is at least ${num(CLUSTER_SELL_MIN_VALUE)}, and the sales cut their own reported holding by at least {CLUSTER_SELL_MIN_PCT} percent (the largest cut in any one row; a row with no holding figure cannot show a cut). Derivative rows and repeats of another filing never count. A company can show a cluster buy and a cluster sell at the same time; each is one item, and under "All" the member sales are folded into the cluster sell item.</li>
    <li><strong>Stake change</strong>: a purchase or sale (code P or S) outside a plan that changes the filer's holding by at least {STAKE_MIN_PCT} percent, up or down, and is worth at least ${num(STAKE_MIN_VALUE)}.</li>
    <li><strong>Large sale</strong>: a sale (code S) outside a plan worth at least ${num(LARGE_SALE_MIN)}.</li>
    <li><strong>Congress</strong>: a House or Senate purchase or sale of a stock with a ticker where the reported range starts at ${num(CONGRESS_MIN_LOW)} or more.</li>
  </ul>
  <p>Insider values are shares times the filed price. Congress values are the range as filed. The feed covers every company whose insiders have filed Form 4 with the SEC since October 2025, not only the companies on the map. When a window holds more insider buys or large sales than the page can carry, the feed keeps the largest by value (up to {FEED_CAPS.buys[1]}, {FEED_CAPS.buys[7]} and {FEED_CAPS.buys[30]} buys and {FEED_CAPS.sales[1]}, {FEED_CAPS.sales[7]} and {FEED_CAPS.sales[30]} large sales for 1, 7 and 30 days) and states the true total in a line above the list. Clusters, stake changes and congressional trades are never cut. Pages for companies outside the large-company set are built when opened, not in advance.</p>

  <h2 id="flags">Flags and feeds</h2>
  <ul>
    <li><strong>Open-market buy</strong>: Form 4 transaction code P. This is the only code counted as a "buy" in ratios and feeds.</li>
    <li><strong>Cluster buy</strong>: three or more distinct insiders with code-P purchases of the same ticker within 30 days.</li>
    <li><strong>10b5-1 plan</strong>: the filer ticked the Rule 10b5-1 box on the Form 4 (available since April 2023).</li>
    <li><strong>Owner</strong>: on congressional rows: the member, spouse, dependent child or joint, as filed.</li>
    <li><strong>Late</strong>: see above. <strong>First filing</strong>: the first filing by that person in our records, which start with the launch of each source.</li>
  </ul>

  <h2 id="matching">Matching people and companies</h2>
  <p><strong>Market cap.</strong> The Market cap filter on the trade maps sorts companies into bands: mega ($200B and up), large ($10B–$200B), mid ($2B–$10B), small ($300M–$2B) and micro (under $300M). The figure behind a band is an estimate from SEC filings, not a market quote: the shares outstanding on the cover of the company's latest quarterly or annual report, multiplied by the median price of its most recent open-market insider trades. Where a company reports shares by class, or has no recent insider trade, the public float stated in its latest annual report is used instead. Funds, ETFs and foreign companies that file annual reports on Form 20-F report no public float and are left out when a market cap band is selected, as are companies whose insider filings have not been loaded yet.</p>
  <p>Insiders are identified by their SEC CIK. Members of Congress are matched by normalized name and chamber (the House index gives no stable id); a state and district come from the filing. Company pages match federal contracts and lobbying clients by exact normalized name (corporate suffixes ignored), which deliberately misses subsidiaries and alternate spellings rather than guess.</p>
  <p id="one-page"><strong>One page per company.</strong> A company with a ticker has one page, at the address of its main ticker (for example /stocks/nvda/). It holds the trades in that ticker, the company's ownership filings and financial figures, and its federal contracts and lobbying filings. An older address under /companies/ opens that page. When a company has several share classes or listings with records here (GOOGL and GOOG, a preferred share), they are on that one page, addressed by the ticker the SEC's list of company tickers gives first for the company; the address of another class opens the same page, and the page names every class it covers. A company with no ticker on this site keeps a page under /companies/. There is one list of them all, at /stocks/: every ticker page, then the companies with no ticker; the old list address /companies/ opens it. For companies outside the tracked set, whose pages hold insider filings only, the rule is the same: one page, at one ticker's address. When filings name such a company under several tickers (the symbol changed, there is a second class, or a filing states it differently), the page is at the first of them in the SEC's list of company tickers, or at the company's main ticker when the list names none; it lists the rows filed under every one of them and says which, and the other addresses open it.</p>
  <p id="ticker-owners"><strong>Which company a ticker belongs to.</strong> A stock's page names the company the SEC lists that ticker under in its <a href="https://www.sec.gov/files/company_tickers.json" rel="noopener">list of company tickers</a>, read once a day. A Form 4 names the company whose shares it reports (the issuer). When that issuer is not the company the ticker belongs to and the filing does not state that ticker as the issuer's trading symbol, the filing's rows are not counted on the ticker's stock page: they are listed on the issuer's own company page and on the filer's page, with no ticker. This mostly concerns investment funds and spin-offs that have no trading symbol of their own, whose insider filings would otherwise be filed under the symbol of the firm that manages or owns them. One case stays: a filing that states the ticker, from a company that has no ticker of its own in the SEC's list. That is an earlier registrant of the same listed stock, left behind when a merger or a new holding company moved the ticker to another SEC registrant. When the company does have another ticker of its own, the symbol has changed hands, and its filings are not counted under the symbol's new owner. Nothing in a row is changed; only where it is listed.</p>
  <p id="related-pages"><strong>Related pages and automatic links.</strong> "Related stocks" on a stock's page are the tickers traded by the same filers, ranked by the number of filers in common; "related companies" follow from the same count, and "other insiders" are the people who file for the same company. These lists describe overlap in public filings and are not a statement about any trade. A lobbying client, registrant or contract recipient is linked to a company page only when its name matches a tracked company exactly after the same normalising used above, and never when two companies share that name. In the guides, the first mention of a term that another guide explains is linked to that guide automatically.</p>
  <p id="industry"><strong>Industry.</strong> The "Industry" line on a company's page is the Standard Industrial Classification (SIC) code the SEC has assigned to the company, with the SEC's own wording for it, read from the SEC's record of the filer. The last word in the brackets is the division of the SIC manual that the code falls in, looked up from the code's first two digits. The classification is the SEC's, it dates from 1987 and its divisions are broad: software companies are in "Services", and chip makers and drug makers are both in "Manufacturing". A company the SEC lists no code for has no Industry line. The line is a label only: no total, ranking or flag on this site uses it. It links to the page for its division.</p>
  <p id="industries"><strong>Companies by industry.</strong> The <a href="/industries/">industry pages</a> list the companies on this site by the division of that SIC code, one page for each division, with the codes the companies carry. Beside each company are three counts for the 12 months up to the day the page was built: open-market purchases reported by insiders (Form 4 rows with code P), open-market sales (code S), and rows of House and Senate reports in the company's stock. A filing is counted by the day it was disclosed. Awards, option exercises, gifts, shares withheld for tax, derivative rows and a second filing of the same trade are not counted. A division's own figures count companies with at least one such row. A company with no code, or with a code that falls in no division, is on no industry page. The pages count rows and companies only: no dollar totals, no ranking of industries, and no comparison of a trade with a company's industry. One file on the <a href="/downloads/">downloads page</a>, companies.csv, lists every company with its code.</p>
  <p id="holdings"><strong>Held after and Change.</strong> On Form 4 rows, "Held after" is the number of shares the insider reports owning once the transaction is done, taken from that insider's own Form 4. "Change" is the share of the holding before the transaction that the row added or removed: the holding before is worked out from the shares held after and the row's share count, for a purchase or a sale only. A first purchase reads "new", and a sale that leaves nothing reads −100%. Derivative rows, awards, gifts and other codes, rows the filing gives no holding for, and every congressional report have neither figure and show a dash, as does a filing whose numbers do not add up. A large negative change is a fact about the holding as filed; it says nothing about why the insider traded or whether the trade was a good one. The same two figures are in the CSV files as <code>shares_owned_after</code> and <code>holdings_change_pct</code>.</p>
  <p id="insider-summary"><strong>Insider buying and selling over 3 and 12 months.</strong> Each stock's page has a table of open-market trades by that company's insiders over the last 90 days and the last 365 days, counted back from the day the page was built. It counts Form 4 rows with code P (open-market purchase) and code S (open-market sale) only: awards, option exercises, gifts, shares withheld for tax, sales back to the company and every derivative row are left out, and a trade reported in more than one filing is counted once. A row belongs to a period by the date it was disclosed, not the date of the trade, so a late filing appears when it becomes public. Dollars are shares times the price on the filing; a row with no usable price adds shares but no dollars. "Net" is bought minus sold. The line for sales under a Rule 10b5-1 plan counts sales whose filing ticks the plan box. The table covers the insiders whose filings are on this site and says nothing about why anyone traded or what the share price will do.</p>
  {model.form144.shown && <p id="form-144"><strong>Planned sales (Form 144 notices).</strong> A Form 144 is the notice a holder files with the SEC when they plan to sell restricted or control shares under Rule 144. It is a notice of a planned sale, not a report of a sale: the sale may happen later, in part or not at all. A stock's page and its company's page list the notices about that company filed in the last 365 days, counted back from the day the page was built, the {NOTICE_ROWS} newest first, for the companies this site tracks; the record starts with notices filed on or after {form4FloorText}. Every figure is the filer's own, as filed: the shares to be sold, the aggregate market value the filer states (not a price paid), the approximate sale date, the relationship to the company in the filer's words, and the date a Rule 10b5-1 plan was adopted when the notice gives one. A figure of zero is shown as a dash. One kind of mistake on the form is caught: a stated market value that works out to more than {VALUE_MAX_PER_SHARE.toLocaleString("en-US")} dollars a share cannot be right for the number of shares (for example a value typed without its decimal point), so the page prints "not shown" in its place; the figure as filed stays in the CSV file, where a column marks it, and on the notice at the SEC. No other figure is checked or changed, and a value that looks too low is left as filed. No figure from a notice is in any buy or sell total, chart, feed or trade map on this site. An amended notice (144/A) is its own row: the form does not say which notice it corrects, so nothing links the two and the section adds up nothing across rows, it counts notices and sellers only. A seller's name links to an insider's page here only when the SEC number of the notice's filer is that person's. That insider's page lists the same notices from the other side: the notices submitted under the person's SEC number in the last 365 days about companies this site tracks, with the company, the figures as filed and, in small type, the seller the notice names, which can be a trust or a family entity. Addresses, phone numbers and signatures on the form are not kept. Nothing is derived from a notice. The notices appear on pages only while the daily load is current, which means the newest notice on file was filed within the last {CAUGHT_UP_DAYS} days. All notices shown are in one CSV file on the <a href="/downloads/">downloads page</a>.{plannedShown(model) && <> The <a href="/planned-sales/">planned sales page</a> lists every notice filed in the last 365 days about a company with a page here in one table, 30 days at first, with filters for company, seller, industry, notice or amendment, a stated plan date, a stated value at least and the filing window; its count line counts notices, companies and sellers and adds up no shares or dollars, a value held back as above passes no value filter, and the table is built from the same notices, so it can only differ from the stock and company pages by covering all companies at once.</>}</p>}
  {model.schedule13.shown && <p id="schedule-13"><strong>Large holders (Schedules 13D and 13G).</strong> A Schedule 13D or 13G is the statement a person, fund or group files with the SEC after coming to own more than {THRESHOLD_PERCENT}% of a class of a company's voting shares. Schedule 13D is the long form; Schedule 13G is the short form for passive and institutional holders. A holder files again when its holding changes materially, and when it falls below {THRESHOLD_PERCENT}%. A statement says what the filer says it owned on its event date. It is not a report of a trade, and the holding may have changed since. A stock's page and its company's page list, for the companies this site tracks, each holder's newest statement on record about that company, largest stated percentage first, at most {HOLDER_ROWS} rows; the record starts with statements published from {RECORD_START_LABEL} on, so a holder whose last statement is older is not listed and the list is not a full list of shareholders. An amendment does not say which statement it replaces, so statements are matched by the SEC number of the filer and the company: the newest by that filer is shown, and its older ones are in the CSV file only. A holder that reports on two classes of one company's shares, such as Class A and Class C, has a row for each class. A class is told by the CUSIP number on the statement and by one test only: the holder's statements under the two numbers overlap in time, which means it filed under both on one day or went back to the first number after using the second. When every statement under one number was filed before every statement under another, the number is taken to have changed, as it does after a reverse split or when a company moves, and only the newest statement is shown. A holder with a statement that gives no CUSIP number is never split. The test can miss a second class that a holder reported on once and never again, and it cannot tell a mistyped number from a new one. Every figure is the filer's own, as filed. When a statement names several reporting persons, the shares and the percentage shown are the largest that any one of them states, never a sum, because members of a group each report the group's combined holding; for the same reason rows are not added together, and the section counts holders and rows only. A newest statement under {THRESHOLD_PERCENT}% stays listed and is marked "below {THRESHOLD_PERCENT}%": it is the holder's notice that it is no longer above that mark. No figure from a statement is in any buy or sell total, chart, feed or trade map on this site. A holder's name links to a page here only when the SEC number of the statement's filer belongs to exactly one person or company with a page. That page, an insider's or a company's, has a section "Large holdings this filer reports" with the same statements from the other side: the filer's newest statement about each other company this site tracks, by class of shares under the same test, largest stated percentage first. It is not a list of everything the filer owns: only holdings above {THRESHOLD_PERCENT}% of a class are reported on these schedules. The purpose a Schedule 13D states is not shown on pages and is in the CSV file as filed; nothing is derived from it. Addresses, phone numbers, signatures and the form's answers about legal proceedings are not kept. The statements appear on pages only while the daily load is current, which means the newest statement on file was filed within the last {CAUGHT_UP_DAYS} days. All statements on record for tracked companies are in one CSV file on the <a href="/downloads/">downloads page</a>.{largeShown(model) && <> The <a href="/large-holders/">large holders page</a> lists each holder's newest statement about every company with a page here in one table, with filters for company, holder, industry, schedule, the percent stated and the filing window; its count line counts holders and companies and adds up no shares or percentages, a statement with no stated percent passes no percent filter, and a row under {THRESHOLD_PERCENT}% is the holder's notice that it is no longer above the mark.</>}</p>}
  {model.form144.shown && <p id="form-144"><strong>Planned sales (Form 144 notices).</strong> A Form 144 is the notice a holder files with the SEC when they plan to sell restricted or control shares under Rule 144. It is a notice of a planned sale, not a report of a sale: the sale may happen later, in part or not at all. A stock's page and its company's page list the notices about that company filed in the last 365 days, counted back from the day the page was built, the {NOTICE_ROWS} newest first, for the companies this site tracks; the record starts with notices filed on or after {form4FloorText}. Every figure is the filer's own, as filed: the shares to be sold, the aggregate market value the filer states (not a price paid), the approximate sale date, the relationship to the company in the filer's words, and the date a Rule 10b5-1 plan was adopted when the notice gives one. A figure of zero is shown as a dash. One kind of mistake on the form is caught: a stated market value that works out to more than {VALUE_MAX_PER_SHARE.toLocaleString("en-US")} dollars a share cannot be right for the number of shares (for example a value typed without its decimal point), so the page prints "not shown" in its place; the figure as filed stays in the CSV file, where a column marks it, and on the notice at the SEC. No other figure is checked or changed, and a value that looks too low is left as filed. No figure from a notice is in any buy or sell total, chart, feed or trade map on this site. An amended notice (144/A) is its own row: the form does not say which notice it corrects, so nothing links the two and the section adds up nothing across rows, it counts notices and sellers only. A seller's name links to an insider's page here only when the SEC number of the notice's filer is that person's. That insider's page lists the same notices from the other side: the notices submitted under the person's SEC number in the last 365 days about companies this site tracks, with the company, the figures as filed and, in small type, the seller the notice names, which can be a trust or a family entity. Addresses, phone numbers and signatures on the form are not kept. Nothing is derived from a notice. The notices appear on pages only while the daily load is current, which means the newest notice on file was filed within the last {CAUGHT_UP_DAYS} days. All notices shown are in one CSV file on the <a href="/downloads/">downloads page</a>.</p>}
  {model.schedule13.shown && <p id="schedule-13"><strong>Large holders (Schedules 13D and 13G).</strong> A Schedule 13D or 13G is the statement a person, fund or group files with the SEC after coming to own more than {THRESHOLD_PERCENT}% of a class of a company's voting shares. Schedule 13D is the long form; Schedule 13G is the short form for passive and institutional holders. A holder files again when its holding changes materially, and when it falls below {THRESHOLD_PERCENT}%. A statement says what the filer says it owned on its event date. It is not a report of a trade, and the holding may have changed since. A stock's page and its company's page list, for the companies this site tracks, each holder's newest statement on record about that company, largest stated percentage first, at most {HOLDER_ROWS} rows; the record starts with statements published from {RECORD_START_LABEL} on, so a holder whose last statement is older is not listed and the list is not a full list of shareholders. An amendment does not say which statement it replaces, so statements are matched by the SEC number of the filer and the company: the newest by that filer is shown, and its older ones are in the CSV file only. A holder that reports on two classes of one company's shares, such as Class A and Class C, has a row for each class. A class is told by the CUSIP number on the statement and by one test only: the holder's statements under the two numbers overlap in time, which means it filed under both on one day or went back to the first number after using the second. When every statement under one number was filed before every statement under another, the number is taken to have changed, as it does after a reverse split or when a company moves, and only the newest statement is shown. A holder with a statement that gives no CUSIP number is never split. The test can miss a second class that a holder reported on once and never again, and it cannot tell a mistyped number from a new one. Every figure is the filer's own, as filed. When a statement names several reporting persons, the shares and the percentage shown are the largest that any one of them states, never a sum, because members of a group each report the group's combined holding; for the same reason rows are not added together, and the section counts holders and rows only. A newest statement under {THRESHOLD_PERCENT}% stays listed and is marked "below {THRESHOLD_PERCENT}%": it is the holder's notice that it is no longer above that mark. No figure from a statement is in any buy or sell total, chart, feed or trade map on this site. A holder's name links to a page here only when the SEC number of the statement's filer belongs to exactly one person or company with a page. That page, an insider's or a company's, has a section "Large holdings this filer reports" with the same statements from the other side: the filer's newest statement about each other company this site tracks, by class of shares under the same test, largest stated percentage first. It is not a list of everything the filer owns: only holdings above {THRESHOLD_PERCENT}% of a class are reported on these schedules. The purpose a Schedule 13D states is not shown on pages and is in the CSV file as filed; nothing is derived from it. Addresses, phone numbers, signatures and the form's answers about legal proceedings are not kept. The statements appear on pages only while the daily load is current, which means the newest statement on file was filed within the last {CAUGHT_UP_DAYS} days. All statements on record for tracked companies are in one CSV file on the <a href="/downloads/">downloads page</a>.</p>}
  {model.assistance.rows.length > 0 && <p id="assistance"><strong>Grants, loans and direct payments.</strong> The <a href="/grants/">grants and loans page</a> lists awards of financial assistance that started in the last {ASSISTANCE_WINDOW_DAYS} days, counted back from the day the page was built and never after it, from USAspending. It holds the largest awards of each kind that started in each 30-day stretch, plus awards to companies this site follows whose recipient name equals the company's name exactly; it is not every award. The three kinds, grants, loans and guarantees, and direct payments, are listed apart and never added together: a grant's amount is the award value agencies report, a loan's amount is its face value, which is money lent or guaranteed and not spent, and a loan also shows its subsidy cost, the government's own estimate of the loan's long-term cost, which can be negative. A recipient that USAspending masks, mostly individuals, is shown as returned, counted, and never linked to a company; a name that two companies share matches neither. The program is the assistance listing the agency reports, split at its first space into the listing number and its title. Nothing is derived from a description. All awards held are in one CSV file on the <a href="/downloads/">downloads page</a>.</p>}
  {model.lobbyContrib.available && model.lobbyContrib.periods.length > 0 && <p id="lobbyist-contributions"><strong>Lobbyist contributions (Form LD-203).</strong> The <a href="/lobbyist-contributions/">lobbyist contributions page</a> totals the contribution reports that registered lobbyists and lobbying firms file with the Senate twice a year, read daily from the Senate's lobbying disclosure data; the Senate Office of Public Records cannot vouch for that data. An amended report is a new filing that the data does not tie to the one it replaces, so for the same registrant, lobbyist, year and period only the version posted last counts and the earlier ones are left out of every figure; the CSV files keep them marked as not counted. A report with an item that has no date, or a date in the future, counts that item in its report's period and lists it without a date. Names are as the filers typed them and nothing merges two spellings. An item is tied to a member of Congress in one way only: its honoree field, once titles such as "Rep." and bracketed tags are removed, equals the member's full name on the roster, or equals first and last name where exactly one member has that pair. A surname alone, or a field naming several people, matches nobody. A second rule ties an item whose honoree does not name a member to the member whose campaign committee is the payee: the payee, once capitals, punctuation and endings such as "Inc." are set aside, must equal the name of a campaign committee that this site has linked to the member by FEC and Bioguide ids (see <a href="#campaign-committee">campaign committees</a>). The honoree rule is tried first. A committee name that two members' committees share matches nobody, and a payee that only resembles a committee name matches nobody. {model.lobbyContrib.match.items > 0 ? `In ${model.lobbyContrib.newestYear}, ${num(model.lobbyContrib.match.matched)} of ${num(model.lobbyContrib.match.items)} items (${shareText(model.lobbyContrib.match)}) are tied to a member.` : ""} A company page shows the items of the reports filed under the company's name when that name equals exactly one registrant's name. An LD-203 item is a statement by the filer; nothing here links it to a vote, a trade or any other action. All items are in CSV files by year on the <a href="/downloads/">downloads page</a>.</p>}
  {model.financials.byCik.size > 0 && <p id="financials"><strong>Financials, as filed.</strong> The "Financials, as filed" section on a company's page holds figures from the company's own annual and quarterly reports to the SEC (forms 10-K, 10-Q, 20-F and 40-F and their amendments), read about once a week for each company this site tracks from the labelled (XBRL) figures the SEC publishes. A fixed set is read: revenue, net income, diluted earnings per share, cash from operations, capital expenditure, cash and equivalents, total assets, total liabilities, shareholders' equity and long-term debt. A company can file the same thing under several labels (tags); the site takes the first label on a fixed list that has a figure for the period, and when two reports state the same period, the newer report's figure, so a restated figure replaces the original. A period is told by its length: {QUARTER_DAYS[0]} to {QUARTER_DAYS[1]} days is a quarter, {YEAR_DAYS[0]} to {YEAR_DAYS[1]} days a fiscal year. The page shows the {YEARS_SHOWN} newest fiscal years and the {QUARTERS_SHOWN} newest quarters, for periods ending in 2023 or later. No line of the tables is worked out from two filed figures: a fourth fiscal quarter is reported inside the annual report and not on its own, so it has no column, and cash-flow figures, which quarterly reports give for the year to date, are in the fiscal-year table only. Half-year and nine-month figures are not shown. Every amount is in the currency the company reports in, named on the page; nothing is converted, and figures the company also filed in a second currency are left out. A dash means the reports give no figure under a label on the list, which is not the same as zero. Four checks hold a figure back, and the page then prints "not shown": earnings per share that would mean the company has fewer than {MIN_IMPLIED_SHARES.toLocaleString("en-US")} shares (net income divided by earnings per share; with no net income for the period, earnings per share beyond {MAX_EPS_WITHOUT_INCOME.toLocaleString("en-US")} either way), which usually means a figure filed in the wrong scale, though a very small company can really have so few shares; total assets that differ from total liabilities and equity on the same date by more than {BALANCE_TOLERANCE * 100}%; cash larger than total assets; and long-term debt larger than total liabilities on the same date. A small letter marks a figure filed under a different label than the same line in the newest column. No other figure is checked or changed, so a mistake in a filing that these checks do not catch is shown as filed; the link under each column opens the report. <span id="long-term-debt">Long-term debt has a rule of its own, because companies file it under headings that measure different things: all long-term debt, long-term debt not counting the part due within a year, long-term debt together with lease obligations, or, under international standards, borrowings.</span> A company's page has a debt line only when every fiscal year and quarter on file gives the figure under one heading, and the line is named after that heading, so read the name before comparing two companies. When a company's reports use more than one heading, the page has no debt line and says so in a sentence: the two figures cannot be put in one row, and in the filed data a figure under the heading for all long-term debt is sometimes smaller than the figure under the heading for the part due after a year, which shows the headings are not always used as defined. The same can be true of a company that uses one heading throughout, and nothing here can detect that; the figure is shown as filed, with the report linked under the column. <span id="financial-ratios">Two ratios are the one exception to showing only what was filed, and they are set apart at the foot of each table under the heading "{RATIO_HEAD}": net margin, which is net income divided by revenue for the period, as a percentage; and liabilities to equity, which is total liabilities divided by shareholders' equity on the last day of the period.</span> Each is this site's arithmetic on the two figures printed in the same column, and each line names its two figures. The two can come from different reports, because a later report restates some figures of an earlier period and not others. A ratio is worked out only when both figures are printed and the figure divided by is above zero: a dash means one of the two is missing or not shown, and "n/a" means revenue was zero or below, or equity was zero or negative, where the result would say nothing. A net margin beyond {RATIOS[0]!.cap.toLocaleString("en-US")}% either way and a liabilities to equity figure above {RATIOS[1]!.cap.toLocaleString("en-US")} are printed in words ("over {RATIOS[0]!.cap.toLocaleString("en-US")}%"): they come from a period with almost no revenue or almost no equity, and the CSV file has the number. A ratio is used in no total or filter on this site; the <a href="/company-financials/#ratios">financials screener</a> can show the same two ratios for each company's newest period and list the companies in order of one, which is an order by that one number and nothing more. A ratio is not a verdict on a company: what is usual differs widely between industries, and a bank or an insurer normally carries liabilities many times its equity. No ratio that needs a share price, no score or ranking and no forecast is made from these figures, and none of them is in any buy or sell total, chart or trade map on this site. Every fiscal year and quarter on file is in one CSV file on the <a href="/downloads/">downloads page</a>, with the figures as filed, a column naming any figure a page does not show, and the two ratios in columns of their own.</p>}
  {instHubShown(model) && <p id="institutional-holders"><strong>Institutional holders (Form 13F).</strong> A Form 13F is the quarterly report in which an institutional investment manager that oversees at least $100 million in covered securities lists its long positions on the last day of the quarter, filed up to 45 days after it. It shows what a manager held on one day, not trades, and it leaves out short positions. A stock's page and its company's page have a section "Institutional holders: Form 13F" for the companies this site tracks. The quarter shown is the newest calendar quarter end that is not in the future and for which at least {INST_MIN_MANAGERS.toLocaleString("en-US")} different managers have filed, so a first week of filings is not shown as the whole quarter; the quarter before it is used for comparison when it meets the same test. For each company the figures are taken over share positions only: the number of different managers, the shares they report and the value they report, as filed. Put and call options are left out of those figures, and the section says how many managers report them. Positions in bonds are left out too. A manager that reports a company under more than one class of shares is one manager, with the shares and values of its classes added. The sums are sums of what managers reported, not a share of the company: an adviser and the fund it runs can each report the same shares, so shares can be counted twice, and managers under the $100 million threshold do not file. For that reason no percentage of a company is stated anywhere. The {INST_TOP} managers with the largest summed reported value are listed, with the same manager's shares for the quarter before and the change in shares when both quarters are on file; a manager with no row for the earlier quarter reads "not reported for" that quarter and is never called new. A manager's name links to a page here only when its SEC number belongs to exactly one person or company with a page. The sections and the <a href="/institutional-holders/">institutional holders page</a> appear only while the load is current, which means the newest filing in the newest quarter was filed within the last {INST_SHOWN_DAYS} days; a stalled load hides them. The values are the managers' own, as filed. Nothing from a 13F is in any buy or sell total, chart or trade map. Both CSV files, the largest managers for each company and one row per company, are on the <a href="/downloads/">downloads page</a>.</p>}
  {model.financials.byCik.size > 0 && <p id="financials-screener"><strong>Company financials screener.</strong> The <a href="/company-financials/">screener</a> has one row for each tracked company with a fiscal year or a quarter on file: the newest fiscal year, or the newest quarter filed on its own, with revenue, net income, diluted earnings per share, total assets and shareholders' equity. The figures, the rule for telling a period by its length and the three checks are those of the section above, so a figure a company's page does not show is not shown there either, is left out of the file the table loads and passes no filter on its column. Companies have different fiscal years, so the periods in one view end on different days; each row states its own. A company keeps its row with the last period it reported, however old; the "Ended in the last 18 months" filter keeps only periods whose last day is at most {FS_RECENT_DAYS} days before the build day, never a period dated after it, and is off when the table opens. The revenue and total-assets filters are in U.S. dollars and read only companies that report in dollars, and sorting by an amount lists dollar figures first, because amounts in different currencies are never converted or compared. The net-income filter goes by the sign of the filed figure, so it covers every currency; a figure of exactly zero is neither above nor below. The industry is the division of the SEC's industry code. Sorting orders companies by what one column holds; there is no score, rating or ranking by quality. Under "Columns", "Two worked-out ratios" swaps part of the table for net margin and liabilities to equity, the two ratios described under the financials section above, each worked out from two amounts printed in the same row and placed right after them (total liabilities is shown in that view for the purpose), with the same "n/a" for a base of zero or below and the same wording beyond the limits. An empty ratio cell means an amount is missing or not shown. A ratio column can be sorted, and because a ratio needs no currency every company with both amounts takes part, with "n/a" and empty cells last; a sort by a ratio is an order by that one worked-out number, not a verdict. There is no filter on a ratio. "Balance-sheet figures" shows four filed amounts as of the last day of the period (cash and equivalents, total assets, total liabilities, shareholders' equity) and nothing worked out; cash is the figure under the report's cash and cash equivalents heading, which for some companies also takes in restricted cash, and it is held back like any other figure when it exceeds total assets on the same date. The choice of columns is kept in the page address; a sort by a column the chosen set does not show is ignored. "Download these rows" writes the matching companies to a file in the browser. The link from an industry page states how many of its companies have a fiscal year on file, which is the number the screener opens on. "CEO pay, as reported" is the total compensation of the principal executive officer in the company's newest fiscal year with a pay table on the <a href="/executive-pay/">executive pay</a> page, in dollars as filed, with the fiscal year it covers beside it; it belongs to the company, not to the period the screener is showing, and it is blank where no pay table is on file. The "Executive pay" filter keeps companies that have one. The column sorts by the figure as filed, blanks last, and nothing is compared with revenue or income. The Financials section on a company's page links to the screener narrowed to the company's industry division and states the number of companies that view opens on, which is the companies of the division with a fiscal year on file; a company with no industry division has no such link.</p>}
  {model.events.byCik.size > 0 && <p id="company-events"><strong>Company events.</strong> The "Company events: Form 8-K reports" section on a stock's page and its company's page, the <a href="/company-events/">company events list</a> and the CSV file hold the current reports (Form 8-K and its amendments, 8-K/A) that companies with a page here have filed with the SEC since October 1, 2025, read daily from the SEC's filing index. For each report the site stores the filing date, the event date the report states, the item numbers it names and the address of the report; it does not store or read the text. An item is shown as its number and the SEC's fixed heading, in order, with 9.01 (financial statements and exhibits) last and in softer ink because it attaches the documents of another item. A company's page and the list cover reports filed in the last {EVENT_WINDOW_DAYS} days, counted back from the day of the build; the page shows the {EVENT_ROWS} newest and a folded table counts reports by item, and the CSV file has every report on record. The sentence over a company's table names the three items it filed most often in that window, apart from 9.01. An amendment is its own row: the form does not say which report it amends, so none is linked to another. Nothing is derived from a report: no report is called good or bad news, none is set beside a trade, and none enters any buy or sell total, chart or the trade map. A company has a row when its SEC number (CIK) matches a report; a company that files none has no section. An insider's page carries one line with the number of reports the insider's company filed in the last 12 months, linked to the company's section; it is the company's count and says nothing about the insider.</p>}
  {model.execPay.byCik.size > 0 && <p id="executive-pay"><strong>Executive pay.</strong> The "Executive pay, as filed" section on a stock's page and its company's page, the <a href="/executive-pay/">executive pay list</a> and the CSV file hold four figures per fiscal year from the Pay Versus Performance table of the proxy statement, as the company tagged them for the SEC (the <code>ecd</code> taxonomy of the SEC's labelled data): the principal executive officer's total in the Summary Compensation Table and compensation actually paid, and the same two as an average over the other named executive officers. They are in dollars; nothing is converted, added up or held back. A company's page shows its {PAY_YEARS} newest fiscal years, newest first, each headed by the date the year ended, with a link to the filing the figures came from (the principal executive officer's total, else any of the year's figures). A dash means the company did not tag that figure. A figure of {(PAY_LARGE / 1e9).toLocaleString("en-US")} billion dollars or more in either direction, or a total (not "actually paid") of less than ${PAY_SMALL.toLocaleString("en-US")}, is marked with a small letter; the mark says the figure is unusual, not that it is wrong. The data names no person, and the figures never appear on an insider's page. The list shows each company's newest fiscal year; years in one view end on different days, and a row states its own. Companies that do not file the table in this data, or tagged it differently, are missing, so the figures cover only part of the companies with a page. The site makes no ranking of companies by pay, no score, no comparison with any trade and no judgement about whether pay was deserved.</p>}
  <p id="footnotes"><strong>Form 4 footnotes.</strong> A Form 4 can carry footnotes: the range behind a weighted-average price, the date a trading plan was adopted, shares held through a trust, shares withheld for tax. Where a filing on record here has footnotes, each of its rows in a trade table carries a link such as "2 notes", and the text is printed once per filing, folded, under the table, word for word as filed (only spacing and character escapes are tidied). The site keeps a filing's footnotes as a list and does not record which row or box each one is attached to, so a note shown beside a row may be about another row of the same filing: the linked Form 4 shows where each note belongs. When a filing has more than {MAX_NOTES_PER_FILING} footnotes the first {MAX_NOTES_PER_FILING} are printed and the rest are counted. Nothing is read into a footnote: no flag, total or label on this site is derived from footnote text. Filings loaded from the SEC's quarterly data sets have no footnote text here yet, and footnotes are not in the CSV files.</p>
  <p id="downloads"><strong>Downloads.</strong> The CSV files on the <a href="/downloads/">downloads page</a> are written during the same build as the pages, from the same rows, so a file and its page cannot differ: a row that is held back from a page is held back from the file, and a row shown as under review carries <code>under_review = true</code>. Insider and lobbying files are cut by quarter; a transaction reported by two filers appears in each filer's rows and is marked so it can be counted once. No file contains individual donors or market prices. The <a href="/developers/">developers page</a> lists every file for scripts, and <code>/data/catalog.json</code> lists them in a form a program can read, with each file's row count and columns taken from the same build.</p>
  <p id="week-in-filings"><strong>This week in filings.</strong> The row on the home page counts, for each dataset shown on this site, the records dated in the 7 days up to the day the site was built, both ends included and never after that day. Each count uses its own dataset's date: Form 8-K reports, Schedule 13D and 13G statements and Form 144 notices by the day they were filed, roll-call votes by the day held, independent expenditures by the date spent, lobbyist contribution reports by the day the Senate posted them, and grants and loans by the day the award started. A dataset that is not shown here yet, because its first load is not complete or is out of date, has no tile, and the row is left out when fewer than three datasets can be shown. A count is a number of records and nothing more; it is not a measure of activity and says nothing about why anything was filed. The <a href="/washington/">Washington</a> page lists the same datasets with the figures each one's own page prints.</p>
  <p id="feeds"><strong>RSS feeds.</strong> The <a href="/feeds/">RSS feeds</a> are files written during the same build as the pages, from the same rows. The congressional feed has one item for each published row of a periodic transaction report, newest disclosure first. The insider feeds have one item for each Form 4 filing and direction: the filing's open-market purchases (code P) or its open-market sales (code S) added up, so a trade filled in several lots is one item. Grants, option exercises, gifts, shares withheld for tax, derivative rows and a repeat filing of a trade already on record are not in the insider feeds, and rows under review are in no feed. Items are dated by the day the filing became public. The insider feeds cover the companies this site tracks. An item states what the filing shows and nothing else.</p>
  {model.votes.shown && <p id="votes"><strong>Roll call votes.</strong> A roll call is a vote in which the chamber records each member's position by name. The <a href="/congress-votes/">roll call page</a> lists every roll call on file for the House and the Senate: the date, the bill as the chamber gives it, the question and the result in the chamber's own words, and the official totals of yea (aye), nay (no), present and not voting. The numbers come from the Clerk of the House and the Secretary of the Senate; a roll call links to the official page. A member's positions are matched to the member's page by the member's identifier (the Bioguide ID for the House; the Senate's own member number, linked to the Bioguide ID, for the Senate) and never by name; a recorded name that cannot be matched keeps its position in the roll call's list and has no page link. A member's page shows the {VOTE_ROWS} newest roll calls with a recorded position, and counts the positions on roll calls held in the last {VOTES_WINDOW_DAYS} days, counted back from the day the page was built. "Not voting" is the record's term for no vote recorded and covers every reason; this site does not give a reason. The question is cut at {MEMBER_QUESTION_MAX} characters on member pages and is whole in the CSV file. Voice votes and votes by unanimous consent record no positions and are not on file. This site does not score votes: no "voted with the party" figure, no attendance percentage, no ranking of members by missed votes, and no pairing of a vote with a trade, a contribution or a committee seat. The positions behind "Positions" are in one small file per chamber and month, listed on the <a href="/developers/">developers page</a>.</p>}
  {model.campaign.shown && <p id="campaign-committee"><strong>Campaign committees.</strong> A member's page has a campaign committee section when a campaign committee is linked to the member and this site holds itemized receipts for it. The link uses ids only: the FEC candidate id of the committee, from the FEC's candidate search, is matched to the member's Bioguide id in the public congress-legislators roster, and that Bioguide id to the member's page here. No name is compared. A committee with no id match has no member, and a member with no match has no section. {num(model.campaign.committees.length)} committees are linked today. The section shows the itemized receipts this site holds for the committee, dated up to the day of the build: how many, their sum, the same for the last 90 days, the dates of the first and newest, the ten employers donors named with the largest sums and the ten largest donor states. Receipts with no employer, or with a word such as retired, self-employed, none or not employed, are left out of the employer table and counted beside it. For a large committee these receipts are a sample, so a sum is not the committee's total; the FEC page the section links to holds the reported totals. No donor names are kept or shown, and nothing ties a receipt to a trade, a vote or any other action. The linked committees, with counts only, are in <a href="/downloads/campaign-committees.csv">campaign-committees.csv</a>. The same links decide the payee rule for <a href="#lobbyist-contributions">lobbyist contributions</a>.</p>}
  {model.outside.shown && <p id="outside-spending"><strong>Outside spending.</strong> An independent expenditure is money a person or group spends on a communication that expressly advocates the election or defeat of a clearly identified federal candidate, without coordination with the candidate. The <a href="/outside-spending/">outside spending page</a> and the "Outside spending" section of a member's page list them as the spenders reported them to the FEC, on 24-hour and 48-hour notices and on regular reports. The same spending is reported twice, so one rule counts it once: {COUNT_RULE} A row with no amount or no stated side is listed and is in no total. Support and opposition are shown separately and are never added together or netted, and a total is the money the spenders reported on communications that name the member, not money the member received. A member's section shows the {OUTSIDE_ROWS} newest counted rows, and the purpose is cut at {OS_DESC} characters (it is whole in the CSV file, with a column <code>counted</code> that says which rows count). The candidate table lists candidates named in at least {CANDIDATE_MIN_ROWS} counted rows. A spender is named as it reported itself; the payee it paid is not shown. A row is linked to a member's page only when the FEC's candidate number is the one the congress-legislators dataset gives that sitting member, so former members and candidates who never held the seat have no page link. Spending dates in the future are dropped before they are stored.</p>}
  <p id="member-pages"><strong>Member pages.</strong> Party, seat, term dates and current committee assignments come from the public-domain congress-legislators dataset and are refreshed daily. Every figure on a member's page is counted from the rows in that member's trade table: purchases and sales by the side stated on the report, years by the trade date, owners as the report names them, and dollar amounts as sums of the low and high ends of the ranges filed. The comparison sets one member beside all members with at least one trade on record here; it uses medians, and it leaves out members who reported no trades. Committee seats are shown for context and are never matched to trades.</p>
  <p id="member-directory"><strong>Member directory.</strong> The <a href="/congress-members/">directory</a> has one row for each member of Congress on record: sitting members from the roster, and members who filed a report and have since left office. "Trades" counts every transaction row from that member's reports on this site, and "Trades, 12 months" counts the rows disclosed in the last 365 days. The activity filter uses the disclosure date of the member's newest row. The committee filter lists members assigned to the committee or to one of its subcommittees, from the same roster data as the member pages. It is context only.</p>
  <p id="congress-screener"><strong>Congress trade screener.</strong> The <a href="/congress-trades/">screener</a> holds one row for each transaction in a House or Senate periodic transaction report on record that has passed review: the same rows as the member pages, less any still under review. Filters work together. The date windows count back from the day the page was built, by the day the report was filed. "Reported late" is the member pages' rule: more than {CONGRESS_DEADLINE_DAYS} days from trade to report; a row with no trade date is neither late nor on time. The amount filter compares the low end of the range the report gives, and sorting by amount orders by the low end, then the high end. The upper limit compares the high end of the range, so the two together select one band, and a range with no stated top passes no upper limit. The "Traded" windows count back from the same build day by the trade date in the report; a row whose trade date is missing, or was dated after the report itself and left blank, is in none of them. No dollar total is shown, because a report gives a range. The committee filter uses today's seats (a subcommittee seat counts for its full committee), so it includes trades made before a member joined; a seat is context and not evidence about any trade. The count line gives trades, members, purchases, sales and distinct tickers for the rows that match. Member pages, committee pages and the congressional section of stock pages link into the screener narrowed to that member, that committee or that ticker; the number beside the link is the number of rows the screener opens on, counted with the screener's own filter, and a member or ticker opened this way is matched exactly (the ticker A is not AAPL). "Download these rows" writes the rows that match, in the order shown and across every page, to a CSV file made in the browser; nothing is sent to this site. "Save this screen" stores a name and the view's address (its filters, sort order and rows per page, never a page number or any rows) in the browser's local storage, at most {MAX_SAVED} of them; a saved screen is read back through the same address parser as a link, so it can hold nothing the address cannot, and it is never sent to this site.</p>
  <p id="ticker-history"><strong>Ticker history flags.</strong> Congressional rows can carry two flags, worked out at each build from the published rows that have a ticker and a usable trade date. Rows are grouped by member and ticker and ordered by trade date; several rows on one date are one date. "first on record" marks every row of the member's earliest trade date in the ticker. The record holds reports filed from {formatDate(RECORD_START)} on, so a trade made before that day is here only if it was reported late or amended; the flag is therefore given only to trades made {FIRST_MIN_DAYS} days or more after that day ({formatDate(firstEligibleFrom())} or later). It states that no earlier trade in the ticker is on record, not that the member never held or traded the asset. "{RUN_MIN}rd buy in a row" and higher (and the same for sales) marks a purchase on the {RUN_MIN}rd or a later trade date running on which the member only bought the ticker; a date with purchases and sales both ends the count and carries none, and an exchange neither counts nor ends it. A report filed late can change the flags of later rows once it is on record. Scanned filings held for reading, rows under review and rows with no ticker take no part. The flags appear in the trade tables, in the screener's Side column and as the screener's "Ticker history" filter, and in the screener's download as <code>first_in_ticker_on_record</code> and <code>same_side_run</code>. Nothing is ranked or totalled by them, and they say nothing about why a trade was made.</p>
  <p id="committees"><strong>Committee pages.</strong> Each full committee with a member on record has <a href="/congress-committees/">a page</a>: its current members, the tickers that appear most often in the reports they disclosed in the last 365 days, and their trades, newest disclosure first. A member who sits only on a subcommittee is listed under the full committee. The roster gives today's assignments and no history, so a committee's trades are every trade on record for its current members, including trades made before a member joined, and trades by members who have left the committee are not on its page. "Trades, 12 months" goes by disclosure date. Nothing on these pages compares a trade with a committee's work; a seat is context and not evidence about any trade. When lobbyist contributions are on the site, a committee page also lists its current members who are named as honoree on at least one Form LD-203 item (the member pages' own matching), with counts of items and filers and the newest item date; no amounts are added across members and a contribution is not tied to the committee's work.</p>
  <p id="lobbying-issues"><strong>Lobbying by issue.</strong> A lobbying report names one or more of the 79 general issue areas and states one amount for the quarter. Lobbying tables list every issue area a filing names. The <a href="/lobbying-issues/">issue pages</a> count a filing under every issue it names, so their rows add up to more than the number of filings, and the amount beside an issue is the total on the filings that name it: a filing that names several issues adds its whole amount to each. Those amounts overlap, are never added together on this site, and do not say what was spent on one issue. The chart on the <a href="/lobbying/">lobbying page</a> counts each filing once, under its first issue. Figures are for the current filing year, one row per registrant, client and period (the latest posted version of an amended report); registrations usually name no issue. The lobbying CSV files carry every issue code of each filing.</p>

  <h2 id="social">The daily thread</h2>
  <p>Once a day a scripted thread lists notable published filings (the largest by value, late filings, first filings, cluster buys) with a link to the page and to the source document. It contains facts and links only.</p>

  <h2 id="never">What this site never does</h2>
  <p>No buy or sell recommendations, no forward-looking scores, no trade execution or copy-trading, no inference of motive or wrongdoing from any filing. Historical performance, when shown, is computed only from disclosed trades against a stated benchmark and is not a prediction.</p>

  <h2 id="corrections">Corrections</h2>
  <p>Errors are fixed within five working days of a report; see <a href="/corrections/">the corrections page</a>.</p>

  <h2 id="coverage">What is covered, and what is not</h2>
  <p>These counts are rebuilt with every update of the site, straight from the database; the same figures, by source and month, are in <a href="/data/coverage.json">/data/coverage.json</a>.</p>
  <ul>
    <li><strong>House trades.</strong> {num(sum(houseYear.map((f) => f.filings)))} periodic transaction reports filed in {thisYear} are on file here{houseIndex != null ? <span>; the House Clerk's {thisYear} index lists {num(houseIndex)}</span> : null}. {num(sum(houseYear.map((f) => f.published)))} of ours are shown; {num(sum(houseYear.map((f) => f.filings - f.published)))} are held back, mostly scanned or handwritten reports that software cannot read reliably and a person has not yet transcribed. A member who files only on paper will be missing from the maps and tables until then.</li>
    <li><strong>Senate trades.</strong> {senate.length
      ? `${num(sum(senate.map((f) => f.filings)))} periodic transaction reports on file, received ${senate.filter((f) => f.month !== "none")[0]?.month ?? ""} to ${senate.filter((f) => f.month !== "none").slice(-1)[0]?.month ?? ""}; ${num(sum(senate.map((f) => f.published)))} are shown. The rest are paper filings awaiting transcription, earlier versions replaced by an amendment, or reports still under review. Senate reports are loaded in batches from saved copies, so the newest may lag the Senate's site by days.`
      : "None. The Senate's disclosure site blocks automated readers, and no Senate report has been ingested yet. Every \"Congress\" figure on this site is House only."}</li>
    <li><strong>Corporate insiders.</strong> {num(sum(form4.map((f) => f.filings)))} Form 4 filings on file, filed on or after {form4FloorText}, for the tracked tickers ({num(model.counts.securities ?? 0)} securities). Insiders, tickers and companies outside that set have pages built when first opened, from the market-wide Form 4 filings on file, with the same publishing rules; those pages show the newest rows only and are not counted here.</li>
    <li><strong>Lobbying.</strong> {span(cov.tables.lobbying)} (by reporting quarter).</li>
    <li><strong>Contracts.</strong> {span(cov.tables.contracts)}: the largest awards each month plus awards to followed companies, not every federal contract.</li>
    <li><strong>Donations.</strong> {span(cov.tables.donations)}: itemized receipts of tracked committees only.</li>
    {planned && <li id="coverage-form144" data-stored="form144" data-rows={stored.form144.rows} data-last={stored.form144.lastFiled ?? ""} data-catching-up={catchingUp(stored.form144, cov.builtAt) ? "yes" : "no"}><strong>Planned sales (SEC Form 144).</strong> {planned}</li>}
    {holders && <li id="coverage-schedule13" data-stored="schedule13" data-rows={stored.schedule13.rows} data-last={stored.schedule13.lastFiled ?? ""} data-catching-up={catchingUp(stored.schedule13, cov.builtAt) ? "yes" : "no"}><strong>Large holders (SEC Schedules 13D and 13G).</strong> {holders}</li>}
  </ul>
  {house.length > 0 && (
    <div class="table-wrap">
      <div class="tablewrap"><table class="data">
        <caption>House periodic transaction reports by month filed</caption>
        <thead><tr><th>Month filed</th><th class="num">On file</th><th class="num">Shown</th><th class="num">Held for review</th><th class="num">Of those, paper filings</th></tr></thead>
        <tbody>
          {house.map((f) => <tr><td>{monthLabel(f.month)}</td><td class="num">{num(f.filings)}</td><td class="num">{num(f.published)}</td><td class="num">{num(f.filings - f.published)}</td><td class="num">{num(f.paper)}</td></tr>)}
        </tbody>
      </table></div>
    </div>
  )}

  <h2 id="status">Data status</h2>
  <p class="mono small">people {num(model.counts.people ?? 0)} · companies {num(model.counts.companies ?? 0)} · securities {num(model.counts.securities ?? 0)} · filings {num(model.counts.filings ?? 0)} · transactions {num(model.counts.txns ?? 0)} · lobbying {num(model.counts.lobbying ?? 0)} · contracts {num(model.counts.contracts ?? 0)} · built {model.builtAt}</p>
  <JsonLd data={ld} />
</BaseLayout>
