---
// /methodology/ — how every figure on the site is produced. Linked from every entity page,
// the flags, the X thread and llms.txt. Sections are stable anchors (#sources, #lag, …).
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import JsonLd from "../components/JsonLd.astro";
import { getFlagship, CONGRESS_DEADLINE_DAYS, num } from "../lib/flagship";
import { SITE_URL, SOURCES } from "../lib/seo";
import { FORM4_FLOOR } from "@stm/shared";
import { formatDate } from "../lib/format";
import Answer from "../components/Answer.astro";
import { CLUSTER_MIN_INSIDERS, CLUSTER_DAYS, STAKE_MIN_PCT, STAKE_MIN_VALUE, LARGE_SALE_MIN, CONGRESS_MIN_LOW, CLUSTER_SELL_MIN_INSIDERS, CLUSTER_SELL_MIN_VALUE, CLUSTER_SELL_MIN_PCT } from "../lib/notable";
import { getCoverage, filingMonths, latestStat } from "../lib/coverage";

const model = await getFlagship();
const cov = await getCoverage();
const house = filingMonths(cov, "house_ptr", 13).reverse();
const sum = (xs: number[]) => xs.reduce((a, b) => a + b, 0);
const thisYear = new Date().getUTCFullYear();
const houseYear = cov.filings.filter((f) => f.source === "house_ptr" && f.month.startsWith(String(thisYear)));
const houseIndex = latestStat(cov, "house_ptr", `index_ptrs_${thisYear}`);
// Form 4 filings filed before the floor are in the database but not shown (shared/src/floor.ts),
// so the count here leaves them out too: it once read "filed 2003-04 onward".
const form4 = cov.filings.filter((f) => f.source === "sec_form4" && (f.month === "none" || f.month >= FORM4_FLOOR.slice(0, 7)));
const form4FloorText = new Date(FORM4_FLOOR + "T00:00:00Z").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const senate = cov.filings.filter((f) => f.source === "senate_ptr");
const span = (rows: { month: string; rows: number }[] | undefined) => { const r = (rows ?? []).filter((x) => x.month !== "none"); return r.length ? `${num(sum(r.map((x) => x.rows)))} rows, ${r[0]!.month} to ${r[r.length - 1]!.month}` : "none on file"; };
const monthLabel = (m: string) => new Date(`${m}-01T00:00:00Z`).toLocaleString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
const description = "How Spot the Money collects, filters and presents public disclosures: sources, update cadence, the publishing bar, late-filer rules and flag definitions.";
const ld = { "@context": "https://schema.org", "@type": "WebPage", "@id": `${SITE_URL}/methodology/#page`, name: "Methodology", url: `${SITE_URL}/methodology/`, description, dateModified: model.builtAt.slice(0, 10), isPartOf: { "@type": "WebSite", name: "Spot the Money", url: `${SITE_URL}/` } };
import { MAX_NOTES_PER_FILING } from "../lib/footnotes";
---
<BaseLayout title="Methodology: how the numbers are made | Spot the Money" description={description} section="Methodology">
  <Crumbs crumbs={[{ name: "Home", path: "/" }, { name: "Methodology", path: "/methodology/" }]} />
  <p class="eyebrow">About <span class="x">/</span> Methodology</p>
  <h1>How the numbers are made</h1>
  <p class="lede">Every figure on this site is a public record, shown as filed, with the rule that produced it written down here. Site built {formatDate(model.builtAt)}.</p>
  <Answer text={`Spot the Money shows public U.S. government records as filed: SEC Form 4 insider trades, House STOCK Act trade reports, FEC contributions, Senate lobbying filings, USAspending contracts and Treasury rates, read once a day from the official sources. A transaction is shown only if its filing parsed cleanly, congressional trades count as late after ${CONGRESS_DEADLINE_DAYS} days, and every row links to its source filing.`} updated={model.builtAt} sourceNote="Rules below apply to every page" />

  <h2 id="sources">Sources and cadence</h2>
  <p>We read only official primary sources, once a day, with a client that identifies this site and its contact address on every request and never exceeds one request every 1.5 seconds per host:</p>
  <ul>
    <li><a href={SOURCES.edgar.url}>SEC EDGAR</a>: Form 4 ownership filings (XML) for a tracked set of about 70 large or frequently traded U.S. tickers plus every ticker that appears in a congressional filing. The record starts with filings made on or after {form4FloorText}; a few hundred older filings are stored but not shown, because a handful of rows from an earlier year would read as that whole year. Amendments (Form 4/A) are not merged into the original.</li>
    <li><a href={SOURCES.house.url}>U.S. House Clerk</a>: periodic transaction reports (PTRs) as PDFs, parsed daily. Scanned PDFs without a text layer are held for human review and show no rows until then.</li>
    <li><a href={SOURCES.senate.url}>U.S. Senate eFD</a>: periodic transaction reports. The Senate's site refuses automated readers, and this site does not disguise its crawler as a browser. Senate reports are instead read in an ordinary browser session by a person, saved, and loaded from those saved copies, so they arrive in batches rather than daily{senate.length ? "" : "; none has been loaded yet"}. Reports filed on paper are scans and are held for transcription like the House ones.</li>
    <li><a href={SOURCES.fec.url}>FEC (OpenFEC)</a>: itemized contributions (Schedule A) to the principal campaign committee of every current member of Congress and the 200 largest PACs by receipts in the current cycle, last 90 days.</li>
    <li><a href={SOURCES.lda.url}>Senate Lobbying Disclosure Act filings</a>: quarterly registrations and reports, every filing posted since October 1, 2025; an amended report replaces the one it amends.</li>
    <li><a href={SOURCES.usaspending.url}>USAspending</a>: the largest contract awards that started in each of the last six months, plus awards to followed companies (exact recipient-name match); dated by award start date, valued at total award amount.</li>
    <li><a href={SOURCES.treasury.url}>U.S. Treasury</a>: the daily par yield curve and the daily real (TIPS) yield curve; <a href={SOURCES.fiscaldata.url}>Treasury Fiscal Data</a>: I-Bond rates; <a href={SOURCES.bls.url}>BLS</a>: CPI-U, the input to the I-Bond variable rate.</li>
  </ul>

  <h2 id="publishing-bar">The publishing bar</h2>
  <p>A row is shown only if its filing parsed cleanly (review approved, confidence at least 0.9). Rows from a source whose first sample has not yet been checked by an editor are shown with an "under review" note on the page and are excluded from the data feed and from the daily social thread until the check is complete. Nothing is inferred, filled in or estimated: a blank cell means the filing did not state it.</p>

  <h2 id="lag">Disclosure lag and late filings</h2>
  <p>Lag is the disclosure date minus the trade date, in calendar days. Members of Congress must file within {CONGRESS_DEADLINE_DAYS} days of a trade (STOCK Act); a row is marked late when the report's filing date is later than that. Corporate insiders must file Form 4 within two business days; a row is marked late when the filing date is more than four calendar days after the trade (a conservative rule that never marks a weekend or holiday as late).</p>

  <h2 id="values">Values</h2>
  <p>For Form 4 rows, value is shares × the price reported on the filing (a weighted average when the filing says so); rows with no price, such as grants or option exercises at zero, show no value and never count as buys or sales. Options, warrants and other derivative rows are listed in the tables, marked derivative, but are left out of every buy and sell total and off the trade maps: a put bought is not a purchase of the stock, and the dollars are a premium. Where a filer typed the total for a row into the price box, the per-unit price is worked out from it. When the same trade is reported in more than one Form 4, as when funds or trusts that own a stake together each file their own, it is counted once in totals, under the first filing received. Two rows are the same trade when the stock, date, share count, price and the shares owned afterwards all match and the trade is worth $250,000 or more; the repeated rows stay in the tables, marked as also in another filing. Congressional filings report ranges, so those rows show the range as filed and any total uses the top of the range. Contract amounts are federal obligations on the action, which can be negative. Lobbying amounts are the income or expense reported for the quarter.</p>

  <h2 id="notable">Notable trades on the home page</h2>
  <p>The feed on the home page lists filings that meet one of five written rules. Only published rows count. A row is left out when it is a derivative, a repeat of a trade already counted from another filing, has no ticker, or has a trade date that is missing or later than its filing date. The rules say what a filing shows and nothing about why someone traded. Windows count from the date a trade was disclosed; "Today" means the newest disclosure date in the data. The feed opens on clusters over 7 days, and shows 30 days instead when no cluster was filed in the last 7.</p>
  <ul>
    <li><strong>Insider buy</strong>: a Form 4 open-market purchase (code P) that is not under a 10b5-1 plan.</li>
    <li><strong>Cluster buy</strong>: {CLUSTER_MIN_INSIDERS} or more different insiders buying the same company, with trade dates inside a {CLUSTER_DAYS}-day span and at least one of those rows disclosed in the selected window. A cluster is one item per company; its purchases still appear under "Insider buys" and are folded into the cluster under "All".</li>
    <li><strong>Cluster sell</strong>: held to a much stricter test than a cluster buy, because insiders are paid largely in stock and sell routinely. {CLUSTER_SELL_MIN_INSIDERS} or more different insiders of one company must each qualify inside one {CLUSTER_DAYS}-day span of trade dates, with at least one of the rows disclosed in the selected window. A person qualifies only when, adding up their open-market sales (code S) in the span, three things hold: none is under a 10b5-1 plan, the total is at least ${num(CLUSTER_SELL_MIN_VALUE)}, and the sales cut their own reported holding by at least {CLUSTER_SELL_MIN_PCT} percent (the largest cut in any one row; a row with no holding figure cannot show a cut). Derivative rows and repeats of another filing never count. A company can show a cluster buy and a cluster sell at the same time; each is one item, and under "All" the member sales are folded into the cluster sell item.</li>
    <li><strong>Stake change</strong>: a purchase or sale (code P or S) outside a plan that changes the filer's holding by at least {STAKE_MIN_PCT} percent, up or down, and is worth at least ${num(STAKE_MIN_VALUE)}.</li>
    <li><strong>Large sale</strong>: a sale (code S) outside a plan worth at least ${num(LARGE_SALE_MIN)}.</li>
    <li><strong>Congress</strong>: a House or Senate purchase or sale of a stock with a ticker where the reported range starts at ${num(CONGRESS_MIN_LOW)} or more.</li>
  </ul>
  <p>Insider values are shares times the filed price. Congress values are the range as filed. The feed covers the companies listed on the home page note, not the whole market.</p>

  <h2 id="flags">Flags and feeds</h2>
  <ul>
    <li><strong>Open-market buy</strong>: Form 4 transaction code P. This is the only code counted as a "buy" in ratios and feeds.</li>
    <li><strong>Cluster buy</strong>: three or more distinct insiders with code-P purchases of the same ticker within 30 days.</li>
    <li><strong>10b5-1 plan</strong>: the filer ticked the Rule 10b5-1 box on the Form 4 (available since April 2023).</li>
    <li><strong>Owner</strong>: on congressional rows: the member, spouse, dependent child or joint, as filed.</li>
    <li><strong>Late</strong>: see above. <strong>First filing</strong>: the first filing by that person in our records, which start with the launch of each source.</li>
  </ul>

  <h2 id="matching">Matching people and companies</h2>
  <p><strong>Market cap.</strong> The Market cap filter on the trade maps sorts companies into bands: mega ($200B and up), large ($10B–$200B), mid ($2B–$10B), small ($300M–$2B) and micro (under $300M). The figure behind a band is an estimate from SEC filings, not a market quote: the shares outstanding on the cover of the company's latest quarterly or annual report, multiplied by the median price of its most recent open-market insider trades. Where a company reports shares by class, or has no recent insider trade, the public float stated in its latest annual report is used instead. Funds, ETFs and foreign companies that file annual reports on Form 20-F report no public float and are left out when a market cap band is selected, as are companies whose insider filings have not been loaded yet.</p>
  <p>Insiders are identified by their SEC CIK. Members of Congress are matched by normalized name and chamber (the House index gives no stable id); a state and district come from the filing. Company pages match federal contracts and lobbying clients by exact normalized name (corporate suffixes ignored), which deliberately misses subsidiaries and alternate spellings rather than guess.</p>
  <p id="related-pages"><strong>Related pages and automatic links.</strong> "Related stocks" on a stock's page are the tickers traded by the same filers, ranked by the number of filers in common; "related companies" follow from the same count, and "other insiders" are the people who file for the same company. These lists describe overlap in public filings and are not a statement about any trade. A lobbying client, registrant or contract recipient is linked to a company page only when its name matches a tracked company exactly after the same normalising used above, and never when two companies share that name. In the guides, the first mention of a term that another guide explains is linked to that guide automatically.</p>
  <p id="holdings"><strong>Held after and Change.</strong> On Form 4 rows, "Held after" is the number of shares the insider reports owning once the transaction is done, taken from that insider's own Form 4. "Change" is the share of the holding before the transaction that the row added or removed: the holding before is worked out from the shares held after and the row's share count, for a purchase or a sale only. A first purchase reads "new", and a sale that leaves nothing reads −100%. Derivative rows, awards, gifts and other codes, rows the filing gives no holding for, and every congressional report have neither figure and show a dash, as does a filing whose numbers do not add up. A large negative change is a fact about the holding as filed; it says nothing about why the insider traded or whether the trade was a good one. The same two figures are in the CSV files as <code>shares_owned_after</code> and <code>holdings_change_pct</code>.</p>
  <p id="insider-summary"><strong>Insider buying and selling over 3 and 12 months.</strong> Each stock's page has a table of open-market trades by that company's insiders over the last 90 days and the last 365 days, counted back from the day the page was built. It counts Form 4 rows with code P (open-market purchase) and code S (open-market sale) only: awards, option exercises, gifts, shares withheld for tax, sales back to the company and every derivative row are left out, and a trade reported in more than one filing is counted once. A row belongs to a period by the date it was disclosed, not the date of the trade, so a late filing appears when it becomes public. Dollars are shares times the price on the filing; a row with no usable price adds shares but no dollars. "Net" is bought minus sold. The line for sales under a Rule 10b5-1 plan counts sales whose filing ticks the plan box. The table covers the insiders whose filings are on this site and says nothing about why anyone traded or what the share price will do.</p>
  <p id="footnotes"><strong>Form 4 footnotes.</strong> A Form 4 can carry footnotes: the range behind a weighted-average price, the date a trading plan was adopted, shares held through a trust, shares withheld for tax. Where a filing on record here has footnotes, each of its rows in a trade table carries a link such as "2 notes", and the text is printed once per filing, folded, under the table, word for word as filed (only spacing and character escapes are tidied). The site keeps a filing's footnotes as a list and does not record which row or box each one is attached to, so a note shown beside a row may be about another row of the same filing: the linked Form 4 shows where each note belongs. When a filing has more than {MAX_NOTES_PER_FILING} footnotes the first {MAX_NOTES_PER_FILING} are printed and the rest are counted. Nothing is read into a footnote: no flag, total or label on this site is derived from footnote text. Filings loaded from the SEC's quarterly data sets have no footnote text here yet, and footnotes are not in the CSV files.</p>
  <p id="downloads"><strong>Downloads.</strong> The CSV files on the <a href="/downloads/">downloads page</a> are written during the same build as the pages, from the same rows, so a file and its page cannot differ: a row that is held back from a page is held back from the file, and a row shown as under review carries <code>under_review = true</code>. Insider and lobbying files are cut by quarter; a transaction reported by two filers appears in each filer's rows and is marked so it can be counted once. No file contains individual donors or market prices.</p>
  <p id="member-pages"><strong>Member pages.</strong> Party, seat, term dates and current committee assignments come from the public-domain congress-legislators dataset and are refreshed daily. Every figure on a member's page is counted from the rows in that member's trade table: purchases and sales by the side stated on the report, years by the trade date, owners as the report names them, and dollar amounts as sums of the low and high ends of the ranges filed. The comparison sets one member beside all members with at least one trade on record here; it uses medians, and it leaves out members who reported no trades. Committee seats are shown for context and are never matched to trades.</p>
  <p id="member-directory"><strong>Member directory.</strong> The <a href="/congress-members/">directory</a> has one row for each member of Congress on record: sitting members from the roster, and members who filed a report and have since left office. "Trades" counts every transaction row from that member's reports on this site, and "Trades, 12 months" counts the rows disclosed in the last 365 days. The activity filter uses the disclosure date of the member's newest row. The committee filter lists members assigned to the committee or to one of its subcommittees, from the same roster data as the member pages. It is context only.</p>
  <p id="committees"><strong>Committee pages.</strong> Each full committee with a member on record has <a href="/congress-committees/">a page</a>: its current members, the tickers that appear most often in the reports they disclosed in the last 365 days, and their trades, newest disclosure first. A member who sits only on a subcommittee is listed under the full committee. The roster gives today's assignments and no history, so a committee's trades are every trade on record for its current members, including trades made before a member joined, and trades by members who have left the committee are not on its page. "Trades, 12 months" goes by disclosure date. Nothing on these pages compares a trade with a committee's work; a seat is context and not evidence about any trade.</p>
  <p id="lobbying-issues"><strong>Lobbying by issue.</strong> A lobbying report names one or more of the 79 general issue areas and states one amount for the quarter. Lobbying tables list every issue area a filing names. The <a href="/lobbying-issues/">issue pages</a> count a filing under every issue it names, so their rows add up to more than the number of filings, and the amount beside an issue is the total on the filings that name it: a filing that names several issues adds its whole amount to each. Those amounts overlap, are never added together on this site, and do not say what was spent on one issue. The chart on the <a href="/lobbying/">lobbying page</a> counts each filing once, under its first issue. Figures are for the current filing year, one row per registrant, client and period (the latest posted version of an amended report); registrations usually name no issue. The lobbying CSV files carry every issue code of each filing.</p>

  <h2 id="social">The daily thread</h2>
  <p>Once a day a scripted thread lists notable published filings (the largest by value, late filings, first filings, cluster buys) with a link to the page and to the source document. It contains facts and links only.</p>

  <h2 id="never">What this site never does</h2>
  <p>No buy or sell recommendations, no forward-looking scores, no trade execution or copy-trading, no inference of motive or wrongdoing from any filing. Historical performance, when shown, is computed only from disclosed trades against a stated benchmark and is not a prediction.</p>

  <h2 id="corrections">Corrections</h2>
  <p>Errors are fixed within five working days of a report; see <a href="/corrections/">the corrections page</a>.</p>

  <h2 id="coverage">What is covered, and what is not</h2>
  <p>These counts are rebuilt with every update of the site, straight from the database; the same figures, by source and month, are in <a href="/data/coverage.json">/data/coverage.json</a>.</p>
  <ul>
    <li><strong>House trades.</strong> {num(sum(houseYear.map((f) => f.filings)))} periodic transaction reports filed in {thisYear} are on file here{houseIndex != null ? <span>; the House Clerk's {thisYear} index lists {num(houseIndex)}</span> : null}. {num(sum(houseYear.map((f) => f.published)))} of ours are shown; {num(sum(houseYear.map((f) => f.filings - f.published)))} are held back, mostly scanned or handwritten reports that software cannot read reliably and a person has not yet transcribed. A member who files only on paper will be missing from the maps and tables until then.</li>
    <li><strong>Senate trades.</strong> {senate.length
      ? `${num(sum(senate.map((f) => f.filings)))} periodic transaction reports on file, received ${senate.filter((f) => f.month !== "none")[0]?.month ?? ""} to ${senate.filter((f) => f.month !== "none").slice(-1)[0]?.month ?? ""}; ${num(sum(senate.map((f) => f.published)))} are shown. The rest are paper filings awaiting transcription, earlier versions replaced by an amendment, or reports still under review. Senate reports are loaded in batches from saved copies, so the newest may lag the Senate's site by days.`
      : "None. The Senate's disclosure site blocks automated readers, and no Senate report has been ingested yet. Every \"Congress\" figure on this site is House only."}</li>
    <li><strong>Corporate insiders.</strong> {num(sum(form4.map((f) => f.filings)))} Form 4 filings on file, filed on or after {form4FloorText}, for the tracked tickers only ({num(model.counts.securities ?? 0)} securities), not every public company.</li>
    <li><strong>Lobbying.</strong> {span(cov.tables.lobbying)} (by reporting quarter).</li>
    <li><strong>Contracts.</strong> {span(cov.tables.contracts)}: the largest awards each month plus awards to followed companies, not every federal contract.</li>
    <li><strong>Donations.</strong> {span(cov.tables.donations)}: itemized receipts of tracked committees only.</li>
  </ul>
  {house.length > 0 && (
    <div class="table-wrap">
      <div class="tablewrap"><table class="data">
        <caption>House periodic transaction reports by month filed</caption>
        <thead><tr><th>Month filed</th><th class="num">On file</th><th class="num">Shown</th><th class="num">Held for review</th><th class="num">Of those, paper filings</th></tr></thead>
        <tbody>
          {house.map((f) => <tr><td>{monthLabel(f.month)}</td><td class="num">{num(f.filings)}</td><td class="num">{num(f.published)}</td><td class="num">{num(f.filings - f.published)}</td><td class="num">{num(f.paper)}</td></tr>)}
        </tbody>
      </table></div>
    </div>
  )}

  <h2 id="status">Data status</h2>
  <p class="mono small">people {num(model.counts.people ?? 0)} · companies {num(model.counts.companies ?? 0)} · securities {num(model.counts.securities ?? 0)} · filings {num(model.counts.filings ?? 0)} · transactions {num(model.counts.txns ?? 0)} · lobbying {num(model.counts.lobbying ?? 0)} · contracts {num(model.counts.contracts ?? 0)} · built {model.builtAt}</p>
  <JsonLd data={ld} />
</BaseLayout>
