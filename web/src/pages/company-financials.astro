---
// Company financials screener: /company-financials/. One row per company this site tracks, with
// the figures of its newest fiscal year or newest quarter as the company filed them with the SEC,
// filters (company or ticker, period, industry division, currency, revenue, net income above or
// below zero, total assets), sortable columns and a second set of columns with two ratios this
// site works out from the row's own amounts. Rules are in lib/finscreen.ts (unit-tested) and,
// for the figures themselves, lib/financials.ts. The page prints the first rows itself; the
// browser script (scripts/finscreen.ts) loads /data/financials-screener.json and takes over, so
// without JavaScript the first rows are still here and the controls are hidden.
// Not under /companies/: every /companies/<x>/ address is a company page.
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import Answer from "../components/Answer.astro";
import HubFigures from "../components/HubFigures.astro";
import JsonLd from "../components/JsonLd.astro";
import DownloadCsv from "../components/DownloadCsv.astro";
import { getDownloads } from "../lib/downloads";
import { getFlagship, num, plural } from "../lib/flagship";
import { datasetLd } from "../lib/seo";
import { siteFinScreen } from "../lib/finscreen-build";
import {
  finScreen, fsSummaryLine, fsCellText, fsPayText, fsShortDate, reportUrl, divisionPagePath, rowsFor, revMinLabel, revMaxLabel, assetMinLabel, stepLabel, firstFsDir,
  columnsOf, fsRatioText, ratioInputs, FS_COLUMNS, COLS, COLS_OPTION, RATIO_VIEW_NOTE,
  DEFAULT_FS_VIEW, DEFAULT_PER, PER_PAGE, PERIODS, PERIOD_OPTION, REV_MIN_STEPS, REV_MAX_STEPS, ASSET_MIN_STEPS, NI_SIGNS, NI_OPTION, FIN_SCREENER_DATA, RECENT_OPTION, RECENT_DAYS, type FsSortKey,
} from "../lib/finscreen";
import { MIN_IMPLIED_SHARES, RATIOS, RATIO_NA } from "../lib/financials";

const model = await getFlagship();
const { all, data } = siteFinScreen(model);
const first = finScreen(all, DEFAULT_FS_VIEW);
const years = rowsFor(all, "year"), quarters = rowsFor(all, "quarter");
const units = [...new Set(all.map((c) => c.unit))].sort((a, b) => (a === "USD" ? -1 : b === "USD" ? 1 : a.localeCompare(b)));
const notUsd = all.filter((c) => c.unit !== "USD").length;
const recentYears = years.filter((r) => r.p.recent).length, recentQuarters = quarters.filter((r) => r.p.recent).length;
const newestFiled = [...years, ...quarters].map((r) => r.p.filed).sort().at(-1) ?? null;
const lastUpdated = newestFiled ?? model.builtAt;

const answer = all.length === 0
  ? "No company financials are on file here yet. Figures are added as companies' annual and quarterly reports to the SEC are read."
  : `${plural(all.length, "company", "companies")} this site tracks ${all.length === 1 ? "has" : "have"} figures from annual or quarterly reports to the SEC in this table: ${num(years.length)} with a fiscal year on file and ${num(quarters.length)} with a quarter. ${notUsd === 0 ? "All report in U.S. dollars." : `${num(notUsd)} ${notUsd === 1 ? "reports" : "report"} in a currency other than the U.S. dollar.`} Every amount is the one the company filed.`;
const description = "Screen companies by figures from their SEC annual and quarterly reports: revenue, net income, earnings per share, total assets and equity, as filed.";
const csv = (await getDownloads()).files.find((f) => f.name === "company-financials.csv");
const ld = datasetLd({ downloads: [csv?.path], name: "Company financials screener: figures as filed with the SEC", path: "/company-financials/", description, dateModified: lastUpdated.slice(0, 10), keywords: ["company financials", "SEC filings", "10-K", "10-Q", "XBRL", "stock screener"], sources: [{ name: "SEC EDGAR: XBRL company facts", url: "https://www.sec.gov/search-filings/edgar-application-programming-interfaces" }], parentCatalogPath: "/" });
const HEAD = { company: "Company", end: "Fiscal year ended" };
const heldHref = "/methodology/#financials";
const th = (k: FsSortKey) => ({ k, label: HEAD[k as "company" | "end"], on: k === DEFAULT_FS_VIEW.sort });
const figureCols = columnsOf("figures");
const cap = (i: number) => RATIOS[i]!.cap.toLocaleString("en-US");
---
<BaseLayout title="Company Financials Screener: Figures From SEC Filings" description={description} section="Companies" noindex={all.length === 0}>
  <Crumbs crumbs={[{ name: "Home", path: "/" }, { name: "Stocks and companies", path: "/stocks/" }, { name: "Financials screener", path: "/company-financials/" }]} />
  <h1>Company financials screener</h1>
  <p class="lede">The newest fiscal year or quarter of each company this site tracks, in one table, as the company filed it with the SEC. Narrow it by industry, currency, revenue, net income and total assets, and sort any column.</p>

  <Answer text={answer} updated={lastUpdated} sourceNote="Source: companies' annual and quarterly reports to the SEC (XBRL company facts); SEC industry codes" />
  <HubFigures items={[{k:"Companies",v:num(all.length)},{k:"With a fiscal year",v:num(years.length)},{k:"With a quarter",v:num(quarters.length)},{k:"Newest filing",v:(newestFiled ?? "").slice(0,10)}]} />

  {all.length === 0 ? <p class="empty-reason">No company financials on file yet.</p> : (
    <div class="finscreen" data-finscreen data-src={FIN_SCREENER_DATA} data-held-href={heldHref} data-total={years.length}>
      <div class="controls fs-controls" role="group" aria-label="Filter companies">
        <div class="ctl"><label class="lbl" for="fs-q">Company or ticker</label><input id="fs-q" class="hm-input" data-fs="q" type="search" placeholder="Company or ticker" autocomplete="off" maxlength="60" /></div>
        <div class="ctl"><span class="lbl">Period</span>
          <select data-fs="period" aria-label="Which period the table shows">{PERIODS.map((p) => <option value={p}>{PERIOD_OPTION[p]}</option>)}</select>
        </div>
        <div class="ctl"><span class="lbl">Period end</span>
          <select data-fs="recent" aria-label="How long ago the period ended"><option value="0">Any period end</option><option value="1">{RECENT_OPTION}</option></select>
        </div>
        {data.divisions.length > 0 && (
          <div class="ctl"><span class="lbl">Industry</span>
            <select data-fs="division" aria-label="Industry division, as the SEC classifies the company"><option value="">Any industry</option>{data.divisions.map((d) => <option value={d.slug}>{d.name}</option>)}</select>
          </div>
        )}
        {units.length > 1 && (
          <div class="ctl"><span class="lbl">Currency</span>
            <select data-fs="unit" aria-label="Currency the company reports in"><option value="">Any currency</option>{units.map((u) => <option value={u}>{u === "USD" ? "U.S. dollars" : u}</option>)}</select>
          </div>
        )}
        <div class="ctl"><span class="lbl">Revenue, at least</span>
          <select data-fs="rmin" aria-label="Revenue at least, in U.S. dollars"><option value="0">Any revenue</option>{REV_MIN_STEPS.map((s) => <option value={s}>{revMinLabel(s)}</option>)}</select>
        </div>
        <div class="ctl"><span class="lbl">Revenue, at most</span>
          <select data-fs="rmax" aria-label="Revenue at most, in U.S. dollars"><option value="0">No upper limit on revenue</option>{REV_MAX_STEPS.map((s) => <option value={s}>{revMaxLabel(s)}</option>)}</select>
        </div>
        <div class="ctl"><span class="lbl">Net income</span>
          <select data-fs="ni" aria-label="Net income above or below zero"><option value="">Any net income</option>{NI_SIGNS.map((k) => <option value={k}>{NI_OPTION[k]}</option>)}</select>
        </div>
        <div class="ctl"><span class="lbl">Executive pay</span>
          <select data-fs="pay" aria-label="Executive pay on file"><option value="0">Any executive pay</option><option value="1">Has pay on file</option></select>
        </div>
        <div class="ctl"><span class="lbl">Total assets</span>
          <select data-fs="amin" aria-label="Total assets at least, in U.S. dollars"><option value="0">Any total assets</option>{ASSET_MIN_STEPS.map((s) => <option value={s}>{assetMinLabel(s)}</option>)}</select>
        </div>
        <div class="ctl"><span class="lbl">Columns</span>
          <select data-fs="cols" aria-label="Which columns the table shows">{COLS.map((c) => <option value={c}>{COLS_OPTION[c]}</option>)}</select>
        </div>
      </div>
      <p class="section-note fs-count"><span data-fs="count" aria-live="polite">{fsSummaryLine(first, "year")}</span> <button type="button" class="linklike" data-fs="reset" hidden>Reset filters</button></p>
      <DownloadCsv file={csv} note="every fiscal year and quarter on file for every company, not only the rows filtered here" />
      <p class="dl-row fs-dl"><button type="button" class="dl" data-fs="download">Download these rows (CSV)</button> <span class="dl-meta">The companies that match the filters, in the order shown, every page. The file is made in your browser; nothing is sent anywhere.</span></p>

      <p class="section-note fs-rationote" data-fs="rationote" hidden>{RATIO_VIEW_NOTE}</p>

      <div class="tablewrap"><table class="data fs-table">
        <thead><tr>
          {[th("company")].map((x) => <th aria-sort="none" data-sort={x.k}><button type="button" class="sort" aria-label="Sort by company">{x.label}<span class="arr" aria-hidden="true"></span></button></th>)}
          <th>Industry</th>
          <th aria-sort="none" data-sort="end"><button type="button" class="sort"><span data-fs="endhead">{HEAD.end}</span><span class="arr" aria-hidden="true"></span></button></th>
          {FS_COLUMNS.map((c) => {
            const on = c.key === DEFAULT_FS_VIEW.sort, off = !c.views.includes("figures");
            if (c.kind === "payyear") return <th data-cols={c.views.join(" ")} hidden={off}>{c.label}</th>;
            return (
              <th class="num" aria-sort={on ? "descending" : "none"} data-sort={c.key} data-first={firstFsDir(c.key as FsSortKey)} data-cols={c.views.join(" ")} hidden={off}>
                <button type="button" class="sort" aria-label={`Sort by ${c.kind === "pay" ? c.label : c.label.toLowerCase()}`}>{c.label}<span class="arr" aria-hidden="true">{on ? "▼" : ""}</span></button>
                {c.kind === "ratio" && <span class="fs-inputs">{ratioInputs(c.key)}</span>}
              </th>
            );
          })}
          <th>Report</th>
        </tr></thead>
        <tbody data-fs="rows">
          {first.rows.map((r) => (
            <tr data-cik={r.c.cik}>
              <td><span class="ent">{r.c.path ? <a href={r.c.path}>{r.c.name}</a> : r.c.name}{r.c.ticker && <span class="tk"> {r.c.ticker}</span>}</span></td>
              <td>{r.c.division && <a href={divisionPagePath(r.c.division.slug)}>{r.c.division.name}</a>}</td>
              <td class="mono">{fsShortDate(r.p.end)}</td>
              {figureCols.map((c) => c.kind === "pay" ? <td class="num" data-pay>{fsPayText(r.c)}</td>
                : c.kind === "payyear" ? <td class="mono" data-payyear>{r.c.pay ? fsShortDate(r.c.pay.fye) : ""}</td>
                : c.kind === "ratio" ? <td class="num" data-ratio={c.key}>{fsRatioText(r, c.key)}</td>
                : r.p.held[c.key]
                ? <td class="num" data-held><a class="soft" href={heldHref}>{fsCellText(r, c.key)}</a></td>
                : <td class={`num${c.key === "revenue" ? " strong" : ""}`}>{fsCellText(r, c.key)}</td>)}
              <td class="mono">{reportUrl(r) ? <a href={reportUrl(r)} rel="noopener nofollow" target="_blank" title={`Filed ${fsShortDate(r.p.filed)}`}>{`${r.p.form} ↗`}</a> : r.p.form}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
      <p class="empty-reason" data-fs="empty" hidden>No company matches these filters. <button type="button" class="linklike" data-fs="reset2">Clear the filters</button></p>
      <div class="fs-pager" data-fs="pager">
        <button type="button" class="chip" data-fs="prev" disabled>Previous</button>
        <span data-fs="pageinfo" class="soft">Page 1 of {num(first.pages)}</span>
        <button type="button" class="chip" data-fs="next" disabled={first.pages <= 1}>Next</button>
        <label class="fs-per soft">Rows per page <select data-fs="per" aria-label="Rows per page">{PER_PAGE.map((p) => <option value={p} selected={p === DEFAULT_PER}>{p}</option>)}</select></label>
      </div>
      <noscript><p class="section-note">These are the first {num(first.rows.length)} of {num(years.length)} companies, by revenue of the newest fiscal year. The filters need JavaScript; the CSV file above has every company and period.</p></noscript>
    </div>
  )}

  <details class="ref" data-remember id="ref-about"><summary><h2 id="about">What this table shows</h2></summary><div class="ref-body">
  <p>One row for each company this site tracks whose annual or quarterly reports to the SEC are on file here. "Newest fiscal year" shows the latest full fiscal year the company has reported; "Newest quarter" shows the latest quarter it has reported on its own. The columns are revenue, net income, diluted earnings per share, total assets and shareholders' equity, each exactly as the company filed it, with the last day of the period and a link to the newest report the figures were taken from (its form, for example 10-K or 10-Q; the filing date is in the download). Companies have different fiscal years, so the periods in one view do not all end on the same day: the "ended" column says which period each row is.</p>
  <p id="recent">A company stays in the table with the last fiscal year or quarter it reported, however long ago that was, so a few rows are old: a company that was taken over, stopped filing or changed its reporting keeps its final period. "{RECENT_OPTION}", under Period end, leaves those rows out. It keeps a row whose period ended at most {num(RECENT_DAYS)} days before the day this page was built; {num(recentYears)} of the {num(years.length)} fiscal years and {num(recentQuarters)} of the {num(quarters.length)} quarters do. Eighteen months is wide on purpose: an annual report arrives two to three months after the year ends, and the year it covers stays the newest for twelve months after that. The filter goes by the date alone and says nothing about a company.</p>
  <p>No amount here is estimated or converted, and the columns the table opens on hold filed figures only. An empty cell means the report gave no such figure under a heading this site reads. A fourth fiscal quarter is not filed on its own, so "Newest quarter" is never a fourth quarter. "not shown" marks a figure this site holds back because, as stored, it fails one of three checks (for example earnings per share that would mean fewer than {num(MIN_IMPLIED_SHARES)} shares); the <a href="/methodology/#financials">methodology</a> lists them, and the <a href="/downloads/">CSV file</a> keeps the filed figure. A held-back figure passes no filter on its column.</p>
  <p id="currencies">Amounts are in the currency the company reports in, and that currency is printed with every amount that is not in U.S. dollars. The revenue and total-assets filters are in U.S. dollars: "{revMinLabel(REV_MIN_STEPS[1])}" keeps companies whose filed revenue for the period is {stepLabel(REV_MIN_STEPS[1])} or higher, and a company that reports in another currency passes neither filter, because this site converts nothing. For the same reason, sorting by an amount lists the dollar figures first and the others, with empty cells, after them. "{NI_OPTION.pos}" and "{NI_OPTION.neg}" go by the sign of the filed figure and cover every currency.</p>
  <p>The industry is the division of the SEC's industry code (SIC) for the company, the same label as on the <a href="/industries/">industry pages</a>; it is a classification, not a judgement. Sorting a column orders the companies by what that column holds and by nothing else. This table has no score, rating or forecast, and no figure that needs a share price. "CEO pay, as reported" is the principal executive officer's total in the Summary Compensation Table, from the Pay Versus Performance table of the company's proxy statement, for the newest fiscal year the company has one for; "Pay year" is the last day of that fiscal year. Pay is in dollars as the company tagged it for the SEC, belongs to the company rather than to the period shown, and is not set against any other figure here; a company with none on file shows an empty cell and sorts last. The <a href="/executive-pay/">executive pay page</a> has all four figures. A company's page has more: three fiscal years and four quarters, cash and total liabilities, and cash flow for fiscal years. How the figures are read: <a href="/methodology/#financials-screener">methodology</a>. What the figures are: <a href="/guides/what-is-form-4/#financials">the guide</a>.</p>
  <p id="ratios">"{COLS_OPTION.ratios}", under Columns, swaps part of the table for two ratios this site works out, each placed right after the two amounts it comes from. Net margin is {ratioInputs("net_margin")} for the period, as a percentage. Liabilities to equity is {ratioInputs("liabilities_to_equity")} on the last day of the period; total liabilities is shown in that view for this purpose, and is empty where the report gives no such total. They are the same two ratios, worked out the same way, as at the foot of the tables on a company's page: arithmetic on two amounts of one row, not figures the company filed. An empty cell means one of the two amounts is missing or not shown. "{RATIO_NA}" means revenue was zero or below, or equity was zero or negative, where the result would say nothing. A net margin beyond {cap(0)}% either way, or a liabilities to equity figure above {cap(1)}, is printed in words ("over {cap(0)}%"), because it comes from a period with almost no revenue or almost no equity; the download has the number. A ratio needs no currency, so sorting by one takes in every company with both amounts, whatever it reports in, with "{RATIO_NA}" and empty cells last. The order is by that one worked-out number and is no verdict on any company: what is usual differs widely between industries, and a bank or an insurer normally carries liabilities many times its equity. There is no filter on a ratio.</p>
  </div></details>
  <AdSlot />

  <p class="disclaimer"><strong>Not investment advice.</strong> Figures shown as filed with the SEC; no judgement about any company is made or implied.</p>
  <JsonLd data={ld} />
</BaseLayout>

<style>
  .fs-controls .hm-input { width: 200px; }
  .fs-controls select { max-width: 290px; }
  .fs-count { margin: 0 0 var(--s-1); }
  .fs-rationote { margin: 0 0 var(--s-2); max-width: 78ch; }
  .fs-rationote[hidden] { display: none; }
  .fs-table th[hidden] { display: none; }
  .fs-inputs { display: block; margin-left: auto; width: 15ch; font-size: var(--t-xs); line-height: 1.25; font-weight: 400; color: var(--ink-soft); white-space: normal; }
  .fs-rationote { margin-top: var(--s-2); }
  .fs-dl { margin-top: 0; }
  .fs-dl button.dl { display: inline-flex; align-items: center; height: 32px; padding: 0 var(--s-3); border: 1px solid var(--line-2); border-radius: var(--r-1); color: var(--accent); font: inherit; font-size: var(--t-sm); font-weight: 400; background: var(--surface); cursor: pointer; }
  .fs-dl button.dl:hover { background: var(--chip); }
  .fs-dl button.dl:disabled { opacity: 0.45; cursor: default; }
  :global(html:not(.js)) .fs-dl { display: none; }
  .fs-pager { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); margin: var(--s-2) 0 var(--s-4); font-size: var(--t-sm); }
  .fs-pager button.chip { font: inherit; font-size: var(--t-xs); color: var(--ink); background: transparent; border: 1px solid var(--line-2); border-radius: var(--r-pill); height: 28px; padding: 0 var(--s-3); cursor: pointer; }
  .fs-pager button.chip:disabled { opacity: 0.45; cursor: default; }
  .fs-pager[hidden] { display: none; }
  .fs-per { margin-left: auto; display: inline-flex; align-items: center; gap: var(--s-1); }
  .linklike { font: inherit; color: var(--signal); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
  .finscreen[data-loading] .fs-table { opacity: 0.6; }
  :global(html:not(.js)) .fs-controls, :global(html:not(.js)) .fs-pager { display: none; }
</style>
<script>
  import "../scripts/finscreen";
</script>
