---
// Ticker page: /stocks/<ticker>/ — insider and congressional activity in one security.
import LearnMore from "../../components/LearnMore.astro";
import { insiderRows, memberRows, codeRows, relatedTickers, sizeOf } from "../../lib/entity";
import DownloadCsv from "../../components/DownloadCsv.astro";
import { getDownloads } from "../../lib/downloads";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SourcePanel from "../../components/SourcePanel.astro";
import AdSlot from "../../components/AdSlot.astro";
import Crumbs from "../../components/Crumbs.astro";
import Answer from "../../components/Answer.astro";
import ReviewNote from "../../components/ReviewNote.astro";
import TxnTable from "../../components/TxnTable.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getFlagship, securityPath, companyPath, personPath, withinDays, num, plural, money, sum, senateShown } from "../../lib/flagship";
import { datasetLd, SOURCES, fitDescription } from "../../lib/seo";
import { formatDate } from "../../lib/format";
import VizStock from "../../components/VizStock.astro";
import TradingView from "../../components/TradingView.astro";

export async function getStaticPaths() {
  const model = await getFlagship();
  // One page per ticker; prefer the equity row when several types share a ticker (option/etf).
  const byTicker = new Map<string, number>();
  for (const s of [...model.securities.values()].sort((a, b) => (a.type === "equity" ? -1 : 1) - (b.type === "equity" ? -1 : 1))) {
    const key = s.ticker.toLowerCase();
    if (!byTicker.has(key)) byTicker.set(key, s.id);
  }
  return [...byTicker.entries()].map(([ticker, id]) => ({ params: { ticker }, props: { id } }));
}

const { id } = Astro.props as { id: number };
const model = await getFlagship();
const hasSenate = senateShown(model);
const s = model.securities.get(id)!;
const siblings = [...model.securities.values()].filter((x) => x.ticker.toLowerCase() === s.ticker.toLowerCase());
const txns = siblings.flatMap((x) => x.txns).sort((a, b) => (b.disclosedAt ?? "").localeCompare(a.disclosedAt ?? ""));
const insider = txns.filter((t) => t.source === "sec_form4");
const congress = txns.filter((t) => t.source !== "sec_form4");
const path = securityPath(s);
const company = s.companyId != null ? model.companies.get(s.companyId) : undefined;
const cpath = company ? companyPath(company) : null;
const y = txns.filter((t) => withinDays(t.disclosedAt, 365));
const yIns = y.filter((t) => t.source === "sec_form4");
const yCon = y.filter((t) => t.source !== "sec_form4");
const insiders = new Set(yIns.map((t) => t.personId));
const members = new Set(yCon.map((t) => t.personId));
const buys = yIns.filter((t) => t.code === "P").length;
const sells = yIns.filter((t) => t.side === "sell").length;
const underReview = siblings.some((x) => x.underReview);
const lastUpdated = txns[0]?.filedAt ?? model.builtAt;
const name = company?.name ?? s.name ?? s.ticker;
const downloads = await getDownloads();
const insiderList = insiderRows(model, insider);
const memberList = memberRows(model, congress);
const codes = codeRows(insider);
const related = relatedTickers(model, s.ticker, txns);
const size = sizeOf(model, s.ticker);
const lastTrade = txns.map((t) => t.txnDate).filter(Boolean).sort().at(-1) ?? null;
const WHO_ROWS = 15;
const jump: [string, string][] = txns.length === 0 ? [] : [
  ...(insiderList.length ? [["#insiders", "Insiders"] as [string, string]] : []),
  ...(memberList.length ? [["#members", "Members of Congress"] as [string, string]] : []),
  ...(insider.length ? [["#insider-transactions", "Insider transactions"] as [string, string]] : []),
  ...(congress.length ? [["#congress-trades", "Congress trades"] as [string, string]] : []),
  ...(related.length ? [["#related", "Related stocks"] as [string, string]] : []),
  ["#sources", "Sources"],
];

const answer = txns.length === 0
  ? `${s.ticker} (${name}) is in the tracked set but has no disclosed insider or congressional transactions that met the publishing bar yet. Rows appear here the day after they are filed.`
  : `${s.ticker} (${name}) has ${plural(yIns.length, "disclosed insider transaction")} from ${plural(insiders.size, "insider")} in the last 12 months (${plural(buys, "open-market buy")}, ${plural(sells, "sale")}, about ${money(sum(yIns.map((t) => t.value)))} at reported prices) and ${plural(yCon.length, "congressional trade")} from ${plural(members.size, "member")} of Congress. The most recent disclosure was filed ${formatDate(txns[0]!.filedAt)}.`;

const description = fitDescription([
  `${s.ticker} (${name}) insider trades and congressional stock trades: SEC Form 4 and STOCK Act disclosures on record, with dates, values and source links.`,
  `${s.ticker} insider trades and congressional stock trades: SEC Form 4 and STOCK Act disclosures on record, with dates, values and source links.`,
]);
const ld = datasetLd({ downloads: [downloads.stock.get(s.ticker.toLowerCase())?.path], name: `${s.ticker} insider and congressional transactions`, path, description, dateModified: lastUpdated.slice(0, 10),
  keywords: [s.ticker, name, "insider trading", "Form 4", "congressional stock trades", "STOCK Act"], sources: [SOURCES.edgar, SOURCES.house], parentCatalogPath: "/stocks/" });
---
<BaseLayout title={[`${s.ticker} Insider Trades & Congress Trades — ${name}`, `${s.ticker} Insider & Congress Trades — ${name}`, `${s.ticker} Insider Trades & Congress Trades`]} description={description} noindex={txns.length === 0} section="Stocks">
  <Crumbs crumbs={[{ name: "Home", path: "/" }, { name: "Stocks", path: "/stocks/" }, { name: s.ticker, path }]} />
  <p class="eyebrow">Stock <span class="x">/</span> {s.type}</p>
  <h1><span class="mono">{s.ticker}</span> <span class="soft">{name}</span></h1>
  <dl class="facts" data-entity-facts>
    {company && <div><dt>Company</dt><dd>{cpath ? <a href={cpath}>{company.name}</a> : company.name}</dd></div>}
    <div><dt>Security</dt><dd>{s.type === "etf" ? "ETF" : s.type === "adr" ? "ADR" : s.type.charAt(0).toUpperCase() + s.type.slice(1)}</dd></div>
    {size && <div><dt>Size, estimated from filings</dt><dd>{size.label} ({size.range})</dd></div>}
    {insiderList.length > 0 && <div><dt>Insiders on record</dt><dd><a href="#insiders">{num(insiderList.length)}</a></dd></div>}
    {memberList.length > 0 && <div><dt>Members of Congress</dt><dd><a href="#members">{num(memberList.length)}</a></dd></div>}
    {lastTrade && <div><dt>Latest trade on record</dt><dd>{formatDate(lastTrade)}</dd></div>}
  </dl>

  <Answer text={answer} updated={lastUpdated} sourceNote={hasSenate ? "Sources: SEC EDGAR Form 4; House Clerk and Senate eFD PTRs" : "Sources: SEC EDGAR Form 4; House Clerk PTRs"} />
  <ReviewNote show={underReview} what="Some rows on this page" />

  {jump.length > 0 && (
    <nav class="jump" aria-label="On this page">
      <span>On this page</span>
      {jump.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
  )}

  <section class="datastrip">
    <div class="cell"><div class="k">Insider txns (12m)</div><div class="v">{num(yIns.length)}</div></div>
    <div class="cell"><div class="k">Open-market buys / sales</div><div class="v"><span class="pos">{num(buys)}</span> / <span class="neg">{num(sells)}</span></div></div>
    <div class="cell"><div class="k">Congress trades (12m)</div><div class="v">{num(yCon.length)}</div></div>
    <div class="cell"><div class="k">Distinct filers (12m)</div><div class="v">{num(insiders.size + members.size)}</div></div>
  </section>

  {["equity", "etf", "adr"].includes(s.type) && <TradingView symbol={s.ticker} name={name} />}

  <VizStock security={s} company={company ?? null} />

  {insiderList.length > 0 && (
    <section aria-labelledby="insiders" data-entity-insiders>
      <h2 id="insiders">Insiders trading {s.ticker}</h2>
      <p class="section-note">Everyone who filed a Form 4 for this ticker, by number of rows on record. "Bought" and "sold" count open-market purchases (code P) and sales only; awards, option exercises and shares withheld for tax are in the row count but not in those two columns.{insiderList.length > WHO_ROWS && ` Showing ${WHO_ROWS} of ${num(insiderList.length)}.`}</p>
      <div class="tablewrap">
        <table class="data">
          <thead><tr><th>Insider</th><th>Role</th><th class="num">Rows</th><th class="num">Bought</th><th class="num">Sold</th><th class="num">Value bought</th><th class="num">Value sold</th><th>Latest</th></tr></thead>
          <tbody>
            {insiderList.slice(0, WHO_ROWS).map((r) => (
              <tr><th scope="row">{r.path ? <a href={r.path}>{r.person.name}</a> : r.person.name}</th><td>{r.role}</td><td class="num">{num(r.rows)}</td><td class="num">{num(r.buys)}</td><td class="num">{num(r.sells)}</td><td class="num">{r.bought ? money(r.bought) : "—"}</td><td class="num">{r.sold ? money(r.sold) : "—"}</td><td class="mono">{r.last ? formatDate(r.last) : "—"}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      {codes.length > 1 && (
        <details class="dict">
          <summary>What kind of transactions these are <span>{num(codes.length)} Form 4 codes</span></summary>
          <div class="tablewrap">
            <table class="data" data-entity-codes>
              <thead><tr><th>Code</th><th>Meaning</th><th class="num">Rows</th><th class="num">Shares</th><th class="num">Value at reported prices</th></tr></thead>
              <tbody>{codes.map((c) => <tr><th scope="row" class="mono">{c.code}</th><td>{c.label}</td><td class="num">{num(c.rows)}</td><td class="num">{num(c.shares)}</td><td class="num">{c.value ? money(c.value) : "—"}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="section-note">What each code means: <a href="/guides/form-4-transaction-codes/">Form 4 transaction codes</a>.</p>
        </details>
      )}
    </section>
  )}

  {memberList.length > 0 && (
    <section aria-labelledby="members" data-entity-members>
      <h2 id="members">Members of Congress trading {s.ticker}</h2>
      <p class="section-note">Members whose periodic transaction reports name this ticker. Amounts are the sums of the ranges as filed.{memberList.length > WHO_ROWS && ` Showing ${WHO_ROWS} of ${num(memberList.length)}.`}</p>
      <div class="tablewrap">
        <table class="data">
          <thead><tr><th>Member</th><th>Seat</th><th class="num">Trades</th><th class="num">Bought</th><th class="num">Sold</th><th class="num">Range as filed</th><th>Latest</th></tr></thead>
          <tbody>
            {memberList.slice(0, WHO_ROWS).map((r) => (
              <tr><th scope="row">{r.path ? <a href={r.path}>{r.person.name}</a> : r.person.name}</th><td>{r.seat}</td><td class="num">{num(r.trades)}</td><td class="num">{num(r.buys)}</td><td class="num">{num(r.sells)}</td><td class="num">{money(r.low)}–{money(r.high)}</td><td class="mono">{r.last ? formatDate(r.last) : "—"}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <DownloadCsv file={downloads.stock.get(s.ticker.toLowerCase())} note="insider and congressional rows for this ticker" />

  <h2 id="insider-transactions">Insider transactions</h2>
  <TxnTable model={model} txns={insider} showPerson emptyReason="No Form 4 transactions for this ticker in the tracked window yet." />

  <AdSlot label="Advertisement" />

  <h2 id="congress-trades">Congressional trades</h2>
  <TxnTable model={model} txns={congress} showPerson emptyReason={hasSenate ? "No member of Congress has disclosed a trade in this ticker in the filings we have parsed." : "No member of Congress has disclosed a trade in this ticker in the filings we have parsed (House filings since the job went live; Senate pending)."} />

  {related.length > 0 && (
    <section aria-labelledby="related" data-related>
      <h2 id="related">Related stocks</h2>
      <p class="section-note">Tickers traded by the same people who traded {s.ticker}, by number of filers in common. It shows overlap in public filings and nothing else.</p>
      <ul class="mates two">
        {related.map((r) => <li><span><a class="mono" href={r.path}>{r.ticker}</a> {r.name && <span class="soft">{r.name}</span>}</span> <span>{plural(r.shared, "filer")} in common</span></li>)}
      </ul>
    </section>
  )}

  <LearnMore slugs={[...(insider.length ? ["what-is-form-4", "form-4-transaction-codes", "insider-buying-vs-insider-selling"] : []), ...(congress.length ? ["how-to-read-a-congressional-trade-report", "congress-trade-amount-ranges"] : []), "what-disclosure-data-cannot-tell-you"].slice(0, 5)} />

  <h2 id="sources">Sources and method</h2>
  <SourcePanel model={model} txns={txns} edgarId={s.ticker} />
  <p>Insider rows are Form 4 filings for this issuer from SEC EDGAR; congressional rows are periodic transaction reports parsed from the House Clerk and the Senate eFD. Values use the reported price for Form 4 and the disclosed range for Congress. See <a href="/methodology/">methodology</a> and <a href="/corrections/">corrections</a>.</p>
  <p class="disclaimer"><strong>Not investment advice.</strong> Disclosures are shown as filed and may lag the trade or be amended. No recommendation is made or implied.</p>
  <JsonLd data={ld} />
</BaseLayout>
