---
// /watchlist/ — a signed-in visitor's lists and the trades disclosed by what they follow
// (2026-10-10, item 4). Static shell; src/scripts/watchlist.ts fills it from /api/*. noindex: it
// shows nothing to a search engine.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Crumbs from "../../components/Crumbs.astro";
---
<BaseLayout title="Your watchlist | Spot the Money" description="Follow members of Congress, corporate insiders, stocks and companies, and see their newly disclosed trades in one place." noindex={true} section="Watchlist">
  <Crumbs crumbs={[{ name: "Home", path: "/" }, { name: "Watchlist", path: "/watchlist/" }]} />
  <h1>Your watchlist</h1>
  <div data-watchlist>
    <div data-wl-msg></div>
    <div data-wl-signed-out hidden>
      <p class="lede">Follow a member of Congress, a corporate insider, a stock or a company, and every trade they disclose shows up here, with the ones that are new since your last visit at the top.</p>
      <p data-wl-off hidden class="note">Accounts are not switched on yet. Check back soon.</p>
      <p><a class="btn btn-solid" data-wl-signin href="/auth/login?return=%2Fwatchlist%2F">Sign in or create a free account</a></p>
      <p class="soft">Sign in with a code sent to your email, or with your Google, Microsoft or GitHub account. No password, no payment. You can share a list with a link, or delete your account and everything in it at any time. See the <a href="/privacy/#accounts">privacy policy</a> for what an account keeps.</p>
      <noscript><p class="note">Watchlists need JavaScript.</p></noscript>
    </div>
    <div data-wl-body hidden></div>
  </div>
  <script>
    import "../../scripts/watchlist";
  </script>
</BaseLayout>
