---
// Executive pay: /executive-pay/. One row per company with a page here and at least one Pay Versus
// Performance figure, showing its newest fiscal year as the company tagged it. Filters (company or
// ticker, industry division, fiscal year, principal executive officer total at least) and sortable
// columns. Rules are in lib/execpay.ts (unit-tested). The page prints the first rows itself;
// scripts/execpay.ts loads /data/executive-pay.json and takes over, so without JavaScript the first
// rows are still here and the controls are hidden. No person is named anywhere on this page.
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import Answer from "../components/Answer.astro";
import JsonLd from "../components/JsonLd.astro";
import DownloadCsv from "../components/DownloadCsv.astro";
import { getDownloads } from "../lib/downloads";
import { getFlagship, num, plural } from "../lib/flagship";
import { datasetLd } from "../lib/seo";
import { sitePayHub } from "../lib/execpay-build";
import {
  unpackPayHub, payScreen, paySummaryLine, payCoverageSentence, fiscalYearOptions, payMoney, payMarked, payFilingUrl, shortDate, firstPayDir,
  DEFAULT_PAY_VIEW, DEFAULT_PER, PER_PAGE, MIN_STEPS, MIN_LABEL, PAY_KEYS, PAY_COLUMN_LABEL, PAY_CAVEAT, PAY_MARK_NOTE, PAY_DATA,
} from "../lib/execpay";

const model = await getFlagship();
const { data } = sitePayHub(model);
const all = unpackPayHub(data);
const first = payScreen(all, DEFAULT_PAY_VIEW);
const years = fiscalYearOptions(all);
const lastUpdated = model.execPay.newestYearEnd ?? model.builtAt;
const coverage = payCoverageSentence(all.length, data.pages);
const answer = all.length === 0
  ? "No executive pay figures are on file here yet. They are added as companies' proxy statements are read from SEC data."
  : `${plural(all.length, "company", "companies")} with a page on this site ${all.length === 1 ? "has" : "have"} Pay Versus Performance figures on file. Each row shows the newest fiscal year: what the principal executive officer's total in the Summary Compensation Table and compensation actually paid were, and the average for the other named executive officers, as the company tagged them.`;
const description = "Executive pay as companies filed it: principal executive officer and other named officers, total and compensation actually paid, by fiscal year.";
const csv = (await getDownloads()).files.find((f) => f.name === "executive-pay.csv");
const ld = datasetLd({ downloads: [csv?.path], name: "Executive pay as filed: Pay Versus Performance figures", path: "/executive-pay/", description, dateModified: lastUpdated.slice(0, 10), keywords: ["executive pay", "pay versus performance", "compensation actually paid", "proxy statement", "SEC filings"], sources: [{ name: "SEC EDGAR: XBRL financial statement data (ecd taxonomy)", url: "https://www.sec.gov/search-filings/edgar-application-programming-interfaces" }], parentCatalogPath: "/" });
const HEAD = { company: "Company", year: "Fiscal year ending", ...PAY_COLUMN_LABEL } as const;
---
<BaseLayout title="Executive Pay: Pay Versus Performance, As Filed" description={description} section="Companies" noindex={all.length === 0}>
  <Crumbs crumbs={[{ name: "Home", path: "/" }, { name: "Stocks and companies", path: "/stocks/" }, { name: "Executive pay", path: "/executive-pay/" }]} />
  <h1>Executive pay</h1>
  <p class="lede">The newest fiscal year of executive pay for each company on this site that has filed it, from the Pay Versus Performance table of its proxy statement. Narrow the list by industry, fiscal year and size of the principal executive officer's total, and sort any column.</p>

  <Answer text={answer} updated={lastUpdated} sourceNote="Source: SEC EDGAR XBRL data, Pay Versus Performance (ecd taxonomy); SEC industry codes" />

  {all.length === 0 ? <p class="empty-reason">No executive pay figures on file yet.</p> : (
    <div class="paycompare" data-paycompare data-src={PAY_DATA} data-total={all.length}>
      <p class="pay-coverage" data-pay-coverage>{coverage}</p>
      <div class="controls pc-controls" role="group" aria-label="Filter companies">
        <div class="ctl"><label class="lbl" for="pc-q">Company or ticker</label><input id="pc-q" class="hm-input" data-pc="q" type="search" placeholder="Company or ticker" autocomplete="off" maxlength="60" /></div>
        {data.divisions.length > 0 && (
          <div class="ctl"><span class="lbl">Industry</span>
            <select data-pc="division" aria-label="Industry division, as the SEC classifies the company"><option value="">Any industry</option>{data.divisions.map((d) => <option value={d.slug}>{d.name}</option>)}</select>
          </div>
        )}
        <div class="ctl"><span class="lbl">Fiscal year</span>
          <select data-pc="fy" aria-label="Calendar year in which the fiscal year ends"><option value="">Any fiscal year</option>{years.map((y) => <option value={y.fy}>{y.fy} ({y.companies})</option>)}</select>
        </div>
        <div class="ctl"><span class="lbl">Principal executive officer total</span>
          <select data-pc="min" aria-label="Principal executive officer total in the Summary Compensation Table, at least"><option value="0">Any total</option>{MIN_STEPS.map((s) => <option value={s}>{MIN_LABEL[s]}</option>)}</select>
        </div>
      </div>
      <p class="section-note pc-count"><span data-pc="count" aria-live="polite">{paySummaryLine(first)}</span> <button type="button" class="linklike" data-pc="reset" hidden>Reset filters</button></p>
      <DownloadCsv file={csv} note="every company and fiscal year on file, not only the rows filtered here" />
      <p class="dl-row pc-dl"><button type="button" class="dl" data-pc="download">Download these rows (CSV)</button> <span class="dl-meta">The companies that match the filters, in the order shown, every page. The file is made in your browser; nothing is sent anywhere.</span></p>

      <div class="tablewrap"><table class="data pc-table">
        <thead><tr>
          <th aria-sort="none" data-sort="company" data-first="asc"><button type="button" class="sort" aria-label="Sort by company">{HEAD.company}<span class="arr" aria-hidden="true"></span></button></th>
          <th>Industry</th>
          <th aria-sort="none" data-sort="year" data-first="desc"><button type="button" class="sort" aria-label="Sort by fiscal year ending">{HEAD.year}<span class="arr" aria-hidden="true"></span></button></th>
          {PAY_KEYS.map((k) => (
            <th class="num" aria-sort={k === DEFAULT_PAY_VIEW.sort ? "descending" : "none"} data-sort={k} data-first={firstPayDir(k)}><button type="button" class="sort" aria-label={`Sort by ${HEAD[k].toLowerCase()}`}>{HEAD[k]}<span class="arr" aria-hidden="true">{k === DEFAULT_PAY_VIEW.sort ? "▼" : ""}</span></button></th>
          ))}
          <th>Filing</th>
        </tr></thead>
        <tbody data-pc="rows">
          {first.rows.map((r) => {
            const u = payFilingUrl(r.c.cik, r.accession);
            return (
              <tr data-cik={r.c.cik}>
                <td>{r.c.path ? <a href={r.c.path}>{r.c.name}</a> : r.c.name}{r.c.ticker && <span class="soft small mono"> {r.c.ticker}</span>}</td>
                <td>{r.c.division && <a href={`/industries/${r.c.division.slug}/`}>{r.c.division.name}</a>}</td>
                <td class="mono">{shortDate(r.fye)}</td>
                {PAY_KEYS.map((k) => {
                  const v = r.v[k];
                  return <td class:list={["num", v != null && v < 0 && "pc-neg", k === "peo_total" && "strong"]} data-pay={k}>{v == null ? "—" : payMoney(v)}{payMarked(k, v) && <sup class="pc-mark" title={PAY_MARK_NOTE}> a</sup>}</td>;
                })}
                <td>{u ? <a href={u} rel="noopener nofollow" target="_blank">Filing ↗</a> : "—"}</td>
              </tr>
            );
          })}
        </tbody>
      </table></div>
      <p class="empty-reason" data-pc="empty" hidden>No company matches these filters. <button type="button" class="linklike" data-pc="reset2">Clear the filters</button></p>
      <p class="pay-note" data-pc="marknote">Figures marked <sup class="pc-mark">a</sup> are unusually large or small. They are shown as the company tagged them; check the filing.</p>
      <div class="pc-pager" data-pc="pager">
        <button type="button" class="chip" data-pc="prev" disabled>Previous</button>
        <span data-pc="pageinfo" class="soft">Page 1 of {num(first.pages)}</span>
        <button type="button" class="chip" data-pc="next" disabled={first.pages <= 1}>Next</button>
        <label class="pc-per soft">Rows per page <select data-pc="per" aria-label="Rows per page">{PER_PAGE.map((p) => <option value={p} selected={p === DEFAULT_PER}>{p}</option>)}</select></label>
      </div>
      <noscript><p class="section-note">These are the first {num(first.rows.length)} of {num(all.length)} companies, by the principal executive officer's total. The filters need JavaScript; the CSV file above has every company and fiscal year.</p></noscript>
    </div>
  )}

  <h2 id="about">What this table shows</h2>
  <p>{PAY_CAVEAT}</p>
  <p>Each row is one company and its newest fiscal year on file, so the years in one view do not all end on the same day: the "{HEAD.year}" column says which year each row is. The four figures are, in dollars, the principal executive officer's total in the Summary Compensation Table and compensation actually paid, then the same two as an average over the company's other named executive officers. A dash means the company did not tag that figure. Nothing is added up, converted or compared; the page has no ranking of companies by pay quality, no score and no comparison with any trade.</p>
  <p>Sorting a column orders the companies by that filed figure and nothing else, with missing figures last. Industry is the division of the SEC's industry code for the company. How the figures are read: <a href="/methodology/#executive-pay">methodology</a>. What the table is and how to read it: <a href="/guides/executive-pay-pay-versus-performance/">the guide</a>.</p>
  <AdSlot />

  <p class="disclaimer"><strong>Not investment advice.</strong> Figures shown as filed with the SEC; no judgement about any company or person is made or implied.</p>
  <JsonLd data={ld} />
</BaseLayout>

<style is:global>
  .pay-coverage { color: var(--ink-soft); font-size: var(--t-sm); max-width: 80ch; }
  .pay-note { color: var(--ink-soft); font-size: var(--t-sm); max-width: 80ch; }
  .pc-controls .hm-input { width: 200px; }
  .pc-controls select { max-width: 290px; }
  .pc-count { margin: 0 0 var(--s-1); }
  .pc-dl { margin-top: 0; }
  .pc-dl button.dl { display: inline-flex; align-items: center; height: 32px; padding: 0 var(--s-3); border: 1px solid var(--line-2); border-radius: var(--r-1); color: var(--accent); font: inherit; font-size: var(--t-sm); font-weight: 400; background: var(--surface); cursor: pointer; }
  .pc-dl button.dl:hover { background: var(--chip); }
  .pc-dl button.dl:disabled { opacity: 0.45; cursor: default; }
  html:not(.js) .pc-dl { display: none; }
  .pc-neg { color: var(--red-ink); }
  .pc-mark { color: var(--ink-soft); margin-left: var(--s-1); }
  .pc-pager { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); margin: var(--s-2) 0 var(--s-4); font-size: var(--t-sm); }
  .pc-pager button.chip { font: inherit; font-size: var(--t-xs); color: var(--ink); background: transparent; border: 1px solid var(--line-2); border-radius: var(--r-pill); height: 28px; padding: 0 var(--s-3); cursor: pointer; }
  .pc-pager button.chip:disabled { opacity: 0.45; cursor: default; }
  .pc-pager[hidden] { display: none; }
  .pc-per { margin-left: auto; display: inline-flex; align-items: center; gap: var(--s-1); }
  .linklike { font: inherit; color: var(--signal); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
  .paycompare[data-loading] .pc-table { opacity: 0.6; }
  html:not(.js) .pc-controls, html:not(.js) .pc-pager { display: none; }
</style>
<script>
  import "../scripts/execpay";
</script>
