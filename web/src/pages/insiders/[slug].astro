---
// Insider profile: /insiders/<slug>/ — one page per person with an insider role (Form 4 filer).
// Answer-first (roadmap B.3), then the transactions, then sources, last-updated, disclaimer.
import LearnMore from "../../components/LearnMore.astro";
import { codeRows, yearRows, colleagues } from "../../lib/entity";
import DownloadCsv from "../../components/DownloadCsv.astro";
import { getDownloads } from "../../lib/downloads";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SourcePanel from "../../components/SourcePanel.astro";
import AdSlot from "../../components/AdSlot.astro";
import Crumbs from "../../components/Crumbs.astro";
import Answer from "../../components/Answer.astro";
import ReviewNote from "../../components/ReviewNote.astro";
import TxnTable from "../../components/TxnTable.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getFlagship, personPath, companyPath, securityPath, roleLabel, sum, avg, money, num, plural, isLate } from "../../lib/flagship";
import { personLd, edgarFilingUrl, fitDescription } from "../../lib/seo";
import { formatDate } from "../../lib/format";
import VizPerson from "../../components/VizPerson.astro";

export async function getStaticPaths() {
  const model = await getFlagship();
  return [...model.people.values()]
    .filter((p) => p.isInsider && !p.isCongress && p.slug)
    .map((p) => ({ params: { slug: p.slug! }, props: { id: p.id } }));
}

const { id } = Astro.props as { id: number };
const model = await getFlagship();
const p = model.people.get(id)!;
const path = personPath(p)!;
const role = p.roles.find((r) => r.kind === "insider");
const company = role?.companyId != null ? model.companies.get(role.companyId) : undefined;
const cpath = company ? companyPath(company) : null;
const txns = p.txns;
const buys = txns.filter((t) => t.side === "buy");
const sells = txns.filter((t) => t.side === "sell");
const openMarketBuys = txns.filter((t) => t.code === "P");
const tickers = [...new Set(txns.map((t) => t.securityId).filter((x): x is number => x != null))].map((sid) => model.securities.get(sid)!).filter(Boolean);
const primary = tickers[0];
const latest = txns[0];
const lateCount = txns.filter(isLate).length;
const title = roleLabel(p, model.companies);
const codes = codeRows(txns);
const years = yearRows(txns);
const peers = colleagues(model, p);
const lastTrade = txns.map((t) => t.txnDate).filter(Boolean).sort().at(-1) ?? null;
const uniqueTickers = [...new Map(tickers.map((s) => [s.ticker, s])).values()];
const jump: [string, string][] = txns.length === 0 ? [] : [
  ["#by-type", "By type"], ["#by-year", "By year"], ["#transactions", "Transactions"], ["#filings", "Filings"],
  ...(peers.length ? [["#colleagues", "Other insiders"] as [string, string]] : []),
  ["#sources", "Sources"],
];

const answer = txns.length === 0
  ? `${p.name}, ${title}, has ${plural(p.filings.length, "Form 4 filing")} on record but no transactions that met the publishing bar (approved review, confidence ≥ 0.9). Filings and source links are listed below.`
  : `${p.name}, ${title}, has disclosed ${plural(txns.length, "transaction")} in ${tickers.map((s) => s.ticker).slice(0, 3).join(", ")}${tickers.length > 3 ? ` and ${tickers.length - 3} more` : ""} since ${formatDate(p.firstFiledAt)}: ${plural(buys.length, "purchase")} (${plural(openMarketBuys.length, "open-market buy")}) and ${plural(sells.length, "sale")}, worth about ${money(sum(txns.map((t) => t.value)))} at the reported prices. The latest was filed ${formatDate(p.lastFiledAt)}${latest?.lagDays != null ? `, ${latest.lagDays} day${latest.lagDays === 1 ? "" : "s"} after the trade` : ""}${lateCount ? `; ${plural(lateCount, "filing was late", "filings were late")} against the 2-business-day Form 4 deadline` : ""}.`;

const description = fitDescription([
  `${p.name} (${title}): SEC Form 4 insider transactions on record, with dates, shares, prices and a link to each filing.`,
  `${p.name}: SEC Form 4 insider transactions on record, with dates, shares, prices and a link to each filing.`,
]);
const ld = personLd({ name: p.name, path, jobTitle: role?.officerTitle ?? (role?.isDirector ? "Director" : "Corporate insider"), worksFor: company ? { name: company.name, path: cpath } : null, description,
  sameAs: p.cik ? [`https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${p.cik}&type=4`] : [] });
// CSV: insiders have no file each (file-count limit); offer the file of the ticker they file most for.
const tickerCounts = new Map<number, number>();
for (const t of txns) if (t.securityId != null) tickerCounts.set(t.securityId, (tickerCounts.get(t.securityId) ?? 0) + 1);
const topSecurity = [...tickerCounts].sort((a, b) => b[1] - a[1])[0]?.[0];
const topTicker = topSecurity != null ? model.securities.get(topSecurity)?.ticker : null;
const tickerFile = topTicker ? (await getDownloads()).stock.get(topTicker.toLowerCase()) : undefined;
---
<BaseLayout title={[...(company ? [`${p.name} Insider Trades at ${company.name}`] : []), ...(primary ? [`${p.name} Insider Trades (${primary.ticker})`] : []), `${p.name} Insider Trades`]} description={description} noindex={txns.length === 0} section="Insiders">
  <Crumbs crumbs={[{ name: "Home", path: "/" }, { name: "Insiders", path: "/insiders/" }, { name: p.name, path }]} />
  <p class="eyebrow">Insider <span class="x">/</span> {company ? (cpath ? <a href={cpath}>{company.name}</a> : company.name) : "SEC Form 4 filer"}</p>
  <h1>{p.name}</h1>
  <p class="lede">{title}</p>

  <dl class="facts" data-entity-facts>
    {company && <div><dt>Company</dt><dd>{cpath ? <a href={cpath}>{company.name}</a> : company.name}</dd></div>}
    {uniqueTickers.length > 0 && <div><dt>{uniqueTickers.length === 1 ? "Ticker" : "Tickers"}</dt><dd>{uniqueTickers.slice(0, 4).map((s, i) => <>{i > 0 && ", "}<a class="mono" href={securityPath(s)}>{s.ticker}</a></>)}{uniqueTickers.length > 4 ? ` and ${uniqueTickers.length - 4} more` : ""}</dd></div>}
    {p.firstFiledAt && <div><dt>First filing on record</dt><dd>{formatDate(p.firstFiledAt)}</dd></div>}
    {lastTrade && <div><dt>Latest trade on record</dt><dd>{formatDate(lastTrade)}</dd></div>}
    {p.cik && <div><dt>SEC filings</dt><dd><a href={`https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${p.cik}&type=4`} rel="noopener" target="_blank">EDGAR ↗</a></dd></div>}
  </dl>

  <Answer text={answer} updated={p.lastFiledAt ?? model.builtAt} sourceNote="Source: SEC EDGAR Form 4 filings" />
  <ReviewNote show={p.underReview} what="These Form 4 rows" />

  {jump.length > 0 && (
    <nav class="jump" aria-label="On this page">
      <span>On this page</span>
      {jump.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
  )}

  <section class="datastrip">
    <div class="cell"><div class="k">Transactions</div><div class="v">{num(txns.length)}</div></div>
    <div class="cell"><div class="k">Open-market buys</div><div class="v pos">{num(openMarketBuys.length)}</div></div>
    <div class="cell"><div class="k">Sales</div><div class="v neg">{num(sells.length)}</div></div>
    <div class="cell"><div class="k">Avg. disclosure lag</div><div class="v">{avg(txns.map((t) => t.lagDays)) == null ? "—" : `${avg(txns.map((t) => t.lagDays))!.toFixed(1)}d`}</div></div>
  </section>

  <VizPerson person={p} />

  {txns.length > 0 && (
    <section aria-labelledby="by-type">
      <h2 id="by-type">What kind of transactions</h2>
      <p class="section-note">Most Form 4 rows are pay arriving or tax being withheld, not a decision to buy or sell. Only code P is an open-market purchase and code S an open-market sale. What each code means: <a href="/guides/form-4-transaction-codes/">Form 4 transaction codes</a>.</p>
      <div class="split">
        <div class="tablewrap">
          <table class="data" data-entity-codes>
            <caption class="sr-only">Rows by Form 4 transaction code</caption>
            <thead><tr><th>Code</th><th>Meaning</th><th class="num">Rows</th><th class="num">Shares</th><th class="num">Value</th></tr></thead>
            <tbody>{codes.map((c) => <tr><th scope="row" class="mono">{c.code}</th><td>{c.label}</td><td class="num">{num(c.rows)}</td><td class="num">{num(c.shares)}</td><td class="num">{c.value ? money(c.value) : "—"}</td></tr>)}</tbody>
          </table>
        </div>
        <div class="tablewrap">
          <table class="data" data-entity-years id="by-year">
            <caption class="sr-only">Rows by year of the trade</caption>
            <thead><tr><th>Year</th><th class="num">Rows</th><th class="num">Bought</th><th class="num">Sold</th></tr></thead>
            <tbody>{years.map((y) => <tr><th scope="row" class="mono">{y.year}</th><td class="num">{num(y.rows)}</td><td class="num">{y.buys ? `${num(y.buys)} · ${money(y.bought)}` : "0"}</td><td class="num">{y.sells ? `${num(y.sells)} · ${money(y.sold)}` : "0"}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <h2 id="transactions">Transactions</h2>
  <DownloadCsv file={tickerFile} label={tickerFile ? `Download ${tickerFile.name.replace(".csv", "").toUpperCase()} trades (CSV)` : undefined} note="every filer in this ticker, this insider included" />
  <TxnTable model={model} txns={txns} showSecurity emptyReason="No approved transactions yet — the filings below may be amendments, holdings-only reports, or rows still under review." />

  <AdSlot label="Advertisement" />

  <h2 id="filings">Filings</h2>
  {p.filings.length === 0 ? <p class="empty-reason">No filings on record.</p> : (
    <div class="tablewrap">
      <table class="data">
        <thead><tr><th>Filed</th><th>Form</th><th>Accession</th><th class="num">Rows</th><th>Status</th><th>Source</th></tr></thead>
        <tbody>
          {p.filings.slice(0, 100).map((f) => (
            <tr>
              <td class="mono">{formatDate(f.filedAt)}</td>
              <td>Form 4</td>
              <td class="mono">{f.externalId}</td>
              <td class="num">{f.txnCount}</td>
              <td>{f.isPublished ? "published" : "under review"}</td>
              <td><a href={edgarFilingUrl(f.sourceUrl) ?? "#"} rel="noopener nofollow" target="_blank">EDGAR ↗</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {peers.length > 0 && (
    <section aria-labelledby="colleagues" data-related>
      <h2 id="colleagues">Other insiders at {company?.name ?? "the same company"}</h2>
      <ul class="mates two">
        {peers.map((r) => <li><span><a href={r.path}>{r.person.name}</a> <span class="soft">{r.role}</span></span> <span>{plural(r.rows, "row")}</span></li>)}
      </ul>
      {cpath && <p class="section-note">Everyone on file, with contracts and lobbying under the company's name: <a href={cpath}>{company!.name}</a>.</p>}
    </section>
  )}

  <LearnMore slugs={["what-is-form-4", "form-4-transaction-codes", "insider-buying-vs-insider-selling", ...(txns.some((t) => t.is10b51) ? ["rule-10b5-1-trading-plans"] : []), ...(txns.some((t) => t.isDerivative) ? ["insider-options-and-derivatives"] : []), "what-disclosure-data-cannot-tell-you"].slice(0, 5)} />

  <h2 id="sources">Sources and method</h2>
  <SourcePanel model={model} txns={txns} filings={p.filings} edgarId={p.cik} />
  <p>
    Every row comes from the reporting owner's Form 4 as filed with the SEC (EDGAR ownership XML), read daily.
    "Value" is shares × the reported price; code P is an open-market purchase, S a sale, M an option exercise, A a grant.
    The lag is the filing date minus the trade date; Form 4 is due within two business days. Amendments (4/A) are not merged.
    Details on <a href="/methodology/">the methodology page</a>; report an error on <a href="/corrections/">corrections</a>.
  </p>
  <p class="disclaimer"><strong>Not investment advice.</strong> Figures are public disclosures shown as filed; they may lag the trade and may be amended later. No recommendation is made or implied.</p>
  <JsonLd data={ld} />
</BaseLayout>
