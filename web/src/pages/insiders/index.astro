---
// Insiders hub: newest Form 4 rows + the preset feeds from docs/07 §8 (cluster buys, CEO/CFO
// buys ≥ $25k, officer sales ≥ $100k, top buys/sells this week and month), each an anchor on
// this page so it is one indexable URL set per feed (#cluster-buys etc.).
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import Crumbs from "../../components/Crumbs.astro";
import Answer from "../../components/Answer.astro";
import ReviewNote from "../../components/ReviewNote.astro";
import TxnTable from "../../components/TxnTable.astro";
import JsonLd from "../../components/JsonLd.astro";
import Heatmap from "../../components/Heatmap.astro";
import { getFlagship, withinDays, num, plural, money, sum, personPath, securityPath } from "../../lib/flagship";
import { datasetLd, SOURCES } from "../../lib/seo";
import { formatDate } from "../../lib/format";
import VizInsiders from "../../components/VizInsiders.astro";

const model = await getFlagship();
const all = model.txns.filter((t) => t.source === "sec_form4");
const week = all.filter((t) => withinDays(t.disclosedAt, 7));
const month = all.filter((t) => withinDays(t.disclosedAt, 30));
const isExec = (t: (typeof all)[number]) => {
  const p = t.personId != null ? model.people.get(t.personId) : undefined;
  const title = (p?.roles.find((r) => r.kind === "insider")?.officerTitle ?? "").toLowerCase();
  return /chief executive|chief financial|\bceo\b|\bcfo\b|president/.test(title);
};
const isOfficer = (t: (typeof all)[number]) => !!model.people.get(t.personId ?? -1)?.roles.some((r) => r.kind === "insider" && (r.officerTitle || r.isDirector));
const execBuys = month.filter((t) => t.code === "P" && (t.value ?? 0) >= 25_000 && isExec(t));
const officerSales = month.filter((t) => t.side === "sell" && (t.value ?? 0) >= 100_000 && isOfficer(t));
const topBuysWeek = week.filter((t) => t.code === "P").sort((a, b) => (b.value ?? 0) - (a.value ?? 0)).slice(0, 25);
const topSellsWeek = week.filter((t) => t.side === "sell").sort((a, b) => (b.value ?? 0) - (a.value ?? 0)).slice(0, 25);
const topBuysMonth = month.filter((t) => t.code === "P").sort((a, b) => (b.value ?? 0) - (a.value ?? 0)).slice(0, 25);
const pennyBuys = month.filter((t) => t.code === "P" && t.price != null && t.price > 0 && t.price < 5);

// Cluster buys: ≥3 distinct insiders buying (code P) the same ticker within 30 days.
const clusters = (() => {
  const byTicker = new Map<number, typeof all>();
  for (const t of month.filter((x) => x.code === "P" && x.securityId != null)) byTicker.set(t.securityId!, [...(byTicker.get(t.securityId!) ?? []), t]);
  return [...byTicker.entries()]
    .map(([sid, ts]) => ({ security: model.securities.get(sid)!, buyers: new Set(ts.map((t) => t.personId)).size, total: sum(ts.map((t) => t.value)), txns: ts }))
    .filter((c) => c.buyers >= 3).sort((a, b) => b.buyers - a.buyers || b.total - a.total);
})();

const buyRatio = month.length ? month.filter((t) => t.code === "P").length / Math.max(1, month.filter((t) => t.side === "sell").length) : null;
const underReview = all.some((t) => !t.isPublished);
const lastUpdated = all[0]?.filedAt ?? model.builtAt;
const answer = all.length === 0
  ? "No Form 4 transactions have met the publishing bar yet. The tracked universe covers about 70 large and frequently traded U.S. tickers; rows appear the day after the filing reaches EDGAR."
  : `${plural(week.length, "insider transaction")} were disclosed in the last 7 days and ${plural(month.length, "transaction")} in the last 30, across ${plural(new Set(month.map((t) => t.securityId)).size, "ticker")} in the tracked set. Over 30 days insiders made ${plural(month.filter((t) => t.code === "P").length, "open-market purchase")} against ${plural(month.filter((t) => t.side === "sell").length, "sale")}${buyRatio != null ? ` (buy/sell ratio ${buyRatio.toFixed(2)})` : ""}; ${clusters.length ? `${plural(clusters.length, "ticker")} had a cluster buy of three or more insiders` : "no ticker had a three-insider cluster buy"}.`;
const description = "Newest SEC Form 4 insider trades with preset feeds: cluster buys, CEO and CFO purchases, large officer sales, and the biggest buys and sells this week.";
const ld = [
  datasetLd({ name: "Corporate insider transactions (SEC Form 4)", path: "/insiders/", description, dateModified: lastUpdated.slice(0, 10), keywords: ["insider trading", "Form 4", "cluster buys", "CEO purchases"], sources: [SOURCES.edgar], parentCatalogPath: "/" }),
];
const feeds = [
  { id: "cluster-buys", title: "Cluster buys (30 days)", note: "Three or more distinct insiders bought the same stock on the open market within 30 days." },
  { id: "ceo-cfo-buys", title: "CEO / CFO / president open-market buys ≥ $25k (30 days)", txns: execBuys },
  { id: "officer-sales", title: "Officer and director sales ≥ $100k (30 days)", txns: officerSales },
  { id: "top-buys-week", title: "Largest open-market buys this week", txns: topBuysWeek },
  { id: "top-sells-week", title: "Largest sales this week", txns: topSellsWeek },
  { id: "top-buys-month", title: "Largest open-market buys this month", txns: topBuysMonth },
  { id: "penny-buys", title: "Open-market buys under $5 a share (30 days)", txns: pennyBuys },
];
---
<BaseLayout title="Insider Trades Today — SEC Form 4 Feed & Cluster Buys" description={description} section="Insiders">
  <Crumbs crumbs={[{ name: "Home", path: "/" }, { name: "Insiders", path: "/insiders/" }]} />
  <p class="eyebrow">Follow the Money <span class="x">/</span> Insiders</p>
  <h1>Corporate insider trades</h1>
  <p class="lede">Every Form 4 in the tracked set, the day after it reaches EDGAR, with preset feeds for the patterns people actually look for.</p>

  <Answer text={answer} updated={lastUpdated} sourceNote="Source: SEC EDGAR Form 4" />
  <ReviewNote show={underReview} what="Form 4 rows" />

  <h2 id="heatmap" class="hm-h2">Heatmap <span class="tag live">Live</span></h2>
  <Heatmap kind="insiders" primary={true} />

  <nav class="feeds" aria-label="Preset feeds">
    <a href="#heatmap">Heatmap</a>
    <a href="#charts">Charts</a>
    <a href="#newest">Newest</a>
    {feeds.map((f) => <a href={`#${f.id}`}>{f.title.replace(/ \(.*\)$/, "")}</a>)}
    <a href="/stocks/">By ticker</a>
    <a href="/companies/">By company</a>
  </nav>

  <VizInsiders />

  <h2 id="newest">Newest disclosures</h2>
  <TxnTable model={model} txns={all} showPerson showSecurity limit={100} emptyReason="No approved Form 4 rows yet — the daily sec_form4 job fills this table (see the ingest status in the footer of the methodology page)." />

  <AdSlot label="Advertisement" />

  <h2 id="cluster-buys">Cluster buys (30 days)</h2>
  {clusters.length === 0 ? <p class="empty-reason">No ticker had three or more distinct insiders buying on the open market in the last 30 days.</p> : (
    <div class="tablewrap">
      <table class="data">
        <thead><tr><th>Ticker</th><th class="num">Insiders buying</th><th class="num">Total bought</th><th>Buyers</th></tr></thead>
        <tbody>
          {clusters.map((c) => (
            <tr>
              <td class="mono"><a href={securityPath(c.security)}>{c.security.ticker}</a></td>
              <td class="num">{c.buyers}</td>
              <td class="num strong">{money(c.total)}</td>
              <td>{[...new Set(c.txns.map((t) => t.personId))].filter((x): x is number => x != null).slice(0, 6).map((pid) => { const p = model.people.get(pid)!; const pp = personPath(p); return <span class="chip">{pp ? <a href={pp}>{p.name}</a> : p.name}</span>; })}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {feeds.filter((f) => f.txns).map((f) => (
    <>
      <h2 id={f.id}>{f.title}</h2>
      <TxnTable model={model} txns={f.txns!} showPerson showSecurity limit={50} emptyReason={`Nothing matched this filter in the window (${num(month.length)} transactions checked).`} />
    </>
  ))}

  <h2>How to read this</h2>
  <p>Code P is an open-market purchase — the signal most readers care about, because an insider chose to spend cash. S is a sale (often pre-scheduled under a Rule 10b5-1 plan; flagged when the filing says so). M is an option exercise and A a grant; both are shown but never counted as buys. Values are shares × the reported price. Every row links to the filing on EDGAR. Method details: <a href="/methodology/">methodology</a>.</p>
  <p class="disclaimer"><strong>Not investment advice.</strong> Public disclosures shown as filed; they may lag the trade or be amended. No recommendation is made or implied.</p>
  <JsonLd data={ld} />
</BaseLayout>
