---
// Company page: /companies/<slug>/, for a company with NO ticker page of its own (a fund or trust
// with insiders on file). A company that has a ticker page is shown there (lib/onepage.ts) and
// this address redirects to it (pages/companies/[...rest].astro). Insiders, their transactions,
// and the same company's federal contracts and lobbying (components/WashingtonRecords.astro).
import LearnMore from "../../components/LearnMore.astro";
import Glance from "../../components/Glance.astro";
import GroupBar from "../../components/GroupBar.astro";
import PageGroup from "../../components/PageGroup.astro";
import { shownYears, shownQuarters } from "../../lib/financials";
import { insiderRows, memberRows, relatedCompanies, sizeOf, industryOf, tickerPages } from "../../lib/entity";
import { industryHref } from "../../lib/industries";
import DownloadCsv from "../../components/DownloadCsv.astro";
import { getDownloads } from "../../lib/downloads";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SourcePanel from "../../components/SourcePanel.astro";
import AdSlot from "../../components/AdSlot.astro";
import Crumbs from "../../components/Crumbs.astro";
import { monthlyCounts, monthlyDirection } from "../../lib/glancespark";
import Follow from "../../components/Follow.astro";
import Answer from "../../components/Answer.astro";
import ReviewNote from "../../components/ReviewNote.astro";
import TxnTable from "../../components/TxnTable.astro";
import PlannedSales from "../../components/PlannedSales.astro";
import { noticesInWindow } from "../../lib/form144";
import LargeHolders from "../../components/LargeHolders.astro";
import InstHolders from "../../components/InstHolders.astro";
import Financials from "../../components/Financials.astro";
import CompanyEvents from "../../components/CompanyEvents.astro";
import ExecutivePay from "../../components/ExecutivePay.astro";
import { eventsOf } from "../../lib/events8k-build";
import { eventsInWindow } from "../../lib/events8k";
import { payOf } from "../../lib/execpay-build";
import { payGlance, shownYears as payShownYears } from "../../lib/execpay";
import ReportedHoldings from "../../components/ReportedHoldings.astro";
import { holdingsOf } from "../../lib/schedule13";
import { statementsFiledBy } from "../../lib/schedule13-build";
import { financialsOf } from "../../lib/financials-build";
import { holdersOf } from "../../lib/schedule13";
import JsonLd from "../../components/JsonLd.astro";
import { getFlagship, companyPath, personPath, securityPath, withinDays, num, plural, money, sum, roleLabel } from "../../lib/flagship";
import { organizationLd, fitDescription, SOURCES } from "../../lib/seo";
import { formatDate } from "../../lib/format";
import VizStock from "../../components/VizStock.astro";
import WashingtonRecords from "../../components/WashingtonRecords.astro";

export async function getStaticPaths() {
  const model = await getFlagship();
  return [...model.companies.values()].filter((c) => c.slug && !c.stockPath).map((c) => ({ params: { slug: c.slug! }, props: { id: c.id } }));
}

const { id } = Astro.props as { id: number };
const model = await getFlagship();
const c = model.companies.get(id)!;
const path = companyPath(c)!;
const securities = c.securityIds.map((sid) => model.securities.get(sid)!).filter(Boolean);
const txns = c.txns.filter((t) => t.source === "sec_form4"); // insider rows only; Congress trades live on the ticker page
const congressTxns = c.txns.filter((t) => t.source !== "sec_form4");
const y = txns.filter((t) => withinDays(t.disclosedAt, 365));
const buys = y.filter((t) => t.code === "P").length;
const sells = y.filter((t) => t.side === "sell").length;
const contractsTotal = sum(c.contracts.map((r) => r.amount));
const lobbyingYear = new Date().getUTCFullYear();
const lobbyingYtd = c.lobbying.filter((r) => r.year === lobbyingYear);
const lobbyingTotal = sum(lobbyingYtd.map((r) => r.amount));
const insiderList = insiderRows(model, txns);
const memberList = memberRows(model, congressTxns);
const relatedCos = relatedCompanies(model, c);
const size = sizeOf(model, c.primaryTicker);
const industry = industryOf(model, c);
const industryLink = industry ? industryHref(industry.code) : null;
const primarySec = c.primaryTicker ? tickerPages(model).get(c.primaryTicker.toLowerCase()) : undefined;
// Form 144 notices about the company, last 12 months (empty until that load has reached today).
const plannedN = c.cik ? noticesInWindow(model.form144.byCik.get(c.cik.padStart(10, "0")) ?? [], model.builtAt).length : 0;
// Holders with a Schedule 13D or 13G on record about the company (empty until that load has reached today).
const holdersN = c.cik ? holdersOf(model.schedule13.byCik.get(c.cik.padStart(10, "0")) ?? [], model.builtAt).length : 0;
// Managers with a Form 13F position in the company (empty until that load is recent).
const instC = c.cik && model.inst.shown ? model.inst.byCik.get(c.cik.padStart(10, "0")) ?? null : null;
const instN = instC?.managers ?? 0;
// Figures from the company's annual and quarterly reports (lib/financials.ts); null when none are on file.
const fin = financialsOf(model, c.cik);
const finYears = fin ? shownYears(fin) : [];
const finQuarters = fin ? shownQuarters(fin) : [];
const finShown = finYears.length + finQuarters.length > 0;
const finNewest = finYears[0] ?? finQuarters[0];
// Form 8-K reports filed in the last 12 months (lib/events8k.ts) and Pay Versus Performance figures (lib/execpay.ts).
const evRows = eventsInWindow(eventsOf(model, c.cik), model.builtAt.slice(0, 10));
const payYears = payOf(model, c.cik);
const payTile = payGlance(payYears);
const companyShown = finShown || evRows.length > 0 || payShownYears(payYears).length > 0;
// Schedule 13 statements this company filed about other companies on the site.
const holdingsN = holdingsOf(statementsFiledBy(model, c.cik), model.builtAt).length;
const lastTrade = c.txns.map((t) => t.txnDate).filter(Boolean).sort().at(-1) ?? null;
const assistRows = model.assistance.byCompany.get(c.id) ?? [];
const lcf = model.lobbyContrib.companies.get(c.id);
const lcfItems = lcf ? lcf.years.reduce((a, y) => a + y.items, 0) : 0;
const hasData = c.txns.length > 0 || c.contracts.length > 0 || c.lobbying.length > 0 || companyShown || plannedN > 0 || holdersN > 0 || holdingsN > 0 || instN > 0 || assistRows.length > 0 || lcfItems > 0;
const latestInsider = txns.map((t) => t.disclosedAt).filter(Boolean).sort().at(-1) ?? null;
const glance = [
  ...(txns.length ? [{ label: "Insider transactions", value: num(txns.length), bars: monthlyDirection(txns.map((t) => ({ date: t.disclosedAt, side: t.side })), model.builtAt), note: latestInsider ? `Latest ${formatDate(latestInsider)}` : undefined, href: "#insider-transactions" }] : []),
  ...(plannedN ? [{ label: "Planned sales", value: num(plannedN), note: "Form 144 notices, 12 months", href: "#planned-sales" }] : []),
  ...(holdersN ? [{ label: "Large holders", value: num(holdersN), note: "Schedules 13D and 13G", href: "#large-holders" }] : []),
  ...(instN ? [{ label: "Institutional holders", value: num(instN), note: `as of ${formatDate(model.inst.period!)}`, href: "#institutional-holders" }] : []),
  ...(holdingsN ? [{ label: "Large holdings reported", value: num(holdingsN), note: "Schedules 13D and 13G it filed", href: "#reported-holdings" }] : []),
  ...(finShown ? [{ label: finYears.length ? "Fiscal years of financials" : "Quarters of financials", value: num(finYears.length || finQuarters.length), note: finNewest ? `Newest period ends ${formatDate(finNewest.end)}` : undefined, href: "#financials" }] : []),
  ...(payTile ? [{ label: "Executive pay", value: payTile.value, note: payTile.note, href: "#executive-pay" }] : []),
  ...(evRows.length ? [{ label: "Company events", value: num(evRows.length), bars: monthlyCounts(evRows.map((e) => e.filed), model.builtAt), note: `Form 8-K, newest filed ${formatDate(evRows[0]!.filed)}`, href: "#company-events" }] : []),
  ...(c.contracts.length ? [{ label: "Federal contracts", value: num(c.contracts.length), bars: monthlyCounts(c.contracts.map((x) => x.actionDate), model.builtAt), note: `${money(contractsTotal)} award value`, href: "#contracts" }] : []),
  ...(assistRows.length ? [{ label: "Grants and loans", value: num(assistRows.length), note: `Newest started ${formatDate(assistRows[0]!.startDate)}`, href: "#assistance" }] : []),
  ...(c.lobbying.length ? [{ label: "Lobbying filings", value: num(c.lobbying.length), note: "Senate LDA, as client", href: "#lobbying" }] : []),
  ...(lcfItems ? [{ label: "Lobbyist contributions", value: num(lcf!.years[0]?.items ?? 0), note: `Items in ${lcf!.years[0]?.year}, filed by the company`, href: "#filer-contributions" }] : []),
];
const groupList = hasData ? [
  { id: "trading", label: "Trading" },
  ...(holdersN || holdingsN || instN ? [{ id: "ownership", label: "Ownership" }] : []),
  ...(companyShown ? [{ id: "company", label: "Company" }] : []),
  { id: "washington", label: "Washington" },
  { id: "record", label: "About this record" },
] : [];
const lastUpdated = [txns[0]?.filedAt, c.contracts[0]?.createdAt, c.lobbying[0]?.createdAt].filter(Boolean).sort().reverse()[0] ?? model.builtAt;

const answer = `${c.name}${c.primaryTicker ? ` (${c.primaryTicker})` : ""} has ${plural(c.insiders.length, "insider")} on file who disclosed ${plural(y.length, "transaction")} in the last 12 months (${plural(buys, "open-market buy")}, ${plural(sells, "sale")}, about ${money(sum(y.map((t) => t.value)))} at reported prices)${congressTxns.length ? `, and ${plural(congressTxns.length, "congressional trade")} in its stock ${congressTxns.length === 1 ? "is" : "are"} on record` : ""}. ${c.contracts.length ? `USAspending shows ${plural(c.contracts.length, "federal contract award")} with a combined value of ${money(contractsTotal)} to a recipient with this name that started in the last 180 days` : "No federal contract award that started in the last 180 days was found for a recipient with exactly this name"}${lobbyingYtd.length ? `, and ${plural(lobbyingYtd.length, "lobbying filing")} naming it as client report ${money(lobbyingTotal)} in ${lobbyingYear}.` : "; no lobbying filing names it as client this year."}`;

const description = fitDescription([
  `${c.name}: insider trades from SEC Form 4 filings, federal contracts and lobbying disclosures under the same name, with source links.`,
  `${c.name}: SEC Form 4 insider trades, federal contracts and lobbying filings, with source links.`,
]);
const ld = organizationLd({ name: c.name, path, tickerSymbol: c.primaryTicker, description,
  identifier: c.cik ? { name: "SEC CIK", value: c.cik } : null,
  sameAs: c.cik ? [`https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${c.cik}`] : [] });
---
<BaseLayout title={[`${c.name} Insider Trades, Contracts & Lobbying`, `${c.name} Insider Trades & Contracts`, `${c.name} Insider Trades`]} description={description} section="Companies">
  <Crumbs crumbs={[{ name: "Home", path: "/" }, { name: "Stocks and companies", path: "/stocks/" }, { name: c.name, path }]} />
  <p class="eyebrow">Company{c.cik ? <> <span class="x">/</span> CIK {c.cik}</> : null}</p>
  <div class="title-row"><h1>{c.name}</h1><Follow kind="company" entity={c.slug!} label={c.name} /></div>
  <dl class="facts" data-entity-facts>
    {securities.length > 0 && <div><dt>{securities.length === 1 ? "Ticker" : "Tickers"}</dt><dd>{[...new Map(securities.map((s) => [s.ticker, s])).values()].map((s, i) => <>{i > 0 && ", "}<a class="mono" href={securityPath(s)}>{s.ticker}</a></>)}</dd></div>}
    {industry && <div data-industry><dt>Industry, as the SEC classifies it</dt><dd>{industryLink ? <a href={industryLink}>{industry.label}</a> : industry.label}</dd></div>}
    {size && <div><dt>Size, estimated from filings</dt><dd>{size.label} ({size.range})</dd></div>}
    <div><dt>Insiders on file</dt><dd>{c.insiders.length ? <a href="#insiders">{num(c.insiders.length)}</a> : "0"}</dd></div>
    {memberList.length > 0 && <div><dt>Members of Congress who traded it</dt><dd><a href="#members">{num(memberList.length)}</a></dd></div>}
    <div><dt>Federal contracts on record</dt><dd>{c.contracts.length ? <a href="#contracts">{plural(c.contracts.length, "award")}</a> : "none matched"}</dd></div>
    <div><dt>Lobbying filings on record</dt><dd>{c.lobbying.length ? <a href="#lobbying">{num(c.lobbying.length)}</a> : "none matched"}</dd></div>
    {c.cik && <div><dt>SEC filings</dt><dd><a href={`https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${c.cik}`} rel="noopener" target="_blank">EDGAR ↗</a></dd></div>}
    {lastTrade && <div><dt>Latest trade on record</dt><dd>{formatDate(lastTrade)}</dd></div>}
  </dl>

  <Answer text={answer} updated={lastUpdated} sourceNote="Sources: SEC EDGAR; USAspending; Senate LDA" />
  <ReviewNote show={c.underReview} what="Insider rows" />

  <Glance items={hasData ? glance : []} />

  <GroupBar groups={groupList} />

  <PageGroup id="trading" label="Trading">
  <VizStock company={c} />

  <h2 id="insiders">Insiders</h2>
  {c.insiders.length === 0 ? <p class="empty-reason">No reporting owners on file for this issuer yet.</p> : (
    <div class="tablewrap">
      <table class="data">
        <thead><tr><th>Name</th><th>Role</th><th class="num">Rows</th><th class="num">Bought</th><th class="num">Sold</th><th>Last filed</th></tr></thead>
        <tbody>
          {[...c.insiders].sort((a, b) => (b.lastFiledAt ?? "").localeCompare(a.lastFiledAt ?? "")).map((p) => { const pp = personPath(p); const r = insiderList.find((x) => x.person.id === p.id); return (
            <tr><th scope="row">{pp ? <a href={pp}>{p.name}</a> : p.name}</th><td>{roleLabel(p, model.companies).replace(/ at .*$/, "")}</td><td class="num">{num(r?.rows ?? 0)}</td><td class="num">{num(r?.buys ?? 0)}</td><td class="num">{num(r?.sells ?? 0)}</td><td class="mono">{formatDate(p.lastFiledAt)}</td></tr>
          ); })}
        </tbody>
      </table>
    </div>
  )}
  {c.insiders.length > 0 && <p class="section-note">Rows are this company's Form 4 rows for each person. "Bought" and "sold" count open-market purchases (code P) and sales only. More in <a href="/guides/insider-buying-vs-insider-selling/">insider buying and insider selling</a>.</p>}

  {memberList.length > 0 && (
    <section aria-labelledby="members" data-entity-members>
      <h2 id="members">Members of Congress who traded {c.primaryTicker ?? "this stock"}</h2>
      <p class="section-note">From periodic transaction reports that name the company's stock. Amounts are the sums of the ranges as filed. Every row is on the {primarySec ? <a href={securityPath(primarySec)}>{primarySec.ticker} page</a> : "stock page"}.</p>
      <div class="tablewrap">
        <table class="data">
          <thead><tr><th>Member</th><th>Seat</th><th class="num">Trades</th><th class="num">Bought</th><th class="num">Sold</th><th class="num">Range as filed</th><th>Latest</th></tr></thead>
          <tbody>
            {memberList.slice(0, 15).map((r) => (
              <tr><th scope="row">{r.path ? <a href={r.path}>{r.person.name}</a> : r.person.name}</th><td>{r.seat}</td><td class="num">{num(r.trades)}</td><td class="num">{num(r.buys)}</td><td class="num">{num(r.sells)}</td><td class="num">{money(r.low)}–{money(r.high)}</td><td class="mono">{r.last ? formatDate(r.last) : "—"}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <h2 id="insider-transactions">Insider transactions</h2>
  <DownloadCsv file={c.primaryTicker ? (await getDownloads()).stock.get(c.primaryTicker.toLowerCase()) : undefined} note="insider and congressional rows for this ticker" />
  <TxnTable model={model} txns={txns} showPerson showSecurity emptyReason="No approved Form 4 transactions for this issuer yet." />

  <PlannedSales model={model} cik={c.cik} name={c.name} file={(await getDownloads()).files.find((f) => f.kind === "notices")} />

  </PageGroup>

  <AdSlot label="Advertisement" />

  {(holdersN > 0 || holdingsN > 0 || instN > 0) && (
    <PageGroup id="ownership" label="Ownership">
      <LargeHolders model={model} cik={c.cik} name={c.name} file={(await getDownloads()).files.find((f) => f.kind === "holders")} />

      <InstHolders model={model} cik={c.cik} name={c.name} file={(await getDownloads()).files.find((f) => f.kind === "inst")} />

      <ReportedHoldings model={model} cik={c.cik} name={c.name} file={(await getDownloads()).files.find((f) => f.kind === "holders")} />
    </PageGroup>
  )}

  {companyShown && (
    <PageGroup id="company" label="Company">
      <Financials model={model} cik={c.cik} name={c.name} file={(await getDownloads()).files.find((f) => f.kind === "financials")} />
      <ExecutivePay model={model} cik={c.cik} name={c.name} file={(await getDownloads()).files.find((f) => f.kind === "execpay")} />
      <CompanyEvents model={model} cik={c.cik} name={c.name} file={(await getDownloads()).files.find((f) => f.kind === "events")} />
    </PageGroup>
  )}

  <PageGroup id="washington" label="Washington">
  <WashingtonRecords model={model} company={c} />


  </PageGroup>

  <AdSlot pos="low" />

  <PageGroup id="record" label="About this record">
  {relatedCos.length > 0 && (
    <section aria-labelledby="related" data-related>
      <details class="ref" data-remember id="ref-related"><summary><h2 id="related">Related companies</h2></summary><div class="ref-body">
      <p class="section-note">Companies whose stock was traded by the same people who traded {c.primaryTicker}, by number of filers in common. It shows overlap in public filings and nothing else.</p>
      <ul class="mates two">
        {relatedCos.map((r) => <li><span><a href={r.path}>{r.company.name}</a> <span class="soft mono">{r.ticker}</span></span> <span>{plural(r.shared, "filer")} in common</span></li>)}
      </ul>
    </div></details></section>
  )}

  <LearnMore slugs={["what-is-form-4", "insider-buying-vs-insider-selling", ...(c.contracts.length ? ["federal-contracts-usaspending"] : []), ...(c.lobbying.length ? ["lobbying-disclosure-reports"] : []), "what-disclosure-data-cannot-tell-you"]} />

  <details class="ref" data-remember id="ref-sources"><summary><h2 id="sources">Sources and method</h2></summary><div class="ref-body">
  <SourcePanel model={model} txns={c.txns} edgarId={c.cik ?? c.primaryTicker}
    extra={[{ name: "USAspending, federal contract awards", records: c.contracts.length, unit: c.contracts.length === 1 ? "award" : "awards", href: SOURCES.usaspending.url, linkLabel: "USAspending" }, { name: "Lobbying disclosure filings", records: c.lobbying.length, unit: c.lobbying.length === 1 ? "filing" : "filings", href: SOURCES.lda.url, linkLabel: "LDA.gov search" }]} />
  <p>Insiders and their transactions come from SEC EDGAR Form 4 filings for this issuer. Contracts and lobbying are matched by exact normalized name (suffixes like Inc./Corp. ignored) to USAspending recipients and LDA clients. This is a conservative match that misses subsidiaries on purpose. See <a href="/methodology/">methodology</a> and <a href="/corrections/">corrections</a>.</p>
  </div></details>
  </PageGroup>

  <p class="disclaimer"><strong>Not investment advice.</strong> Public records shown as filed; no recommendation is made or implied.</p>
  <JsonLd data={ld} />
</BaseLayout>
