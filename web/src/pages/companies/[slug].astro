---
// Company page: /companies/<slug>/ — insiders, their transactions, and the same company's
// federal contracts and lobbying (exact normalized-name match on USAspending recipient /
// LDA client; a miss simply shows the reason line).
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import Crumbs from "../../components/Crumbs.astro";
import Answer from "../../components/Answer.astro";
import ReviewNote from "../../components/ReviewNote.astro";
import TxnTable from "../../components/TxnTable.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getFlagship, companyPath, personPath, securityPath, withinDays, num, plural, money, sum, roleLabel } from "../../lib/flagship";
import { organizationLd, fitDescription } from "../../lib/seo";
import { formatDate } from "../../lib/format";
import VizStock from "../../components/VizStock.astro";

export async function getStaticPaths() {
  const model = await getFlagship();
  return [...model.companies.values()].filter((c) => c.slug).map((c) => ({ params: { slug: c.slug! }, props: { id: c.id } }));
}

const { id } = Astro.props as { id: number };
const model = await getFlagship();
const c = model.companies.get(id)!;
const path = companyPath(c)!;
const securities = c.securityIds.map((sid) => model.securities.get(sid)!).filter(Boolean);
const txns = c.txns.filter((t) => t.source === "sec_form4"); // insider rows only; Congress trades live on the ticker page
const congressTxns = c.txns.filter((t) => t.source !== "sec_form4");
const y = txns.filter((t) => withinDays(t.disclosedAt, 365));
const buys = y.filter((t) => t.code === "P").length;
const sells = y.filter((t) => t.side === "sell").length;
const contractsTotal = sum(c.contracts.map((r) => r.amount));
const lobbyingYear = new Date().getUTCFullYear();
const lobbyingYtd = c.lobbying.filter((r) => r.year === lobbyingYear);
const lobbyingTotal = sum(lobbyingYtd.map((r) => r.amount));
const lastUpdated = [txns[0]?.filedAt, c.contracts[0]?.createdAt, c.lobbying[0]?.createdAt].filter(Boolean).sort().reverse()[0] ?? model.builtAt;

const answer = `${c.name}${c.primaryTicker ? ` (${c.primaryTicker})` : ""} has ${plural(c.insiders.length, "insider")} on file who disclosed ${plural(y.length, "transaction")} in the last 12 months (${plural(buys, "open-market buy")}, ${plural(sells, "sale")}, about ${money(sum(y.map((t) => t.value)))} at reported prices)${congressTxns.length ? `, and ${plural(congressTxns.length, "congressional trade")} in its stock ${congressTxns.length === 1 ? "is" : "are"} on record` : ""}. ${c.contracts.length ? `USAspending shows ${plural(c.contracts.length, "federal award action")} worth ${money(contractsTotal)} to a recipient with this name in the last 180 days` : "No federal award to a recipient with exactly this name appears in the last 180 days"}${lobbyingYtd.length ? `, and ${plural(lobbyingYtd.length, "lobbying filing")} naming it as client report ${money(lobbyingTotal)} in ${lobbyingYear}.` : "; no lobbying filing names it as client this year."}`;

const description = fitDescription([
  `${c.name}: insider trades from SEC Form 4 filings, federal contracts and lobbying disclosures under the same name, with source links.`,
  `${c.name}: SEC Form 4 insider trades, federal contracts and lobbying filings, with source links.`,
]);
const ld = organizationLd({ name: c.name, path, tickerSymbol: c.primaryTicker, description,
  identifier: c.cik ? { name: "SEC CIK", value: c.cik } : null,
  sameAs: c.cik ? [`https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${c.cik}`] : [] });
---
<BaseLayout title={[`${c.name} Insider Trades, Contracts & Lobbying`, `${c.name} Insider Trades & Contracts`, `${c.name} Insider Trades`]} description={description} section="Companies">
  <Crumbs crumbs={[{ name: "Home", path: "/" }, { name: "Companies", path: "/companies/" }, { name: c.name, path }]} />
  <p class="eyebrow">Company{c.cik ? <> <span class="x">/</span> CIK {c.cik}</> : null}</p>
  <h1>{c.name}</h1>
  <p class="lede">{securities.map((s) => <a class="mono" href={securityPath(s)}>{s.ticker}</a>)}{securities.length ? " · " : ""}{plural(c.insiders.length, "insider")} on file</p>

  <Answer text={answer} updated={lastUpdated} sourceNote="Sources: SEC EDGAR; USAspending; Senate LDA" />
  <ReviewNote show={c.underReview} what="Insider rows" />

  <VizStock company={c} />

  <h2>Insiders</h2>
  {c.insiders.length === 0 ? <p class="empty-reason">No reporting owners on file for this issuer yet.</p> : (
    <div class="tablewrap">
      <table class="data">
        <thead><tr><th>Name</th><th>Role</th><th class="num">Transactions</th><th>Last filed</th></tr></thead>
        <tbody>
          {c.insiders.sort((a, b) => (b.lastFiledAt ?? "").localeCompare(a.lastFiledAt ?? "")).map((p) => { const pp = personPath(p); return (
            <tr><td>{pp ? <a href={pp}>{p.name}</a> : p.name}</td><td>{roleLabel(p, model.companies).replace(/ at .*$/, "")}</td><td class="num">{num(p.txns.length)}</td><td class="mono">{formatDate(p.lastFiledAt)}</td></tr>
          ); })}
        </tbody>
      </table>
    </div>
  )}

  <h2>Insider transactions</h2>
  <TxnTable model={model} txns={txns} showPerson showSecurity emptyReason="No approved Form 4 transactions for this issuer yet." />

  <AdSlot label="Advertisement" />

  <h2>Federal contracts (USAspending, last 180 days)</h2>
  {c.contracts.length === 0 ? <p class="empty-reason">No award action to a recipient named exactly "{c.name}" in the last 180 days. Subsidiaries and differently-spelled recipients are not matched — search <a href="/contracts/">contracts</a>.</p> : (
    <div class="tablewrap">
      <table class="data">
        <thead><tr><th>Action date</th><th>Awarding agency</th><th class="num">Amount</th><th>NAICS</th><th>Source</th></tr></thead>
        <tbody>
          {c.contracts.slice(0, 50).map((r) => (
            <tr><td class="mono">{formatDate(r.actionDate)}</td><td>{r.agency ?? "—"}</td><td class="num">{money(r.amount, { compact: false })}</td><td class="mono">{r.naics ?? "—"}</td><td>{r.sourceRef ? <a href={`https://www.usaspending.gov/award/${r.sourceRef}`} rel="noopener nofollow" target="_blank">USAspending ↗</a> : "—"}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <h2>Lobbying (Senate LDA, as client)</h2>
  {c.lobbying.length === 0 ? <p class="empty-reason">No LDA filing names "{c.name}" as the client in the last two years. Filings under a subsidiary or trade-association name are not matched — search <a href="/lobbying/">lobbying</a>.</p> : (
    <div class="tablewrap">
      <table class="data">
        <thead><tr><th>Period</th><th>Registrant</th><th>Primary issue</th><th class="num">Amount</th><th>Source</th></tr></thead>
        <tbody>
          {c.lobbying.slice(0, 50).map((r) => (
            <tr><td class="mono">{r.year ?? "—"}{r.quarter ? ` Q${r.quarter}` : ""}</td><td>{r.registrant ?? "—"}</td><td>{r.issueArea ?? "—"}</td><td class="num">{money(r.amount, { compact: false })}</td><td>{r.sourceRef ? <a href={r.sourceRef} rel="noopener nofollow" target="_blank">LDA ↗</a> : "—"}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <h2>Sources and method</h2>
  <p>Insiders and their transactions come from SEC EDGAR Form 4 filings for this issuer. Contracts and lobbying are matched by exact normalized name (suffixes like Inc./Corp. ignored) to USAspending recipients and LDA clients — a conservative match that misses subsidiaries on purpose. See <a href="/methodology/">methodology</a> and <a href="/corrections/">corrections</a>.</p>
  <p class="disclaimer"><strong>Not investment advice.</strong> Public records shown as filed; no recommendation is made or implied.</p>
  <JsonLd data={ld} />
</BaseLayout>
