---
// company pages outside the tracked set, rendered by the Worker on request (stage 3a). A prerendered
// sibling route and the static files win for tracked entities; this route only runs when no
// static file exists. Keep this file free of imports of postgres, fs, flagship or db.
export const prerender = false;
import OdPageView from "../../components/OdPageView.astro";
import { fetchOd, guideLinks, oneSegment, notFound, companyMovedTo, companyTicker, parityAllowed } from "../../lib/server/odsource";

// The list of companies is the list of stocks (pages/stocks/index.astro): one list, as one page per company.
if (!Astro.params.rest) return new Response(null, { status: 301, headers: { location: "/stocks/", "cache-control": "public, max-age=3600, s-maxage=86400" } });
const key = oneSegment(Astro.params.rest);
// A tracked company that is now shown on its ticker page: one page per company (lib/onepage.ts).
const movedTo = key ? await companyMovedTo(key, Astro.url) : null;
if (movedTo) return new Response(null, { status: 301, headers: { location: movedTo, "cache-control": "public, max-age=3600, s-maxage=86400" } });
const doc = key ? await fetchOd("company", key!, Astro.url).catch(() => undefined) : null;
if (doc === undefined) return new Response("Temporarily unavailable", { status: 503, headers: { "cache-control": "no-store", "retry-after": "60" } });
if (!doc) return notFound(Astro.url);
// One page per company (lib/onepage.ts, migration 0041): a company with a ticker is shown on its home
// ticker's page, which lists the rows of every security of the company.
const only = companyTicker(doc);
if (only && !parityAllowed(Astro.url)) return new Response(null, { status: 301, headers: { location: `/stocks/${only}/`, "cache-control": "public, max-age=3600, s-maxage=86400" } });
const guides = await guideLinks(Astro.url);
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800");
---
<OdPageView doc={doc} guides={guides} />
