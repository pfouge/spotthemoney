# Supabase Postgres connection string — the SESSION pooler (port 5432), with sslmode=require.
# Supabase → Project Settings → Database → Connection string → Session pooler.
# Never the Transaction pooler (6543) here: migrations and ingest need multi-statement SQL.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Cloudflare Web Analytics token (optional; enables privacy-friendly pageview tracking).
# PUBLIC_ vars are exposed to the browser by Astro — only put non-secret values here.
PUBLIC_CF_ANALYTICS_TOKEN=

# Display-ad client id (e.g. AdSense ca-pub-XXXXXXXX). Optional until you're approved.
PUBLIC_AD_CLIENT=

# Public site origin (used for canonical URLs / sitemaps).
PUBLIC_SITE_URL=https://spotthemoney.com

# ── Ingest job keys (all optional; jobs without their key are safe no-ops or run keyless) ──

# OpenFEC key (free, api.data.gov). Without it fec_schedule_a uses the throttled DEMO_KEY.
FEC_API_KEY=

# Twelve Data key (paid). Without it twelvedata_eod skips (staging-safe no-op).
TWELVEDATA_API_KEY=

# Senate LDA token (optional). Keyless works at ~15 req/min; a token raises the limit.
LDA_API_KEY=

# Contact User-Agent overrides (defaults identify spotthemoney.com with Peter's email).
# SEC requires a contact UA on every request; the default satisfies that.
#INGEST_USER_AGENT=
#SEC_EDGAR_USER_AGENT=

# Per-job scoping knobs (defaults are conservative/staging-safe):
#TREASURY_YC_YEARS=2025,2026        # backfill years for the yield curve (default: current year)
#SEC_EDGAR_TICKERS=                 # extra tickers beyond the securities table
#TWELVEDATA_TICKERS=                # extra tickers beyond the securities table
#FEC_COMMITTEE_IDS=                 # committee scope (job is a no-op until this or committees rows exist)
#FEC_LOOKBACK_DAYS=30
#USASPENDING_LOOKBACK_DAYS=30

# ── Added 2026-09-27 ──────────────────────────────────────────────────────────────────────

# BLS Public Data API (optional; keyless = 25 queries/day, enough for the daily CPI pull).
BLS_API_KEY=

# Raw-filing archive (Supabase Storage, private bucket raw-filings). Both required to upload;
# without them raw_documents rows are still recorded and `npm run ingest -- archive_backfill`
# uploads later. Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Daily X thread (job dry-runs to ingest/out/ without all four).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Monthly citation count — each engine is skipped when its key is absent (costs money per run).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
#CITATION_MAX_QUESTIONS=20        # smoke-run cap
#CITATION_ENGINES=openai,gemini   # restrict engines

# Weekly Search Console export (service-account JSON as one line; dry-runs without it).
GSC_SERVICE_ACCOUNT_JSON=
#GSC_SITE_URL=sc-domain:spotthemoney.com
#GSC_WEEK_START=2026-09-14        # backfill a specific ISO week (Monday)

# Job knobs added 2026-09-27
#FEC_CYCLE=2026                   # committee-universe cycle (default: current even year)
#FEC_TOP_PACS=200
#X_SINCE=2026-09-20               # X job backfill window start
#X_LOOKBACK_HOURS=24
#ARCHIVE_BACKFILL_LIMIT=200
#INDEXNOW_DAYS=2
